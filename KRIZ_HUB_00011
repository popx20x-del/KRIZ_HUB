					o.L.From,o.L.To,o.R.From,o.R.To=Vector2.new(pos.X-w/2,pos.Y-h/2),Vector2.new(pos.X-w/2,pos.Y+h/2),Vector2.new(pos.X+w/2,pos.Y-h/2),Vector2.new(pos.X+w/2,pos.Y+h/2)
					for _,l in pairs({o.T,o.B,o.L,o.R}) do l.Thickness,l.Transparency,l.Color,l.Visible=t,tr,clr,true end
