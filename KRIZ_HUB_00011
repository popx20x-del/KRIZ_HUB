Core:RegisterModule({Name="ESP / มองทะลุ",Category="Visual",OnEnable=function()
	getgenv().KEsp=true local d={}
	local function M(p)
		if p==LP then return end
		local o={T=Drawing.new("Line"),B=Drawing.new("Line"),L=Drawing.new("Line"),R=Drawing.new("Line"),H=Drawing.new("Line"),N=Drawing.new("Text"),D=Drawing.new("Text")}
