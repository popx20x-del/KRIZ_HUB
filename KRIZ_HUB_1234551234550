        if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect() end
        local lastState = false
        local function setCollisions(state)
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then obj.CanCollide = state end
                end
            end)
        end
        getgenv().KRIZ_NOCLIP_CONN = RS.Stepped:Connect(function()
            if getgenv().KrizNoclipActive and LP.Character then
                if not lastState then lastState = true; setCollisions(false) end
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
                local root = LP.Character:FindFirstChild("HumanoidRootPart")
