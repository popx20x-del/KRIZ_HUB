Core:RegisterModule({
    Name = "ESP Item / สิ่งของที่เก็บได้",
    Category = "Settings",
    OnEnable = function()
        getgenv().KrizItemActive=true
        local activeItems={}

        local function IsCollectible(obj)
            if not obj or not obj:IsA("PVInstance") or obj:IsDescendantOf(LP.Character) then return false end
            if obj:FindFirstChildOfClass("ProximityPrompt") or obj:IsA("ProximityPrompt") then return true end
            if obj:FindFirstChildOfClass("ClickDetector") or obj:IsA("ClickDetector") then return true end
            if obj:IsA("Tool") or (obj:IsA("BasePart") and obj.CanTouch and not obj.Anchored and obj.Size.Magnitude < 10) then return true end
            return false
        end

        local function ClearItem(data)
            if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
            if data.Text then pcall(function() data.Text:Remove() end) end
        end

        local function ScanWorkspace()
            if not getgenv().KrizItemActive then return end
            local myChar=LP.Character local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            for _, obj in ipairs(workspace:GetDescendants()) do
                if not getgenv().KrizItemActive then break end
                if IsCollectible(obj) and not activeItems[obj] then
                    local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
                    if targetPart then
                        -- เปลี่ยนสี Highlight เป็นสีม่วง (Purple)
                        local hl = Instance.new("Highlight")
                        hl.Name = "KrizItemHighlight"
                        hl.FillColor = Color3.fromRGB(170, 50, 255)
                        hl.OutlineColor = Color3.fromRGB(230, 200, 255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Adornee = obj
                        pcall(function() hl.Parent = game:GetService("CoreGui") end)

                        -- เปลี่ยนสี Text เป็นสีม่วงสว่าง
                        local txt = Drawing.new("Text")
                        txt.Visible, txt.Size, txt.Center, txt.Outline, txt.OutlineColor, txt.Color = false, 13, true, true, Color3.new(0,0,0), Color3.fromRGB(200, 100, 255)

                        activeItems[obj] = { Target = targetPart, Highlight = hl, Text = txt, Name = obj.Name }
                    end
                end
            end
        end

        local renderConn
        renderConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizItemActive then
                if renderConn then renderConn:Disconnect() end
                return
            end

            local myChar=LP.Character local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")

            for obj, data in pairs(activeItems) do
                if obj and obj.Parent and data.Target and data.Target.Parent then
                    if myRoot then
                        local dist = (data.Target.Position - myRoot.Position).Magnitude
                        if dist <= 300 then
                            local pos, vis = Cam:WorldToViewportPoint(data.Target.Position)
                            if vis then
                                local meters = math.floor(dist * 0.28)
                                data.Text.Position = Vector2.new(pos.X, pos.Y)
                                data.Text.Text = "[" .. data.Name .. "] " .. tostring(meters) .. "m"
                                data.Text.Visible = true
                            else data.Text.Visible = false end
                        else data.Text.Visible = false end
                    end
                else
                    ClearItem(data)
                    activeItems[obj] = nil
                end
            end
        end)

        task.spawn(function()
            while getgenv().KrizItemActive do
                ScanWorkspace()
                task.wait(2)
            end
        end)

        getgenv().KrizItemCleanup = function()
            if renderConn then pcall(function() renderConn:Disconnect() end) end
            for obj, data in pairs(activeItems) do ClearItem(data) end
            activeItems = {}
        end
    end,
    OnDisable = function()
        getgenv().KrizItemActive = false
        if getgenv().KrizItemCleanup then pcall(getgenv().KrizItemCleanup) end
    end
})
