                        if lbl and (string.find(lbl.Text, "Auto Executioner") or string.find(lbl.Text, "วาร์ปล่าฆ่าอัตโนมัติ")) then
                            rowFrame = child
                            break
                        end
                    end
                end
            end
        end)

        -- สร้างปุ่มสลับโหมดแคปซูล (วางตำแหน่งปุ่มที่ 1 ถัดจากสวิตช์หลักพอดีเป๊ะ)
        local modeButton
        if rowFrame then
            -- ปรับหลบข้อความชื่อฟังก์ชันไม่ให้โดนทับ
            local nameLbl = rowFrame:FindFirstChild("Name")
            if nameLbl then
                nameLbl.Size = UDim2.new(1, -95, 1, 0)
                nameLbl.ClipsDescendants = true
            end

            modeButton = Instance.new("TextButton", rowFrame)
            modeButton.Name = "ExecutionerModeBtn"
            -- ปุ่มกว้าง 36px, เว้นระยะห่างจากสวิตช์หลัก 4px -> UDim2.new(1, -88, 0.5, -10)
            modeButton.Size = UDim2.new(0, 36, 0, 20)
            modeButton.Position = UDim2.new(1, -88, 0.5, -10)
            modeButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            modeButton.BackgroundTransparency = 0.15
            modeButton.BorderSizePixel = 0
            modeButton.Font = Enum.Font.GothamBold
            modeButton.Text = "ALL"
            modeButton.TextColor3 = Color3.fromRGB(0, 255, 255)
            modeButton.TextSize = 8
            modeButton.ZIndex = 10003

            local corner = Instance.new("UICorner", modeButton)
            corner.CornerRadius = UDim.new(1, 0)

            modeButton.MouseButton1Click:Connect(function()
                currentModeIndex = currentModeIndex + 1
                if currentModeIndex > #targetModes then currentModeIndex = 1 end
                
                local selectedMode = targetModes[currentModeIndex]
                modeButton.Text = selectedMode == "All" and "ALL" or "ENEMY"
                modeButton.TextColor3 = selectedMode == "All" and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 100, 100)
                
                currentTarget = nil
                notify("EXECUTIONER: " .. targetModeNames[currentModeIndex])
            end)
        end

        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            if not getgenv().KrizExecutionerActive then
                if conn then conn:Disconnect() end
                return
            end

            local char = LocalPlayer.Character
            if not char then return end
            
            -- ระบบป้องกันการนั่งอัตโนมัติ
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Sit then
                hum.Sit = false
                pcall(function()
                    if char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    end
                end)
            end

            if not char:FindFirstChild("HumanoidRootPart") then return end
            local myRoot = char.HumanoidRootPart

            local function isValidTarget(p)
                if not p or p == LocalPlayer or blacklistedTargets[p] then return false end
                
                local currentMode = targetModes[currentModeIndex]
                if currentMode == "Enemy" and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then
                    return false
                end

                local pChar = p.Character
                if not pChar then return false end
                local pHum = pChar:FindFirstChildOfClass("Humanoid")
                local hrp = pChar:FindFirstChild("HumanoidRootPart")
                if not pHum or not hrp or pHum.Health <= 0 then return false end
                return true
            end

            if not isValidTarget(currentTarget) then
                currentTarget = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if isValidTarget(p) then
                        currentTarget = p
                        local pHum = p.Character:FindFirstChildOfClass("Humanoid")
                        lastHealth = pHum.Health
                        timer = 0
                        break
                    end
                end
            end

            if currentTarget and currentTarget.Character then
                local eRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
                local eHum = currentTarget.Character:FindFirstChildOfClass("Humanoid")

                if eRoot and eHum then
                    myRoot.CFrame = eRoot.CFrame * CFrame.new(0, 0, 4)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, eRoot.Position)

                    local now = tick()
                    if now - lastClickTime >= 0.1 then
                        lastClickTime = now
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end

                    if eHum.Health < lastHealth then
                        lastHealth = eHum.Health
                        timer = 0
                    else
                        timer = timer + dt
                        if timer >= 3 then
                            blacklistedTargets[currentTarget] = true
                            task.delay(5, function()
                                blacklistedTargets[currentTarget] = nil
                            end)
                            currentTarget = nil
                            timer = 0
                        end
                    end
                end
            end
        end)

        getgenv().KrizExecutionerCleanup = function()
            if conn then pcall(function() conn:Disconnect() end) end
            if modeButton then pcall(function() modeButton:Destroy() end) end
            -- คืนค่าความกว้างชื่อฟังก์ชันตามเดิมเมื่อปิด
            if rowFrame then
                local nameLbl = rowFrame:FindFirstChild("Name")
                if nameLbl then nameLbl.Size = UDim2.new(1, -60, 1, 0) end
            end
        end
    end,
    OnDisable = function()
        getgenv().KrizExecutionerActive = false
        if getgenv().KrizExecutionerCleanup then pcall(getgenv().KrizExecutionerCleanup) end
    end
})
