-- MODULE: NPC HIGHLIGHT ESP + NAME (สำหรับ KRIZ HUB)
--------------------------------------------------
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

Core:RegisterModule({
    Name = "ESP NPC Highlight / ไฮไลท์ NPC",
    Category = "Settings",
    OnEnable = function()
        getgenv().KrizNPCHighlightActive = true
        local highlights = {}
        local nameTags = {}
        local trackedConnections = {}

        local function removeNPC(model)
            if highlights[model] then
                pcall(function() highlights[model]:Destroy() end)
                highlights[model] = nil
            end
            if nameTags[model] then
                pcall(function() nameTags[model]:Destroy() end)
                nameTags[model] = nil
            end
            if trackedConnections[model] then
                for _, conn in pairs(trackedConnections[model]) do
                    pcall(function() conn:Disconnect() end)
                end
                trackedConnections[model] = nil
            end
        end

        local function setupNPC(model)
            if not model:IsA("Model") then return end
            -- กรองผู้เล่นจริงออก ให้ทำงานกับ NPC เท่านั้น
            if Players:GetPlayerFromCharacter(model) then return end
            
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local head = model:FindFirstChild("Head")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            
            if not humanoid or not head or not hrp then return end
            if highlights[model] then return end -- ป้องกันการสร้างซ้ำ

            -- 1. สร้าง Highlight สีเขียว
            local hl = Instance.new("Highlight")
            hl.Name = "KrizNPCHighlight"
            hl.Adornee = model
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.OutlineColor = Color3.fromRGB(0, 255, 0)
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.Parent = model
            highlights[model] = hl

            -- 2. สร้าง BillboardGui แสดงชื่อ NPC ลอยบนหัว
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "KrizNPCNameTag"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 150, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true

            local textLabel = Instance.new("TextLabel", billboard)
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = "NPC : " .. (model.Name ~= "" and model.Name or "Unknown")
            textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            textLabel.TextSize = 13
            textLabel.Font = Enum.Font.GothamBold
            textLabel.TextStrokeTransparency = 0.2
            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

            billboard.Parent = model
            nameTags[model] = billboard

            -- จัดการเมื่อ NPC ถูกลบหรือออกจากแมพ
            local destroyConn = model.Destroying:Connect(function()
                removeNPC(model)
            end)

            trackedConnections[model] = {Destroying = destroyConn}
        end

        -- สแกนหา NPC ที่มีอยู่แล้วใน Workspace
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                setupNPC(obj)
            end
        end

        -- ตรวจจับ NPC ที่เกิดเพิ่มภายหลัง
        local addConn = Workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("Model") and getgenv().KrizNPCHighlightActive then
                task.spawn(function()
                    task.wait(0.2)
                    setupNPC(obj)
                end)
            end
        end)

        -- ฟังก์ชันเคลียร์ข้อมูลและลบ Highlight + NameTag ทั้งหมดเมื่อปิดโมดูล
        getgenv().KrizNPCHighlightCleanup = function()
            if addConn then pcall(function() addConn:Disconnect() end) end
            for model, _ in pairs(highlights) do
                removeNPC(model)
            end
            highlights = {}
            nameTags = {}
            trackedConnections = {}
        end
    end,
    OnDisable = function()
        getgenv().KrizNPCHighlightActive = false
        if getgenv().KrizNPCHighlightCleanup then 
            pcall(getgenv().KrizNPCHighlightCleanup) 
        end
    end
})
