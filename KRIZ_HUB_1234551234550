                    local hit = workspace:FindPartOnRayWithIgnoreList(Ray.new(root.Position, Vector3.new(0, -6, 0)), {LP.Character})
                    if hit then hit.CanCollide = true end
                end
            else
                if lastState then lastState = false; setCollisions(true) end
            end
        end)
        notify("NOCLIP: ON")
        getgenv().KrizNoclipCleanup = function()
            if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect(); getgenv().KRIZ_NOCLIP_CONN = nil end
            setCollisions(true)
            notify("NOCLIP: OFF")
