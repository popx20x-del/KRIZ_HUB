                LArm1 = Drawing.new("Line"), LArm2 = Drawing.new("Line"),
                RArm1 = Drawing.new("Line"), RArm2 = Drawing.new("Line"),
                LLeg1 = Drawing.new("Line"), LLeg2 = Drawing.new("Line"),
                RLeg1 = Drawing.new("Line"), RLeg2 = Drawing.new("Line")
            }
            for _, l in pairs(lines) do
                table.insert(dList, l)
                l.Visible, l.Thickness, l.Transparency, l.Outline, l.OutlineColor = false, 1.2, 0.8, true, Color3.new(0, 0, 0)
            end

            local conn
            conn = RS.RenderStepped:Connect(function()
                if not getgenv().KrizSkeletonActive then
                    for _, l in pairs(lines) do l.Visible = false end
                    if conn then conn:Disconnect() end
                    return
                end

                local c, hum, hrp = p.Character, p.Character and p.Character:FindFirstChildOfClass("Humanoid"), p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if c and hum and hum.Health > 0 and hrp then
                    local head = c:FindFirstChild("Head")
                    if head then
                        local pHead, visH = Cam:WorldToViewportPoint(head.Position)
                        local clr = GetCol(p)
                        if visH then
                            if hum.RigType == Enum.HumanoidRigType.R6 then
                                local torso = c:FindFirstChild("Torso")
                                if torso then
                                    local pTorso, visT = Cam:WorldToViewportPoint(torso.Position)
                                    local tPos = Vector2.new(pTorso.X, pTorso.Y)
                                    lines.Chest.Visible, lines.LArm2.Visible, lines.RArm2.Visible, lines.LLeg2.Visible, lines.RLeg2.Visible = false, false, false, false, false
                                    if visT then
                                        lines.Spine.From, lines.Spine.To, lines.Spine.Color, lines.Spine.Visible = Vector2.new(pHead.X, pHead.Y), tPos, clr, true
                                        local function setR6(line, partName)
                                            local part = c:FindFirstChild(partName)
                                            if part then
                                                local pos, vis = Cam:WorldToViewportPoint(part.Position)
                                                if vis then line.From, line.To, line.Color, line.Visible = tPos, Vector2.new(pos.X, pos.Y), clr, true else line.Visible = false end
                                            else line.Visible = false end
                                        end
                                        setR6(lines.LArm1, "Left Arm") setR6(lines.RArm1, "Right Arm")
                                        setR6(lines.LLeg1, "Left Leg") setR6(lines.RLeg1, "Right Leg")
                                    else
                                        for _, l in pairs(lines) do l.Visible = false end
                                    end
                                end
                            elseif hum.RigType == Enum.HumanoidRigType.R15 then
                                local uTorso, lTorso = c:FindFirstChild("UpperTorso"), c:FindFirstChild("LowerTorso")
                                local lUA, lLA = c:FindFirstChild("LeftUpperArm"), c:FindFirstChild("LeftLowerArm")
                                local rUA, rLA = c:FindFirstChild("RightUpperArm"), c:FindFirstChild("RightLowerArm")
                                local lUL, lLL = c:FindFirstChild("LeftUpperLeg"), c:FindFirstChild("LeftLowerLeg")
                                local rUL, rLL = c:FindFirstChild("RightUpperLeg"), c:FindFirstChild("RightLowerLeg") or c:FindFirstChild("RightFoot")

                                if uTorso and lTorso then
                                    local pUpper, vU = Cam:WorldToViewportPoint(uTorso.Position)
                                    local pLower, vL = Cam:WorldToViewportPoint(lTorso.Position)
                                    local uPos, lPos = Vector2.new(pUpper.X, pUpper.Y), Vector2.new(pLower.X, pLower.Y)
                                    if vU or vL then
                                        lines.Spine.From, lines.Spine.To, lines.Spine.Color, lines.Spine.Visible = Vector2.new(pHead.X, pHead.Y), uPos, clr, true
                                        lines.Chest.From, lines.Chest.To, lines.Chest.Color, lines.Chest.Visible = uPos, lPos, clr, true

                                        local function setR15(l1, l2, pA, pB, fromPos)
                                            if pA and pB then
                                                local pos1, vis1 = Cam:WorldToViewportPoint(pA.Position)
                                                local pos2, vis2 = Cam:WorldToViewportPoint(pB.Position)
                                                if vis1 then l1.From, l1.To, l1.Color, l1.Visible = fromPos, Vector2.new(pos1.X, pos1.Y), clr, true else l1.Visible = false end
                                                if vis1 and vis2 then l2.From, l2.To, l2.Color, l2.Visible = Vector2.new(pos1.X, pos1.Y), Vector2.new(pos2.X, pos2.Y), clr, true else l2.Visible = false end
                                            else l1.Visible, l2.Visible = false, false end
                                        end
                                        setR15(lines.LArm1, lines.LArm2, lUA, lLA, uPos)
                                        setR15(lines.RArm1, lines.RArm2, rUA, rLA, uPos)
                                        setR15(lines.LLeg1, lines.LLeg2, lUL, lLL, lPos)
                                        setR15(lines.RLeg1, lines.RLeg2, rUL, rLL, lPos)
                                    else
                                        for _, l in pairs(lines) do l.Visible = false end
                                    end
                                end
                            end
                        else
                            for _, l in pairs(lines) do l.Visible = false end
                        end
                    else
                        for _, l in pairs(lines) do l.Visible = false end
                    end
                else
                    for _, l in pairs(lines) do l.Visible = false end
                    if not p.Parent then conn:Disconnect() end
                end
            end)
        end

        for _, p in pairs(P:GetPlayers()) do CreateSkeleton(p) end
        local addConn = P.PlayerAdded:Connect(CreateSkeleton)

        getgenv().KrizSkeletonCleanup = function()
            if addConn then addConn:Disconnect() end
            for _, obj in ipairs(dList) do pcall(function() obj:Remove() end) end
        end
    end,
    OnDisable = function()
        getgenv().KrizSkeletonActive = false
        if getgenv().KrizSkeletonCleanup then pcall(getgenv().KrizSkeletonCleanup) end
    end
})

