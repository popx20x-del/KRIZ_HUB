-- MODULE: PROXIMITY DISTANCE ESP / เส้นบอกระยะประชิด (หมวด Settings)
--------------------------------------------------
local P, RS, Cam, LP = game:GetService("Players"), game:GetService("RunService"), workspace.CurrentCamera, game:GetService("Players").LocalPlayer

local function GetTargetColor(p)
    local c, b = p.Character, p:FindFirstChild("Backpack")
    -- เช็กอาวุธร้ายแรงก่อน
    if c and (c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife"))) then return Color3.fromRGB(255, 50, 50) end
    if c and (c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun"))) then return Color3.fromRGB(50, 150, 255) end
    
    -- เช็กสีตามทีม (ถ้าต่างทีมใช้สีแดง/สีทีม, ถ้าทีมเดียวกันใช้สีเขียว)
    if p.Team and LP.Team then
        return (p.Team ~= LP.Team) and (p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255, 60, 60)) or Color3.fromRGB(50, 255, 100)
    end
    return Color3.fromRGB(255, 80, 80) -- สีเริ่มต้นสำหรับศัตรูในเกมไม่มีทีม
end

Core:RegisterModule({
    Name = "Proximity Line / เส้นบอกระยะประชิด",
    Category = "Settings",
    OnEnable = function()
        getgenv().KrizProximityActive = true
        local drawObjects = {}
        local maxDistanceStuds = 50 -- ระยะตรวจจับ (ประมาณรถยนต์จอดต่อกัน 2-3 คัน)

        local function CreateProximityESP(p)
            if p == LP then return end

            local line = Drawing.new("Line")
            line.Visible, line.Thickness, line.Transparency, line.Outline, line.OutlineColor = false, 1.5, 0.9, true, Color3.new(0, 0, 0)

            local text = Drawing.new("Text")
            text.Visible, text.Size, text.Center, text.Outline, text.OutlineColor = false, 13, true, true, Color3.new(0, 0, 0)

            table.insert(drawObjects, line)
            table.insert(drawObjects, text)

            local conn
            conn = RS.RenderStepped:Connect(function()
                if not getgenv().KrizProximityActive then
                    line.Visible, text.Visible = false, false
                    if conn then conn:Disconnect() end
                    return
                end

                local myChar = LP.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local targetChar = p.Character
                local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

                if myRoot and targetRoot and targetHum and targetHum.Health > 0 then
                    -- คำนวณระยะทางระหว่างเรากับเป้าหมาย (Studs)
                    local distStuds = (targetRoot.Position - myRoot.Position).Magnitude

                    -- ตรวจสอบว่าอยู่ในรัศมีระยะประชิด (ไม่เกิน 2-3 คันรถ) หรือไม่
                    if distStuds <= maxDistanceStuds then
                        local myScreenPos, myVis = Cam:WorldToViewportPoint(myRoot.Position)
                        local targetScreenPos, targetVis = Cam:WorldToViewportPoint(targetRoot.Position)

                        if myVis or targetVis then
                            local startVec = Vector2.new(myScreenPos.X, myScreenPos.Y)
                            local endVec = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
                            local color = GetTargetColor(p)

                            -- ลากเส้นจากตัวเราไปหาศัตรู
                            line.From = startVec
                            line.To = endVec
                            line.Color = color
                            line.Visible = true

                            -- วางข้อความระยะทางไว้กึ่งกลางเส้นพอดี
                            local midPoint = Vector2.new((startVec.X + endVec.X) / 2, (startVec.Y + endVec.Y) / 2)
                            local distMeters = math.floor(distStuds * 0.28) -- แปลง Studs เป็นเมตรโดยประมาณ
                            
                            text.Position = midPoint
                            text.Text = tostring(distMeters) .. "m"
                            text.Color = color
                            text.Visible = true
                        else
                            line.Visible, text.Visible = false, false
                        end
                    else
                        -- ถ้าระยะเกิน 2-3 คันรถ ให้ซ่อนเส้นและตัวเลข
                        line.Visible, text.Visible = false, false
                    end
                else
                    line.Visible, text.Visible = false, false
                    if not p.Parent then conn:Disconnect() end
                end
            end)
        end

        -- ติดตั้ง ESP ให้ผู้เล่นทุกคนในเซิร์ฟเวอร์
        for _, p in pairs(P:GetPlayers()) do CreateProximityESP(p) end
        local addConn = P.PlayerAdded:Connect(CreateProximityESP)

        getgenv().KrizProximityCleanup = function()
            if addConn then addConn:Disconnect() end
            for _, obj in ipairs(drawObjects) do pcall(function() obj:Remove() end) end
        end
    end,
    OnDisable = function()
        getgenv().KrizProximityActive = false
        if getgenv().KrizProximityCleanup then pcall(getgenv().KrizProximityCleanup) end
    end
})


