            if dragging and input == activeInput then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then isMoved = true end
                Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        local function endDrag(input)
            if input == activeInput then
                dragging, activeInput = false, nil
            end
        end
        Button.InputEnded:Connect(endDrag)
        UIS.InputEnded:Connect(endDrag)

        -- สถานะเปิด-ปิด ล่องหนภายในปุ่มลอย (เริ่มต้นที่ OFF)
        local invisEffectActive = false
        local invisConn = nil

        local function enableInvisLoop()
            if invisConn then invisConn:Disconnect() end
            invisConn = RS.Heartbeat:Connect(function()
                if not getgenv().KrizInvisActive or not invisEffectActive or not LP.Character then return end
                local char, rootPart, humanoid = LP.Character, LP.Character:FindFirstChild("HumanoidRootPart"), LP.Character:FindFirstChild("Humanoid")
                if rootPart and humanoid then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then 
                            v.Transparency = 0.5 
                        elseif v:IsA("Decal") then 
                            v.Transparency = 0.5 
                        end
                    end
                    local cf, camOff = rootPart.CFrame, humanoid.CameraOffset
                    rootPart.CFrame, humanoid.CameraOffset = cf * CFrame.new(0, -40, 0), Vector3.new(camOff.X, camOff.Y + 40, camOff.Z)
                    RS.RenderStepped:Wait()
                    rootPart.CFrame, humanoid.CameraOffset = cf, camOff
                end
            end)
        end

        local function resetCharacterVisibility()
            if LP.Character then
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") then 
                        v.Transparency = (v.Name == "HumanoidRootPart") and 1 or 0 
                    elseif v:IsA("Decal") then 
                        v.Transparency = 0 
                    end
                end
            end
        end

        Button.MouseButton1Click:Connect(function()
            if not isMoved then
                invisEffectActive = not invisEffectActive
                if invisEffectActive then
                    Button.TextColor3 = Color3.fromRGB(0, 255, 0)
                    enableInvisLoop()
                    notify("INVISIBLE: ON")
                else
                    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    if invisConn then invisConn:Disconnect(); invisConn = nil end
                    resetCharacterVisibility()
                    notify("INVISIBLE: OFF")
                end
            end
        end)

        notify("INVISIBLE UI: OPEN")

        getgenv().KrizInvisCleanup = function()
            invisEffectActive = false
            if invisConn then invisConn:Disconnect(); invisConn = nil end
            if ScreenGui then ScreenGui:Destroy() end
            resetCharacterVisibility()
            notify("INVISIBLE: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizInvisActive = false
        if getgenv().KrizInvisCleanup then pcall(getgenv().KrizInvisCleanup) end
    end
})

