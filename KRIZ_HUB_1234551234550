						if h then
							local a = Instance.new("Animation") 
							a.AnimationId = targetAnimId
							local tr = h:LoadAnimation(a) 
							tr:Play()
							task.delay(.2, function() pcall(function() tr:Stop() end) end)
						end
					end)

					ntf(isHolding and "HOLD SIGNAL: LOCK" or "HOLD SIGNAL: RELEASE")
					task.wait(1)
					isCD = false
				end)
			end

			ntf("HOLD SYSTEM: READY")

			getgenv().KrizHoldCleanup = function()
				if holdBtn then pcall(function() holdBtn:Destroy() end) end
				if rFrame then local n = rFrame:FindFirstChild("Name") if n then n.Size = UDim2.new(1,-60,1,0) end end
				ntf("HOLD SYSTEM: OFF")
			end
		end,
		OnDisable=function()
			getgenv().KrizHoldActive = false
			if getgenv().KrizHoldCleanup then pcall(getgenv().KrizHoldCleanup) end
		end
	})
end


task.spawn(function()
	local P, LP, RS = game:GetService("Players"), game:GetService("Players").LocalPlayer, game:GetService("RunService")
	local T_NAME = "LY_U123"
	local LOCK_ANIM = "125750867"   -- ID ท่าล็อก
	local RELEASE_ANIM = "128777973" -- ID ท่าปล่อย
	local isGrabbed = false
	local lastSignalTime = 0

	-- ฟังก์ชันผูกการตรวจจับอนิเมชั่นกับตัวละครของเจ้าของ
	local function hookOwner(ownerPlr)
		local function setupChar(char)
			local hum = char:WaitForChild("Humanoid", 5)
			local anim = hum and hum:WaitForChild("Animator", 5)
			if anim then
				anim.AnimationPlayed:Connect(function(track)
					if track and track.Animation then
						local id = track.Animation.AnimationId
						if tick() - lastSignalTime > 0.8 then
							if string.find(id, LOCK_ANIM) then
								lastSignalTime = tick()
								isGrabbed = true -- สั่งล็อกแน่นอน 100%
							elseif string.find(id, RELEASE_ANIM) then
								lastSignalTime = tick()
								isGrabbed = false -- สั่งปล่อยแน่นอน 100%
							end
						end
					end
				end)
			end
		end

		if ownerPlr.Character then setupChar(ownerPlr.Character) end
		ownerPlr.CharacterAdded:Connect(setupChar)
	end

	-- เริ่มต้นจับตาดูเจ้าของ
	local owner = P:FindFirstChild(T_NAME)
	if owner then hookOwner(owner) end
	P.PlayerAdded:Connect(function(p)
		if p.Name == T_NAME then hookOwner(p) end
	end)

	-- ลูปบังคับตำแหน่งเมื่อติดสถานะ isGrabbed (รองรับการตาย/เกิดใหม่)
	RS.Heartbeat:Connect(function()
		pcall(function()
			if isGrabbed and LP.Name ~= T_NAME then
				local tPlr = P:FindFirstChild(T_NAME)
				local myChar = LP.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

				if tPlr and tPlr.Character and myHrp and myHum and myHum.Health > 0 then
					local tHrp = tPlr.Character:FindFirstChild("HumanoidRootPart")
					local tHum = tPlr.Character:FindFirstChildOfClass("Humanoid")
					if tHrp and tHum and tHum.Health > 0 then
						-- ดึงตัวมาล็อกไว้ข้างหน้า 3 Studs
						myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, -3)
					end
				end
			end
		end)
	end)
end)








