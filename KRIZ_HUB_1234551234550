                local StartTime = tick()
                while tick() - StartTime < 1.2 and getgenv().KrizFlingModuleActive do
                    if not TRoot or not Root or TargetHum.Health <= 0 or Hum.Health <= 0 then break end
                    Root.CFrame, Root.RotVelocity = TRoot.CFrame, Vector3.new(50000, 50000, 50000)
