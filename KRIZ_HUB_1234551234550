Core:RegisterModule({Name="ESP / มองทะลุ", Category="Visual", OnEnable=function()
    getgenv().KEsp = true local d = {}
    local function M(p)
        if p == LP then return end
        local o = {T=Drawing.new("Line"),B=Drawing.new("Line"),L=Drawing.new("Line"),R=Drawing.new("Line"),H=Drawing.new("Line"),N=Drawing.new("Text"),D=Drawing.new("Text")}
        for _,v in pairs(o) do table.insert(d,v) v.Visible,v.Center,v.Outline,v.OutlineColor,v.Transparency,v.Size = false,true,true,Color3.new(),1,13 end
        local cn; cn = RS.RenderStepped:Connect(function()
            if not getgenv().KEsp then for _,v in pairs(o) do v.Visible=false end cn:Disconnect() return end
            local c,hum,hrp = p.Character, p.Character and p.Character:FindFirstChildOfClass("Humanoid"), p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hum and hum.Health>0 then
                local pos,vis = Cam:WorldToViewportPoint(hrp.Position)
                if vis then
                    local dist = (hrp.Position-Cam.CFrame.Position).Magnitude
                    local h = math.abs(Cam:WorldToViewportPoint(c.Head.Position+Vector3.new(0,.5,0)).Y - Cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0)).Y)
                    local w,t,tr = h/1.5, math.clamp(1.2*(40/dist),.5,1.2), math.clamp(70/dist,.4,.9)
                    local clr = (p.Team and p.Team ~= LP.Team) and p.TeamColor.Color or Color3.new(1,1,1)
                    o.T.From,o.T.To,o.B.From,o.B.To = Vector2.new(pos.X-w/2,pos.Y-h/2),Vector2.new(pos.X+w/2,pos.Y-h/2),Vector2.new(pos.X-w/2,pos.Y+h/2),Vector2.new(pos.X+w/2,pos.Y+h/2)
                    o.L.From,o.L.To,o.R.From,o.R.To = Vector2.new(pos.X-w/2,pos.Y-h/2),Vector2.new(pos.X-w/2,pos.Y+h/2),Vector2.new(pos.X+w/2,pos.Y-h/2),Vector2.new(pos.X+w/2,pos.Y+h/2)
                    for _,l in pairs({o.T,o.B,o.L,o.R}) do l.Thickness,l.Transparency,l.Color,l.Visible = t,tr,clr,true end
                    local bX = pos.X-w/2-5
                    o.H.From,o.H.To,o.H.Thickness,o.H.Color,o.H.Transparency,o.H.Visible = Vector2.new(bX,pos.Y+h/2),Vector2.new(bX,pos.Y+h/2-(h*(hum.Health/hum.MaxHealth))),math.clamp(3*(40/dist),1.5,2.5),Color3.fromHSV(hum.Health/hum.MaxHealth*.3,1,1),tr,true
                    o.N.Position,o.N.Text,o.N.Color,o.N.Visible = Vector2.new(pos.X,pos.Y-h/2-16),p.Name,clr,true
                    o.D.Position,o.D.Text,o.D.Color,o.D.Visible = Vector2.new(pos.X,pos.Y+h/2+2),math.floor(dist).."m",Color3.new(1,1,1),true
                else for _,v in pairs(o) do v.Visible=false end end
            else for _,v in pairs(o) do v.Visible=false end if not p.Parent then cn:Disconnect() end end
        end)
    end
    for _,p in pairs(P:GetPlayers()) do M(p) end local a = P.PlayerAdded:Connect(M)
    getgenv().KCE = function() a:Disconnect() for _,v in ipairs(d) do pcall(function() v:Remove() end) end end
end, OnDisable=function() getgenv().KEsp=false if getgenv().KCE then pcall(getgenv().KCE) end end})

