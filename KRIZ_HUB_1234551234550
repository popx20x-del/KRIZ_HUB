        local currentTarget = nil
        local lastHealth = 0
        local timer = 0
        local blacklistedTargets = {}
        local lastClickTime = 0

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3})
                end)
            end)
        end

        -- ค้นหา rowFrame จาก Container ของหมวด Attack
        local rowFrame = nil
        pcall(function()
            if _G.KrizHubCore and _G.KrizHubCore.CategoryContainers and _G.KrizHubCore.CategoryContainers["Attack"] then
                local attackScroll = _G.KrizHubCore.CategoryContainers["Attack"].Scroll
                for _, child in ipairs(attackScroll:GetChildren()) do
