            end
            notify("UNDERFOOT: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizUnderfootActive = false
        if getgenv().KrizUnderfootCleanup then pcall(getgenv().KrizUnderfootCleanup) end
    end
})
