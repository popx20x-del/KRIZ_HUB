                end
                if BV then BV:Destroy() end
                if LP.Character then
                    for _, part in ipairs(LP.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end
                end
                workspace.CurrentCamera.CameraSubject = Hum
                if Root then Root.CFrame, Root.Velocity, Root.RotVelocity = OldPos, Vector3.zero, Vector3.zero end
            end
        end
        SingleBtn.MouseButton1Click:Connect(function()
