-- KRIZ HUB: NO FOG / เคลียร์หมอกทะลุขอบฟ้า
-- ==========================================
local Lighting = game:GetService("Lighting")

getgenv().NoFogEnabled = false
local originalFogEnd = Lighting.FogEnd
local originalAtmosphereDensity = nil

local function applyNoFog()
	-- 1. ดันระยะ Fog ออกไปไกลสุดขอบฟ้า
	Lighting.FogEnd = 999999999
	
	-- 2. ถ้าในแมพมี Atmosphere (หมอกไอหรือหมอกควัน) ให้ลด Density เป็น 0 หรือลบมันทิ้ง
	local atmos = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmos then
		originalAtmosphereDensity = atmos.Density
		atmos.Density = 0
	end
end

local function restoreFog()
	-- คืนค่าเดิมตอนปิดฟังก์ชัน
	Lighting.FogEnd = originalFogEnd
	
	local atmos = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmos and originalAtmosphereDensity then
		atmos.Density = originalAtmosphereDensity
	end
end

