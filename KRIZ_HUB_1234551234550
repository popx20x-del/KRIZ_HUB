        end
        local speedValue, airWalkPart, airWalkConn = 50, nil, nil
        local function cleanupAirWalk()
            if airWalkPart then airWalkPart:Destroy(); airWalkPart = nil end
            if airWalkConn then airWalkConn:Disconnect(); airWalkConn = nil end
        end
        local function enableAirWalk()
            cleanupAirWalk()
            airWalkPart = Instance.new("Part", workspace)
            airWalkPart.Size, airWalkPart.Anchored, airWalkPart.CanCollide, airWalkPart.Transparency = Vector3.new(500, 1, 500), true, true, 1
