function Core:RegisterModule(moduleData)
    if type(moduleData) ~= "table" or type(moduleData.Name) ~= "string" then return nil end
    local name = moduleData.Name if self.Modules[name] then return nil end
    local cat = moduleData.Category or "General"
    local containerData = self.CategoryContainers[cat] or self.CategoryContainers["General"]
    local inst = { Name = name, Data = moduleData, Enabled = false, Category = cat }

    local Row = Instance.new("Frame", containerData.Scroll)
    -- ตั้งชื่อให้ตรงกับโค้ดคำสั่งเดิมของคุณเป๊ะๆ เพื่อให้หาเจอผ่าน FindFirstChild
    Row.Name = "Function_" .. name
    Row.Size, Row.BackgroundColor3, Row.BackgroundTransparency, Row.BorderSizePixel, Row.ZIndex = UDim2.new(1, -6, 0, 40), Color3.fromRGB(20, 20, 20), 0.35, 0, 10002
    inst.Row = Row addCorner(Row) addStroke(Row)

    local NameLabel = Instance.new("TextLabel", Row)
    NameLabel.Name = "Name"
    NameLabel.Size, NameLabel.Position, NameLabel.BackgroundTransparency, NameLabel.Text, NameLabel.TextColor3, NameLabel.TextSize, NameLabel.Font, NameLabel.TextXAlignment, NameLabel.TextYAlignment, NameLabel.ZIndex = UDim2.new(1, -60, 1, 0), UDim2.new(0, 10, 0, 0), 1, name, Color3.fromRGB(255, 255, 255), 14, Enum.Font.Gotham, Enum.TextXAlignment.Left, Enum.TextYAlignment.Center, 10003

    local Toggle = Instance.new("TextButton", Row)
    Toggle.Name = "Toggle"
    Toggle.Size, Toggle.Position, Toggle.BackgroundColor3, Toggle.BackgroundTransparency, Toggle.BorderSizePixel, Toggle.Text, Toggle.AutoButtonColor, Toggle.ZIndex = UDim2.new(0, 38, 0, 20), UDim2.new(1, -48, 0.5, -10), Color3.fromRGB(55, 55, 55), 0.15, 0, "", false, 10003
    inst.Toggle = Toggle addCorner(Toggle, UDim.new(1, 0))

    local Dot = Instance.new("Frame", Toggle)
    Dot.Name = "Dot"
    Dot.Size, Dot.Position, Dot.BackgroundColor3, Dot.BorderSizePixel, Dot.ZIndex = UDim2.new(0, 16, 0, 16), UDim2.new(0, 2, 0.5, -8), Color3.fromRGB(230, 50, 50), 0, 10004
    inst.Dot = Dot addCorner(Dot, UDim.new(1, 0))

    local function setEnabled(state)
        inst.Enabled = state
        Dot.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        Dot.BackgroundColor3 = state and Color3.fromRGB(50, 230, 50) or Color3.fromRGB(230, 50, 50)
        Toggle.BackgroundColor3 = state and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(55, 55, 55)
    end

    inst.Connection = Toggle.Activated:Connect(function()
        setEnabled(not inst.Enabled)
        local cb = moduleData[inst.Enabled and "OnEnable" or "OnDisable"]
        if type(cb) == "function" then pcall(cb) end
    end)
    table.insert(self.Connections, inst.Connection)
    self.Modules[name] = inst table.insert(self.ModuleInstances, inst)
    task.defer(function() containerData.Scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(containerData.Layout.AbsoluteContentSize.Y + 8, 0)) end)
    return inst
end

function Core:UnregisterModule(name)
    local inst = self.Modules[name] if not inst then return false end
    if inst.Enabled then inst.Enabled = false pcall(inst.Data.OnDisable) end
    if inst.Connection then pcall(function() inst.Connection:Disconnect() end) end
    if inst.Row then inst.Row:Destroy() end
    for i, m in ipairs(self.ModuleInstances) do if m == inst then table.remove(self.ModuleInstances, i) break end end
    self.Modules[name] = nil return true
end

function Core:RegisterSetting(settingData)
    if type(settingData) ~= "table" or type(settingData.Name) ~= "string" or type(settingData.Type) ~= "string" then return nil end
    local sName = settingData.Name if self.Settings[sName] then return nil end
    local inst = { Name = sName, Data = settingData }
    local settingsContainer = self.CategoryContainers["Settings"]

    local Row = Instance.new("Frame", settingsContainer.Scroll)
    Row.Size, Row.BackgroundColor3, Row.BackgroundTransparency, Row.BorderSizePixel, Row.ZIndex = UDim2.new(1, -6, 0, 40), Color3.fromRGB(20, 20, 20), 0.35, 0, 10002
    inst.Row = Row addCorner(Row) addStroke(Row)

    local NameLabel = Instance.new("TextLabel", Row)
    NameLabel.Size, NameLabel.Position, NameLabel.BackgroundTransparency, NameLabel.Text, NameLabel.TextColor3, NameLabel.TextSize, NameLabel.Font, NameLabel.TextXAlignment, NameLabel.TextYAlignment, NameLabel.ZIndex = UDim2.new(0, 120, 1, 0), UDim2.new(0, 10, 0, 0), 1, sName, Color3.fromRGB(255, 255, 255), 13, Enum.Font.Gotham, Enum.TextXAlignment.Left, Enum.TextYAlignment.Center, 10003

    local sType = settingData.Type
    if sType == "Toggle" then
        local Toggle = Instance.new("TextButton", Row)
        Toggle.Size, Toggle.Position, Toggle.BackgroundColor3, Toggle.BackgroundTransparency, Toggle.BorderSizePixel, Toggle.Text, Toggle.AutoButtonColor, Toggle.ZIndex = UDim2.new(0, 38, 0, 20), UDim2.new(1, -48, 0.5, -10), Color3.fromRGB(55, 55, 55), 0.15, 0, "", false, 10003
        addCorner(Toggle, UDim.new(1, 0))
        local Dot = Instance.new("Frame", Toggle)
        Dot.Size, Dot.Position, Dot.BackgroundColor3, Dot.BorderSizePixel, Dot.ZIndex = UDim2.new(0, 16, 0, 16), UDim2.new(0, 2, 0.5, -8), Color3.fromRGB(230, 50, 50), 0, 10004
        addCorner(Dot, UDim.new(1, 0))
        local val = settingData.Default == true
        if val then Dot.Position, Dot.BackgroundColor3, Toggle.BackgroundColor3 = UDim2.new(1, -18, 0.5, -8), Color3.fromRGB(50, 230, 50), Color3.fromRGB(70, 70, 70) end
        inst.Connection = Toggle.Activated:Connect(function()
            val = not val
            Dot.Position = val and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            Dot.BackgroundColor3 = val and Color3.fromRGB(50, 230, 50) or Color3.fromRGB(230, 50, 50)
            Toggle.BackgroundColor3 = val and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(55, 55, 55)
            if type(settingData.Callback) == "function" then pcall(function() settingData.Callback(val) end) end
        end)
        table.insert(Core.Connections, inst.Connection)

    elseif sType == "Slider" or sType == "VerticalSlider" then
        local min, max, step = settingData.Min or 0, settingData.Max or 100, settingData.Step or 1
        local val = settingData.Default or min
        local ValLabel = Instance.new("TextLabel", Row)
        ValLabel.Size, ValLabel.Position, ValLabel.BackgroundTransparency, ValLabel.Text, ValLabel.TextColor3, ValLabel.TextSize, ValLabel.Font, ValLabel.TextXAlignment, ValLabel.TextYAlignment, ValLabel.ZIndex = UDim2.new(0, 80, 1, 0), UDim2.new(1, -90, 0, 0), 1, tostring(val), Color3.fromRGB(200, 200, 200), 12, Enum.Font.Gotham, Enum.TextXAlignment.Right, Enum.TextYAlignment.Center, 10003
        local SliderBar = Instance.new("Frame", Row)
        SliderBar.Size, SliderBar.Position, SliderBar.BackgroundColor3, SliderBar.BackgroundTransparency, SliderBar.BorderSizePixel, SliderBar.ZIndex = UDim2.new(0, 90, 0, 6), UDim2.new(1, -195, 0.5, -3), Color3.fromRGB(55, 55, 55), 0.2, 0, 10003
        addCorner(SliderBar, UDim.new(1, 0))
        local FillBar = Instance.new("Frame", SliderBar)
        FillBar.Size, FillBar.BackgroundColor3, FillBar.BorderSizePixel, FillBar.ZIndex = UDim2.new(math.clamp((val - min) / (max - min), 0, 1), 0, 1, 0), Color3.fromRGB(230, 50, 50), 0, 10004
        addCorner(FillBar, UDim.new(1, 0))

        local dragging = false
        local function updateSlider(input)
            local posRatio = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            val = math.clamp(math.floor((min + (max - min) * posRatio) / step + 0.5) * step, min, max)
            FillBar.Size, ValLabel.Text = UDim2.new((val - min) / (max - min), 0, 1, 0), tostring(val)
            if type(settingData.Callback) == "function" then pcall(function() settingData.Callback(val) end) end
        end
        table.insert(Core.Connections, SliderBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true updateSlider(input) end end))
        table.insert(Core.Connections, UIS.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end end))
        table.insert(Core.Connections, UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end))

    elseif sType == "Input" then
        local TextBox = Instance.new("TextBox", Row)
        TextBox.Size, TextBox.Position, TextBox.BackgroundColor3, TextBox.BackgroundTransparency, TextBox.BorderSizePixel, TextBox.Text, TextBox.TextColor3, TextBox.TextSize, TextBox.Font, TextBox.ZIndex = UDim2.new(0, 90, 0, 26), UDim2.new(1, -100, 0.5, -13), Color3.fromRGB(45, 45, 45), 0.1, 0, tostring(settingData.Default or ""), Color3.fromRGB(255, 255, 255), 12, Enum.Font.Gotham, 10003
        addCorner(TextBox, UDim.new(0, 6)) addStroke(TextBox, Color3.fromRGB(100, 100, 100), 1)
        inst.Connection = TextBox.FocusLost:Connect(function() if type(settingData.Callback) == "function" then pcall(function() settingData.Callback(TextBox.Text) end) end end)
        table.insert(Core.Connections, inst.Connection)

    elseif sType == "Button" then
        NameLabel.Size = UDim2.new(1, -20, 1, 0)
        local Btn = Instance.new("TextButton", Row)
        Btn.Size, Btn.Position, Btn.BackgroundColor3, Btn.BackgroundTransparency, Btn.BorderSizePixel, Btn.Text, Btn.TextColor3, Btn.TextSize,Btn.Font, Btn.AutoButtonColor, Btn.ZIndex = UDim2.new(0, 80, 0, 26), UDim2.new(1, -90, 0.5, -13), Color3.fromRGB(70, 70, 70), 0.1, 0, settingData.ButtonText or "Click", Color3.fromRGB(255, 255, 255), 12, Enum.Font.GothamBold, false, 10003
        addCorner(Btn, UDim.new(0, 6))
        inst.Connection = Btn.Activated:Connect(function() if type(settingData.Callback) == "function" then pcall(function() settingData.Callback() end) end end)
        table.insert(Core.Connections, inst.Connection)

    elseif sType == "Dropdown" then
        local DropBtn = Instance.new("TextButton", Row)
        DropBtn.Size, DropBtn.Position, DropBtn.BackgroundColor3, DropBtn.BackgroundTransparency, DropBtn.BorderSizePixel, DropBtn.Text, DropBtn.TextColor3, DropBtn.TextSize, DropBtn.Font, DropBtn.AutoButtonColor, DropBtn.ZIndex = UDim2.new(0, 90, 0, 26), UDim2.new(1, -100, 0.5, -13), Color3.fromRGB(45, 45, 45), 0.1, 0, tostring(settingData.Default or "Select"), Color3.fromRGB(255, 255, 255), 11, Enum.Font.Gotham, false, 10003
        addCorner(DropBtn, UDim.new(0, 6))
        local options, currentIndex = settingData.Options or {}, 1
        for i, opt in ipairs(options) do if opt == settingData.Default then currentIndex = i break end end
        inst.Connection = DropBtn.Activated:Connect(function()
            if #options == 0 then return end
            currentIndex = (currentIndex % #options) + 1
            local selected = options[currentIndex]
            DropBtn.Text = tostring(selected)
            if type(settingData.Callback) == "function" then pcall(function() settingData.Callback(selected) end) end
        end)
        table.insert(Core.Connections, inst.Connection)
    end

    self.Settings[sName] = inst table.insert(self.SettingInstances, inst)
    task.defer(function() settingsContainer.Scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(settingsContainer.Layout.AbsoluteContentSize.Y + 8, 0)) end)
    return inst
end

function Core:UnregisterSetting(sName)
    local inst = self.Settings[sName] if not inst then return false end
    if inst.Connection then pcall(function() inst.Connection:Disconnect() end) end
    if inst.Row then inst.Row:Destroy() end
    for i, s in ipairs(self.SettingInstances) do if s == inst then table.remove(self.SettingInstances, i) break end end
    self.Settings[sName] = nil return true
end

function Core:Destroy()
    for _, inst in ipairs(self.ModuleInstances) do if inst.Enabled then pcall(inst.Data.OnDisable) end end
    for _, conn in ipairs(self.Connections) do pcall(function() if conn.Connected then conn:Disconnect() end end) end
    self.Connections = {}
    if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
    self.Modules, self.ModuleInstances, self.Settings, self.SettingInstances, self.CategoryContainers = {}, {}, {}, {}, {}
    self.ScreenGui, self.MainMenu, Core.Icon, Core.ScrollContainer, Core.SettingsScrollContainer = nil, nil, nil, nil, nil
    if _G.KrizHubCore == self then _G.KrizHubCore = nil end
end

