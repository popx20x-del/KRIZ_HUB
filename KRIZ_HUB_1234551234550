Core:RegisterModule({Name="ESP Skeleton / โครงกระดูก", Category="Visual", OnEnable=function()
    getgenv().KSkel = true local dList = {}
    local function C(p)
        if p == LP then return end
        local ln = {Spine=Drawing.new("Line"),Chest=Drawing.new("Line"),LA1=Drawing.new("Line"),LA2=Drawing.new("Line"),RA1=Drawing.new("Line"),RA2=Drawing.new("Line"),LL1=Drawing.new("Line"),LL2=Drawing.new("Line"),RL1=Drawing.new("Line"),RL2=Drawing.new("Line")}
        for _,l in pairs(ln) do table.insert(dList,l) l.Visible,l.Thickness,l.Transparency,l.Outline,l.OutlineColor=false,1.2,.8,true,Color3.new() end
        local cn; cn = RS.RenderStepped:Connect(function()
            if not getgenv().KSkel then for _,l in pairs(ln) do l.Visible=false end cn:Disconnect() return end
            local c,hum,hrp = p.Character, p.Character and p.Character:FindFirstChildOfClass("Humanoid"), p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if c and hum and hum.Health>0 and hrp then
                local head = c:FindFirstChild("Head")
                if head then
                    local pH,vH = Cam:WorldToViewportPoint(head.Position)
                    local clr = (p.Team and p.Team ~= LP.Team) and p.TeamColor.Color or Color3.new(1,1,1)
                    if vH then
                        if hum.RigType == Enum.HumanoidRigType.R6 then
                            local torso = c:FindFirstChild("Torso")
                            if torso then
                                local pT,vT = Cam:WorldToViewportPoint(torso.Position) local tP = Vector2.new(pT.X,pT.Y)
                                ln.Chest.Visible,ln.LA2.Visible,ln.RA2.Visible,ln.LL2.Visible,ln.RL2.Visible=false,false,false,false,false
                                if vT then
                                    ln.Spine.From,ln.Spine.To,ln.Spine.Color,ln.Spine.Visible=Vector2.new(pH.X,pH.Y),tP,clr,true
                                    local function s6(l,n) local pt = c:FindFirstChild(n) if pt then local ps,vs=Cam:WorldToViewportPoint(pt.Position) if vs then l.From,l.To,l.Color,l.Visible=tP,Vector2.new(ps.X,ps.Y),clr,true else l.Visible=false end else l.Visible=false end end
                                    s6(ln.LA1,"Left Arm") s6(ln.RA1,"Right Arm") s6(ln.LL1,"Left Leg") s6(ln.RL1,"Right Leg")
                                else for _,l in pairs(ln) do l.Visible=false end end
                            end
                        elseif hum.RigType == Enum.HumanoidRigType.R15 then
                            local uT,lT = c:FindFirstChild("UpperTorso"),c:FindFirstChild("LowerTorso")
                            if uT and lT then
                                local pU,vU = Cam:WorldToViewportPoint(uT.Position) local pL,vL = Cam:WorldToViewportPoint(lT.Position)
                                local uP,lP = Vector2.new(pU.X,pU.Y), Vector2.new(pL.X,pL.Y)
                                if vU or vL then
                                    ln.Spine.From,ln.Spine.To,ln.Spine.Color,ln.Spine.Visible=Vector2.new(pH.X,pH.Y),uP,clr,true
                                    ln.Chest.From,ln.Chest.To,ln.Chest.Color,ln.Chest.Visible=uP,lP,clr,true
                                    local function s15(l1,l2,pA,pB,fP)
                                        if pA and pB then
                                            local s1,v1 = Cam:WorldToViewportPoint(pA.Position) local s2,v2 = Cam:WorldToViewportPoint(pB.Position)
                                            if v1 then l1.From,l1.To,l1.Color,l1.Visible=fP,Vector2.new(s1.X,s1.Y),clr,true else l1.Visible=false end
                                            if v1 and v2 then l2.From,l2.To,l2.Color,l2.Visible=Vector2.new(s1.X,s1.Y),Vector2.new(s2.X,s2.Y),clr,true else l2.Visible=false end
                                        else l1.Visible,l2.Visible=false,false end
                                    end
                                    s15(ln.LA1,ln.LA2,c:FindFirstChild("LeftUpperArm"),c:FindFirstChild("LeftLowerArm"),uP)
                                    s15(ln.RA1,ln.RA2,c:FindFirstChild("RightUpperArm"),c:FindFirstChild("RightLowerArm"),uP)
                                    s15(ln.LL1,ln.LL2,c:FindFirstChild("LeftUpperLeg"),c:FindFirstChild("LeftLowerLeg"),lP)
                                    s15(ln.RL1,ln.RL2,c:FindFirstChild("RightUpperLeg"),c:FindFirstChild("RightLowerLeg") or c:FindFirstChild("RightFoot"),lP)
                                else for _,l in pairs(ln) do l.Visible=false end end
                            end
                        end
                    else for _,l in pairs(ln) do l.Visible=false end end
                else for _,l in pairs(ln) do l.Visible=false end end
            else for _,l in pairs(ln) do l.Visible=false end if not p.Parent then cn:Disconnect() end end
        end)
    end
    for _,p in pairs(P:GetPlayers()) do C(p) end local a = P.PlayerAdded:Connect(C)
    getgenv().KSkelC = function() a:Disconnect() for _,o in ipairs(dList) do pcall(function() o:Remove() end) end end
end, OnDisable=function() getgenv().KSkel=false if getgenv().KSkelC then pcall(getgenv().KSkelC) end end})

