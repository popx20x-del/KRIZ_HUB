            airWalkConn = RS.Heartbeat:Connect(function()
                if not getgenv().KrizAirWalkActive then return end
                local char = LP.Character
                if not char or not airWalkPart then return end
                local root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                if not lockedY then lockedY = root.Position.Y - 4 end
                if hum.MoveDirection.Magnitude > 0.05 then lockedY = lockedY + ((root.Position.Y - 4) - lockedY) * 0.5 end
                airWalkPart.Position = Vector3.new(root.Position.X, lockedY, root.Position.Z)
            end)
        end
        local renderConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizAirWalkActive then return end
            local char = LP.Character
            if not char then return end
            local hum, root = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
            if root and hum and speedValue > 0 and hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (speedValue / 50))
            end
        end)
        local jumpConn = UIS.JumpRequest:Connect(function()
            if getgenv().KrizAirWalkActive and LP.Character then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end)
        enableAirWalk()
        notify("Air Walk: ON")
        getgenv().KrizAirWalkCleanup = function()
            if renderConn then renderConn:Disconnect() end
            if jumpConn then jumpConn:Disconnect() end
            cleanupAirWalk()
            notify("Air Walk: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizAirWalkActive = false
        if getgenv().KrizAirWalkCleanup then pcall(getgenv().KrizAirWalkCleanup) end
    end
})

