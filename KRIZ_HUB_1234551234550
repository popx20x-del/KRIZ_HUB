local C = function(p, r) local c = Instance.new("UICorner", p) c.CornerRadius = r or UDim.new(0,3) return c end
local S = function(p, col) local s = Instance.new("UIStroke", p) s.Color, s.Thickness = col or Color3.fromRGB(230,50,50), 1 return s end
local GI = function(p)
    local it = {}
    local function AT(v)
        if v:IsA("Tool") then
            local img = (v.TextureId and v.TextureId ~= "") and v.TextureId or (v:FindFirstChildOfClass("Decal") and v:FindFirstChildOfClass("Decal").Texture or "")
            table.insert(it, {Name = v.Name, Image = img})
        end
    end
    if p.Character then for _, v in ipairs(p.Character:GetChildren()) do AT(v) end end
    local b = p:FindFirstChild("Backpack")
    if b then for _, v in ipairs(b:GetChildren()) do AT(v) end end
    return it
end

