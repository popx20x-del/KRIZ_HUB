	Category="Defense",
	OnEnable=function()
		getgenv().KrizAntiFlingActive=true
		local S={Players=game:GetService("Players"),RunService=game:GetService("RunService"),StarterGui=game:GetService("StarterGui")}
		local LP=S.Players.LocalPlayer local afConns={}
		local function ntf(txt) task.spawn(function() pcall(function() S.StarterGui:SetCore("SendNotification",{Title="KRIZ HUB",Text=txt,Duration=3}) end) end) end
		local function startAF()
			local function pAdd(plr)
				local char,pPart,dtct=nil,nil,false
				local function cAdd(nChar)
					char=nChar repeat task.wait() pPart=nChar:FindFirstChild("HumanoidRootPart") until pPart dtct=false
				end
				if plr.Character then cAdd(plr.Character) end
				table.insert(afConns,plr.CharacterAdded:Connect(cAdd))
				table.insert(afConns,S.RunService.Heartbeat:Connect(function()
					if not getgenv().KrizAntiFlingActive then return end
					if char and pPart and char:IsDescendantOf(workspace) then
						if pPart.AssemblyAngularVelocity.Magnitude>50 or pPart.AssemblyLinearVelocity.Magnitude>100 then
							if not dtct then pcall(function() S.StarterGui:SetCore("ChatMakeSystemMessage",{Text="Fling Detected: "..plr.Name,Color=Color3.new(1,.8,0)}) end) end
							dtct=true
							for _,v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide,v.AssemblyAngularVelocity,v.AssemblyLinearVelocity=false,Vector3.zero,Vector3.zero end end
						end
					end
				end))
			end
			for _,v in ipairs(S.Players:GetPlayers()) do if v~=LP then pAdd(v) end end
			table.insert(afConns,S.Players.PlayerAdded:Connect(pAdd))
			local lPos=nil
			table.insert(afConns,S.RunService.Heartbeat:Connect(function()
				if not getgenv().KrizAntiFlingActive then return end
				local c,hrp=LP.Character,LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
				if hrp.AssemblyLinearVelocity.Magnitude>250 or hrp.AssemblyAngularVelocity.Magnitude>250 then
					hrp.AssemblyAngularVelocity,hrp.AssemblyLinearVelocity=Vector3.zero,Vector3.zero if lPos then hrp.CFrame=lPos end ntf("FLING NEUTRALIZED")
				elseif hrp.AssemblyLinearVelocity.Magnitude<50 then lPos=hrp.CFrame end
			end))
		end
		startAF() ntf("ANTI-FLING: ON")
		getgenv().KrizAntiFlingCleanup=function()
			for _,c in pairs(afConns) do pcall(function() c:Disconnect() end) end afConns={} ntf("ANTI-FLING: OFF")
		end
	end,
	OnDisable=function()
		getgenv().KrizAntiFlingActive=false
		if getgenv().KrizAntiFlingCleanup then pcall(getgenv().KrizAntiFlingCleanup) end
	end
})
