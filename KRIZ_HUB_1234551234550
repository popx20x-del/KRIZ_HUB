		-- ดักจับกรณีแมพโหลด Atmosphere เพิ่มทีหลัง
		if getgenv()._NoFogConn then getgenv()._NoFogConn:Disconnect() end
		getgenv()._NoFogConn = Lighting.ChildAdded:Connect(function(child)
			if getgenv().NoFogEnabled and child:IsA("Atmosphere") then
				originalAtmosphereDensity = child.Density
				child.Density = 0
			end
		end)
	end,
	OnDisable = function()
		getgenv().NoFogEnabled = false
		if getgenv()._NoFogConn then
			getgenv()._NoFogConn:Disconnect()
			getgenv()._NoFogConn = nil
		end
		restoreFog()
	end
})

