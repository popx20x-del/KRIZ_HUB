Core:RegisterModule({
    Name = "Vehicle Flight / บินยานพาหนะ",
    Category = "General",
    OnEnable = function()
        getgenv().KrizVehicleFlightActive = true
        local P, RS, W, LP = game:GetService("Players"), game:GetService("RunService"), game:GetService("Workspace"), game:GetService("Players").LocalPlayer
        local activeGui, renderConn, charRespawnConn, seatChangedConn = nil, nil, nil, nil
        local currentSpeedIndex, speeds = 1, {20, 50, 100, 500, 1000}
        local moveInputs = {Forward = false, Backward = false, Left = false, Right = false, Up = false, Down = false}
        local heldYPosition, isHoldingVertical = nil, false
        local function GetTargetVehicle()
            local char = LP.Character
            if not char then return nil, nil end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then return nil, nil end
            local seat = humanoid.SeatPart
            if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
                local model = seat:FindFirstAncestorOfClass("Model")
                return seat, (model or seat)
            end
            return nil, nil
        end
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name, screenGui.ResetOnSpawn, screenGui.DisplayOrder = "KrizVehicleFlightGui", false, 999
        local mainFrame = Instance.new("Frame", screenGui)
        mainFrame.Name, mainFrame.Size, mainFrame.Position, mainFrame.BackgroundColor3, mainFrame.BackgroundTransparency, mainFrame.BorderSizePixel, mainFrame.Active, mainFrame.Draggable = "ControlPanel", UDim2.new(0, 220, 0, 118), UDim2.new(0.05, 0, 0.4, 0), Color3.new(0, 0, 0), 0.5, 0, true, true
        local speedButton = Instance.new("TextButton", mainFrame)
        speedButton.Size, speedButton.Position, speedButton.BackgroundColor3, speedButton.BackgroundTransparency, speedButton.BorderSizePixel, speedButton.TextColor3, speedButton.TextSize, speedButton.Font, speedButton.Text = UDim2.new(1, -12, 0, 30), UDim2.new(0, 6, 0, 6), Color3.fromRGB(30, 30, 30), 0.3, 0, Color3.new(1, 1, 1), 14, Enum.Font.SourceSansBold, "Speed: " .. speeds[currentSpeedIndex]
        speedButton.MouseButton1Click:Connect(function()
            currentSpeedIndex = currentSpeedIndex % #speeds + 1
            speedButton.Text = "Speed: " .. speeds[currentSpeedIndex]
        end)
        local function CreateDirButton(name, text, posX, posY, sizeX, sizeY, inputKey)
            local btn = Instance.new("TextButton", mainFrame)
            btn.Name, btn.Size, btn.Position, btn.BackgroundColor3, btn.BackgroundTransparency, btn.BorderSizePixel, btn.TextColor3, btn.TextSize, btn.Font, btn.Text = name, UDim2.new(0, sizeX, 0, sizeY), UDim2.new(0, posX, 0, posY), Color3.fromRGB(40, 40, 40), 0.4, 0, Color3.new(1, 1, 1), 15, Enum.Font.SourceSansBold, text
            local function SetInput(state)
                moveInputs[inputKey] = state
                if inputKey == "Up" or inputKey == "Down" then
                    if state then isHoldingVertical = true else local _, veh = GetTargetVehicle(); local root = veh and (veh:IsA("Model") and veh.PrimaryPart or veh); if root then heldYPosition = root.Position.Y end; isHoldingVertical = false end
                end
            end
            btn.MouseButton1Down:Connect(function() SetInput(true) end)
            btn.MouseButton1Up:Connect(function() SetInput(false) end)
            btn.MouseLeave:Connect(function() SetInput(false) end)
            btn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch then SetInput(true) end end)
            btn.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch then SetInput(false) end end)
            return btn
        end
        CreateDirButton("BtnUp", "UP", 6, 42, 65, 33, "Up")
        CreateDirButton("BtnForward", "^", 77, 42, 65, 33, "Forward")
        CreateDirButton("BtnDown", "DOWN", 148, 42, 65, 33, "Down")
        CreateDirButton("BtnLeft", "<", 6, 79, 65, 33, "Left")
        CreateDirButton("BtnBackward", "v", 77, 79, 65, 33, "Backward")
        CreateDirButton("BtnRight", ">", 148, 79, 65, 33, "Right")
        pcall(function() screenGui.Parent = LP:WaitForChild("PlayerGui") end)
        if not screenGui.Parent then pcall(function() screenGui.Parent = game:GetService("CoreGui") end) end
        activeGui = screenGui
        local lastActiveVehicle = nil
        local lastTick = tick()
        renderConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizVehicleFlightActive then return end
            lastTick = tick()
            local seat, vehicle = GetTargetVehicle()
            if not vehicle then lastActiveVehicle, heldYPosition = nil, nil; return end
            if vehicle:IsA("Model") and not vehicle.PrimaryPart then
                local root = vehicle:FindFirstChild("HumanoidRootPart") or vehicle:FindFirstChild("Body") or seat
                if root and root:IsA("BasePart") then vehicle.PrimaryPart = root end
            end
            local rootPart = vehicle:IsA("Model") and vehicle.PrimaryPart or vehicle
            if not rootPart then return end
            if lastActiveVehicle ~= vehicle then lastActiveVehicle, heldYPosition = vehicle, rootPart.Position.Y end
            if not heldYPosition then heldYPosition = rootPart.Position.Y end
            local currentSpeed, verticalSpeed = speeds[currentSpeedIndex], speeds[currentSpeedIndex] / 2
            local cam = W.CurrentCamera
            local camCF = cam and cam.CFrame or CFrame.new()
            local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            lookFlat = lookFlat.Magnitude > 0 and lookFlat.Unit or Vector3.new(0, 0, -1)
            local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            rightFlat = rightFlat.Magnitude > 0 and rightFlat.Unit or Vector3.new(1, 0, 0)
            local moveDir = Vector3.zero
            if moveInputs.Forward then moveDir = moveDir + lookFlat end
            if moveInputs.Backward then moveDir = moveDir - lookFlat end
            if moveInputs.Left then moveDir = moveDir - rightFlat end
            if moveInputs.Right then moveDir = moveDir + rightFlat end
            if moveInputs.Up then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if moveInputs.Down then moveDir = moveDir - Vector3.new(0, 1, 0) end
            pcall(function()
                local currentPos = rootPart.Position
                local targetVelocity = Vector3.zero
                if moveDir.Magnitude > 0 then
                    local horizontalMove = Vector3.new(moveDir.X, 0, moveDir.Z)
                    horizontalMove = horizontalMove.Magnitude > 0 and horizontalMove.Unit or horizontalMove
                    local verticalMove = Vector3.new(0, moveDir.Y, 0)
                    targetVelocity = (moveInputs.Up or moveInputs.Down) and ((horizontalMove * currentSpeed) + (verticalMove * verticalSpeed)) or (horizontalMove * currentSpeed)
                    rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = targetVelocity, Vector3.zero
                    local fixedY = (moveInputs.Up or moveInputs.Down) and currentPos.Y or heldYPosition
                    local newPos = Vector3.new(currentPos.X, fixedY, currentPos.Z)
                    if vehicle:IsA("Model") then vehicle:SetPrimaryPartCFrame(CFrame.new(newPos)) else rootPart.CFrame = CFrame.new(newPos) end
                else
                    rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                    local newPos = Vector3.new(currentPos.X, heldYPosition, currentPos.Z)
                    if vehicle:IsA("Model") then vehicle:SetPrimaryPartCFrame(CFrame.new(newPos)) else rootPart.CFrame = CFrame.new(newPos) end
                end
            end)
        end)
        getgenv().KrizVehicleFlightCleanup = function()
            getgenv().KrizVehicleFlightActive = false
            if renderConn then pcall(function() renderConn:Disconnect() end); renderConn = nil end
            if charRespawnConn then pcall(function() charRespawnConn:Disconnect() end); charRespawnConn = nil end
            if seatChangedConn then pcall(function() seatChangedConn:Disconnect() end); seatChangedConn = nil end
            if activeGui then pcall(function() activeGui:Destroy() end); activeGui = nil end
            heldYPosition = nil
        end
    end,
    OnDisable = function()
        getgenv().KrizVehicleFlightActive = false
        if getgenv().KrizVehicleFlightCleanup then pcall(getgenv().KrizVehicleFlightCleanup) end
    end
})
