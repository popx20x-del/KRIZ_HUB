        local ScreenGui = Instance.new("ScreenGui", CG)
        ScreenGui.Name, ScreenGui.ResetOnSpawn, ScreenGui.Enabled = "MidnightFlingUI", false, true
        local MainFrame = Instance.new("Frame", ScreenGui)
        MainFrame.Name, MainFrame.BackgroundColor3, MainFrame.BackgroundTransparency, MainFrame.Position, MainFrame.Size, MainFrame.Active, MainFrame.Draggable = "MainFrame", Color3.fromRGB(15, 15, 20), 0.5, UDim2.new(0.5, -90, 0.5, -50), UDim2.new(0, 180, 0, 105), true, true
        local TextBox = Instance.new("TextBox", MainFrame)
        TextBox.BackgroundColor3, TextBox.BackgroundTransparency, TextBox.Position, TextBox.Size, TextBox.Font, TextBox.PlaceholderText, TextBox.PlaceholderColor3, TextBox.Text, TextBox.TextColor3, TextBox.TextSize = Color3.fromRGB(25, 25, 30), 0.8, UDim2.new(0.08, 0, 0.15, 0), UDim2.new(0.84, 0, 0, 28), Enum.Font.Gotham, "ชี้เป้าหมาย", Color3.fromRGB(180, 180, 190), "", Color3.new(1, 1, 1), 12
        local SingleBtn = Instance.new("TextButton", MainFrame)
        SingleBtn.BackgroundColor3, SingleBtn.BackgroundTransparency, SingleBtn.Position, SingleBtn.Size, SingleBtn.Font, SingleBtn.Text, SingleBtn.TextColor3, SingleBtn.TextSize = Color3.fromRGB(25, 25, 30), 0.8, UDim2.new(0.08, 0, 0.58, 0), UDim2.new(0.4, 0, 0, 28), Enum.Font.GothamBold, "FLING", Color3.new(1, 1, 1), 11
        local LoopBtn = Instance.new("TextButton", MainFrame)
        LoopBtn.BackgroundColor3, LoopBtn.BackgroundTransparency, LoopBtn.Position, LoopBtn.Size, LoopBtn.Font, LoopBtn.Text, LoopBtn.TextColor3, LoopBtn.TextSize = Color3.fromRGB(25, 25, 30), 0.8, UDim2.new(0.52, 0, 0.58, 0), UDim2.new(0.4, 0, 0, 28), Enum.Font.GothamBold, "LOOP", Color3.new(1, 1, 1), 11
