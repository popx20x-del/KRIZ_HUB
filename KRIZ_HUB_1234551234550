Core:RegisterModule({
	Name="Shift Lock Force / หันตามทิศทางเดิน",Category="Settings",
	OnEnable=function()
		getgenv().KrizShiftLockActive=true
		local LP,RS=game:GetService("Players").LocalPlayer,game:GetService("RunService")
		getgenv().KrizShiftCleanup=function()
			if getgenv().KrizShiftConn then pcall(function() getgenv().KrizShiftConn:Disconnect() end) getgenv().KrizShiftConn=nil end
			if getgenv().KrizShiftGuard then pcall(function() getgenv().KrizShiftGuard:Disconnect() end) getgenv().KrizShiftGuard=nil end
			pcall(function() if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then LP.Character:FindFirstChildOfClass("Humanoid").AutoRotate=true end end)
		end
		local function setup()
			if getgenv().KrizShiftConn then pcall(function() getgenv().KrizShiftConn:Disconnect() end) end
			getgenv().KrizShiftConn=RS.RenderStepped:Connect(function(dt)
				if not getgenv().KrizShiftLockActive then return end
				local c,h,hum=LP.Character,LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"),LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
				if h and hum and hum.Health>0 then
					hum.AutoRotate=false
					if hum.MoveDirection.Magnitude>.05 then
						local tCF=CFrame.lookAt(h.Position,h.Position+Vector3.new(hum.MoveDirection.X,0,hum.MoveDirection.Z))
						h.CFrame=h.CFrame:Lerp(tCF,math.clamp(dt*20,.15,.4))
					end
				end
			end)
		end
		setup()
		getgenv().KrizShiftGuard=LP.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart",5) char:WaitForChild("Humanoid",5) task.wait(.1)
			if getgenv().KrizShiftLockActive then setup() end
		end)
	end,
