            for _, v in pairs(P:GetPlayers()) do
                if v ~= LP and (v.Name:lower():find(Name:lower()) or v.DisplayName:lower():find(Name:lower())) then return v end
            end
            return nil
        end
        local function ExecuteFling(Target)
            if not getgenv().KrizFlingModuleActive or not Target or not Target.Character or not LP.Character then return end
            local Root, TRoot, Hum, TargetHum = LP.Character:FindFirstChild("HumanoidRootPart"), Target.Character:FindFirstChild("HumanoidRootPart"), LP.Character:FindFirstChildOfClass("Humanoid"), Target.Character:FindFirstChildOfClass("Humanoid")
            if Root and TRoot and Hum and TargetHum and TargetHum.Health > 0 and Hum.Health > 0 then
