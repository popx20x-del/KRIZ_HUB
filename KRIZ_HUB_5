Core:RegisterModule({

    Name = "Air Walk / เดินบนอากาศ",

    OnEnable = function()
        getgenv().KrizAirWalkActive = true

        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        local StarterGui = game:GetService("StarterGui")
        local LocalPlayer = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local speedValue = 50 
        local airWalkPart = nil
        local airWalkConn = nil

        local function cleanupAirWalk()
            if airWalkPart then 
                airWalkPart:Destroy() 
                airWalkPart = nil 
            end
            if airWalkConn then 
                airWalkConn:Disconnect() 
                airWalkConn = nil 
            end
        end

        local function enableAirWalk()
            cleanupAirWalk()
            airWalkPart = Instance.new("Part")
            airWalkPart.Size = Vector3.new(500, 1, 500)
            airWalkPart.Anchored = true
            airWalkPart.CanCollide = true
            airWalkPart.Transparency = 1
            airWalkPart.Parent = workspace
            
            local lockedY = nil
            airWalkConn = RunService.Heartbeat:Connect(function()
                if not getgenv().KrizAirWalkActive then return end
                local char = LocalPlayer.Character
                if not char or not airWalkPart then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                
                if not lockedY then 
                    lockedY = root.Position.Y - 4 
                end
                
                if hum.MoveDirection.Magnitude > 0.05 then
                    local targetY = root.Position.Y - 4
                    lockedY = lockedY + (targetY - lockedY) * 0.5
                end
                
                airWalkPart.Position = Vector3.new(root.Position.X, lockedY, root.Position.Z)
            end)
        end

        -- ลูปช่วยเร่งความเร็วในการเคลื่อนที่กลางอากาศ
        local renderConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizAirWalkActive then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if root and hum and speedValue > 0 and hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (speedValue / 50))
            end
        end)

        -- รองรับการกดกระโดดกลางอากาศ
        local jumpConn = UserInputService.JumpRequest:Connect(function()
            if getgenv().KrizAirWalkActive and LocalPlayer.Character then
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then 
                    hum:ChangeState(Enum.HumanoidStateType.Jumping) 
                end
            end
        end)

        enableAirWalk()
        notify("Air Walk: ON")

        -- ฟังก์ชัน Cleanup สำหรับทำความสะอาดเมื่อปิดโมดูล
        getgenv().KrizAirWalkCleanup = function()
            if renderConn then renderConn:Disconnect() end
            if jumpConn then jumpConn:Disconnect() end
            cleanupAirWalk()
            notify("Air Walk: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizAirWalkActive = false
        if getgenv().KrizAirWalkCleanup then
            pcall(getgenv().KrizAirWalkCleanup)
        end
    end

})



