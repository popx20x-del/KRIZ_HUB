-- MODULE: ESP (บ็อกซ์ + เลือด + ชื่อ + ระยะทาง)
--------------------------------------------------

Core:RegisterModule({

    Name = "ESP / มองทะลุ",

    OnEnable = function()
        getgenv().KrizEspActive = true

        local Players = game:GetService("Players")
        local lp = Players.LocalPlayer
        local RunService = game:GetService("RunService")
        local cam = workspace.CurrentCamera
        local drawingsList = {}

        local function GetCol(p)
            local c, b = p.Character, p:FindFirstChild("Backpack")
            if c then
                if c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife")) then return Color3.new(1,0,0) end
                if c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun")) then return Color3.new(0,0,1) end
            end
            return (p.Team and p.Team ~= lp.Team) and p.TeamColor.Color or Color3.new(1,1,1)
        end

        local function CreateESP(p)
            if p == lp then return end
            local d = {
                T=Drawing.new("Line"), B=Drawing.new("Line"), L=Drawing.new("Line"), R=Drawing.new("Line"), 
                H=Drawing.new("Line"), N=Drawing.new("Text"), D=Drawing.new("Text")
            }
            for _, v in pairs(d) do table.insert(drawingsList, v) end
            for _, v in pairs(d) do 
                v.Visible = false 
                if v.Center ~= nil then 
                    v.Center = true; v.Outline = true; v.OutlineColor = Color3.new(0,0,0); v.Transparency = 1; v.Font = 0; v.Size = 13 
                end 
            end

            local conn
            conn = RunService.RenderStepped:Connect(function()
                if not getgenv().KrizEspActive then
                    for _, v in pairs(d) do v.Visible = false end
                    if conn then conn:Disconnect() end
                    return
                end

                local c = p.Character
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                
                if hrp and hum and hum.Health > 0 then
                    local pos, vis = cam:WorldToViewportPoint(hrp.Position)
                    if vis then
                        local dist = (hrp.Position - cam.CFrame.Position).Magnitude
                        local head = cam:WorldToViewportPoint(c.Head.Position + Vector3.new(0,0.5,0))
                        local leg = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                        local h = math.abs(head.Y - leg.Y)
                        local w = h / 1.5
                        local clr = GetCol(p)
                        local thk = math.clamp(1.2 * (40/dist), 0.5, 1.2)
                        local trans = math.clamp(70/dist, 0.4, 0.9)

                        d.T.From, d.T.To = Vector2.new(pos.X-w/2, pos.Y-h/2), Vector2.new(pos.X+w/2, pos.Y-h/2)
                        d.B.From, d.B.To = Vector2.new(pos.X-w/2, pos.Y+h/2), Vector2.new(pos.X+w/2, pos.Y+h/2)
                        d.L.From, d.L.To = Vector2.new(pos.X-w/2, pos.Y-h/2), Vector2.new(pos.X-w/2, pos.Y+h/2)
                        d.R.From, d.R.To = Vector2.new(pos.X+w/2, pos.Y-h/2), Vector2.new(pos.X+w/2, pos.Y+h/2)
                        for _, l in pairs({d.T, d.B, d.L, d.R}) do l.Thickness, l.Transparency, l.Color, l.Visible = thk, trans, clr, true end

                        local hThk, barX = math.clamp(3 * (40/dist), 1.5, 2.5), pos.X-w/2-5
                        d.H.From, d.H.To = Vector2.new(barX, pos.Y+h/2), Vector2.new(barX, pos.Y+h/2-(h*(hum.Health/hum.MaxHealth)))
                        d.H.Thickness, d.H.Color, d.H.Transparency, d.H.Visible = hThk, Color3.fromHSV(hum.Health/hum.MaxHealth*0.3, 1, 1), trans, true

                        d.N.Position, d.N.Text, d.N.Color, d.N.Visible = Vector2.new(pos.X, pos.Y-h/2-16), p.Name, clr, true
                        d.D.Position, d.D.Text, d.D.Color, d.D.Visible = Vector2.new(pos.X, pos.Y+h/2+2), math.floor(dist).."m", Color3.new(1,1,1), true
                    else 
                        for _, v in pairs(d) do v.Visible = false end 
                    end
                else
                    for _, v in pairs(d) do v.Visible = false end
                    if not p.Parent then conn:Disconnect() end
                end
            end)
        end

        for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
        local playerAddedConn = Players.PlayerAdded:Connect(CreateESP)
        
        getgenv().KrizEspCleanup = function()
            if playerAddedConn then playerAddedConn:Disconnect() end
            for _, obj in ipairs(drawingsList) do
                pcall(function() obj:Remove() end)
            end
        end
    end,

    OnDisable = function()
        getgenv().KrizEspActive = false
        if getgenv().KrizEspCleanup then
            pcall(getgenv().KrizEspCleanup)
        end
    end

})



--------------------------------------------------
-- MODULE: ESP HIGHLIGHT (ไฮไลท์ตัวละคร + แก้ไขระบบปิดและเคลียร์ข้อมูล)
--------------------------------------------------

Core:RegisterModule({

    Name = "ESP Highlight / ไฮไลท์",

    OnEnable = function()
        getgenv().KrizHighlightActive = true

        local Players = game:GetService("Players")
        local lp = Players.LocalPlayer
        local RunService = game:GetService("RunService")
        
        local highlights = {}
        local playerConnections = {}
        local playerAddedConn = nil
        local playerRemovingConn = nil
        local updateConn = nil

        local function GetCol(p)
            local c, b = p.Character, p:FindFirstChild("Backpack")
            if c then
                if c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife")) then 
                    return Color3.new(1, 0, 0)
                end
                if c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun")) then 
                    return Color3.new(0, 0, 1)
                end
            end
            return (p.Team and p.Team ~= lp.Team) and p.TeamColor.Color or Color3.new(1, 1, 1)
        end

        local function RemoveHighlight(p)
            if highlights[p] then
                pcall(function()
                    highlights[p]:Destroy()
                end)
                highlights[p] = nil
            end
        end

        local function SetupPlayer(p)
            if p == lp then return end

            local function OnCharacterAdded(char)
                -- ตรวจสอบสถานะ active ก่อนสร้างทุกครั้ง ป้องกันกรณีปิด ESP ไปแล้วแต่ event เก่ายังทำงาน
                if not getgenv().KrizHighlightActive then return end

                RemoveHighlight(p)

                if char then
                    local hl = Instance.new("Highlight")
                    hl.Name = "KrizHighlight_" .. p.Name
                    hl.Adornee = char
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = char

                    highlights[p] = hl
                end
            end

            if p.Character and getgenv().KrizHighlightActive then
                task.spawn(function()
                    OnCharacterAdded(p.Character)
                end)
            end

            local charAddedConn = p.CharacterAdded:Connect(OnCharacterAdded)
            
            playerConnections[p] = {
                CharAdded = charAddedConn
            }
        end

        local function CleanupPlayer(p)
            RemoveHighlight(p)
            if playerConnections[p] then
                if playerConnections[p].CharAdded then
                    pcall(function() playerConnections[p].CharAdded:Disconnect() end)
                end
                playerConnections[p] = nil
            end
        end

        -- วนลูปสร้าง Highlight ให้กับผู้เล่นทุกคน
        for _, p in pairs(Players:GetPlayers()) do
            SetupPlayer(p)
        end

        playerAddedConn = Players.PlayerAdded:Connect(SetupPlayer)
        playerRemovingConn = Players.PlayerRemoving:Connect(CleanupPlayer)

        updateConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizHighlightActive then return end
            for p, hl in pairs(highlights) do
                if hl and hl.Parent then
                    local color = GetCol(p)
                    hl.FillColor = color
                    hl.OutlineColor = color
                end
            end
        end)

        getgenv().KrizHighlightCleanup = function()
            -- ตัดการทำงานของ Loop และ Event หลักทันที
            if updateConn then 
                pcall(function() updateConn:Disconnect() end)
                updateConn = nil 
            end
            if playerAddedConn then 
                pcall(function() playerAddedConn:Disconnect() end)
                playerAddedConn = nil 
            end
            if playerRemovingConn then 
                pcall(function() playerRemovingConn:Disconnect() end)
                playerRemovingConn = nil 
            end

            -- เคลียร์ข้อมูลและลบ Highlight ของผู้เล่นทุกคนออกจากตัวละครจริง ๆ
            for _, p in ipairs(Players:GetPlayers()) do
                CleanupPlayer(p)
            end

            highlights = {}
            playerConnections = {}
        end
    end,

    OnDisable = function()
        getgenv().KrizHighlightActive = false
        if getgenv().KrizHighlightCleanup then
            pcall(getgenv().KrizHighlightCleanup)
        end
    end

})



