task.spawn(function()
_G.ExternalCommands = _G.ExternalCommands or {}
_G.fpsBoostActive = _G.fpsBoostActive or false

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- LOD distance
local NEAR = 80
local MID  = 160
local FAR  = 260

local function setPartLow(part)
    part.Material = Enum.Material.Plastic
    part.Reflectance = 0
    part.CastShadow = false
end

local function Optimize(obj)
    pcall(function()
        if obj:IsA("BasePart") then
            setPartLow(obj)

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1

        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles") then
            obj.Enabled = false

        elseif obj:IsA("SurfaceAppearance") then
            obj:Destroy()

        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            obj.Enabled = false
        end
    end)
end

local function CleanCharacter(char)
    for _,v in ipairs(char:GetDescendants()) do
        pcall(function()
            if v:IsA("Accessory")
                or v:IsA("Shirt")
                or v:IsA("Pants")
                or v:IsA("ShirtGraphic")
                or v:IsA("Highlight") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                setPartLow(v)
            end
        end)
    end
end

local function SetupGraphics()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 0
    Lighting.FogEnd = 1e9
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.ClockTime = 12

    for _,v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            v:Destroy()
        end
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
end

-- LOD cache กันคำนวณทุกเฟรม
local lastCull = 0
local CULL_INTERVAL = 0.15

local function CullPlayers()
    local camPos = Camera.CFrame.Position

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (camPos - hrp.Position).Magnitude

                local state
                if dist <= NEAR then
                    state = "NEAR"
                elseif dist <= MID then
                    state = "MID"
                elseif dist <= FAR then
                    state = "FAR"
                else
                    state = "HIDE"
                end

                for _,obj in ipairs(plr.Character:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        if state == "NEAR" then
                            obj.Transparency = 0
                            obj.CastShadow = false

                        elseif state == "MID" then
                            obj.Transparency = 0.3
                            obj.CastShadow = false
                            obj.Material = Enum.Material.Plastic

                        elseif state == "FAR" or state == "HIDE" then
                            obj.Transparency = 1
                            obj.CastShadow = false
                        end
                    end
                end
            end
        end
    end
end

local function EnableFPS()
    SetupGraphics()

    for _,v in ipairs(game:GetDescendants()) do
        Optimize(v)
    end

    game.DescendantAdded:Connect(function(v)
        if _G.fpsBoostActive then
            task.defer(function()
                Optimize(v)
            end)
        end
    end)

    local function HookPlayer(plr)
        if plr.Character then
            CleanCharacter(plr.Character)
        end
        plr.CharacterAdded:Connect(CleanCharacter)
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        HookPlayer(plr)
    end

    Players.PlayerAdded:Connect(HookPlayer)

    RunService.RenderStepped:Connect(function()
        if not _G.fpsBoostActive then return end

        local now = os.clock()
        if now - lastCull >= CULL_INTERVAL then
            lastCull = now
            CullPlayers()
        end
    end)
end

_G.ExternalCommands["fps.."] = function()
    _G.fpsBoostActive = not _G.fpsBoostActive

    if _G.fpsBoostActive then
        EnableFPS()
    end

    return true, (_G.fpsBoostActive and "FPS BOOST: ON (LOD MODE)" or "OFF")
end
end)


