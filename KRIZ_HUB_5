-- MODULE: NOCLIP / ทะลุทุกอย่าง (Original Script Integration)
--------------------------------------------------

Core:RegisterModule({

    Name = "Noclip / เดินทะลุทุกอย่าง",

    OnEnable = function()
        getgenv().KrizNoclipActive = true

        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local StarterGui = game:GetService("StarterGui")
        local LP = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        if getgenv().KRIZ_NOCLIP_CONN then
            getgenv().KRIZ_NOCLIP_CONN:Disconnect()
        end

        local lastState = false

        -- ฟังก์ชันเปลี่ยนค่าการชนของวัตถุทั้งแมพตามต้นฉบับ
        local function setCollisions(state)
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then 
                        obj.CanCollide = state 
                    end
                end
            end)
        end

        getgenv().KRIZ_NOCLIP_CONN = RunService.Stepped:Connect(function()
            if getgenv().KrizNoclipActive and LP.Character then
                if lastState == false then
                    lastState = true
                    setCollisions(false)
                end
                
                -- ปิดการชนของชิ้นส่วนตัวละครทั้งหมด
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") then 
                        v.CanCollide = false 
                    end
                end
                
                -- ยิง Ray เช็คพื้นใต้เท้า แล้วเปิด CanCollide ให้เฉพาะพื้นตัวที่เหยียบเพื่อกันตกแมพ
                local root = LP.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local ray = Ray.new(root.Position, Vector3.new(0, -6, 0))
                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LP.Character})
                    if hit then 
                        hit.CanCollide = true 
                    end
                end
            else
                if lastState == true then
                    lastState = false
                    setCollisions(true)
                end
            end
        end)

        notify("NOCLIP: ON")

        -- ฟังก์ชัน Cleanup เมื่อปิดโมดูล
        getgenv().KrizNoclipCleanup = function()
            if getgenv().KRIZ_NOCLIP_CONN then
                getgenv().KRIZ_NOCLIP_CONN:Disconnect()
                getgenv().KRIZ_NOCLIP_CONN = nil
            end
            setCollisions(true)
            notify("NOCLIP: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizNoclipActive = false
        if getgenv().KrizNoclipCleanup then
            pcall(getgenv().KrizNoclipCleanup)
        end
    end

})




--------------------------------------------------
-- MODULE: ANTI-FLING / ป้องกันโดนปัดกระเด็น
--------------------------------------------------

Core:RegisterModule({

    Name = "Anti-Fling / ป้องกันฟลิง",

    OnEnable = function()
        getgenv().KrizAntiFlingActive = true

        local Services = {
            Players = game:GetService("Players"),
            RunService = game:GetService("RunService"),
            StarterGui = game:GetService("StarterGui")
        }
        local LP = Services.Players.LocalPlayer
        local antiFlingConnections = {}

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    Services.StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local function StartAntiFling()
            local function PlayerAdded(Player)
                local Character, PrimaryPart, Detected = nil, nil, false
                
                local function CharacterAdded(NewChar)
                    Character = NewChar
                    repeat task.wait() PrimaryPart = NewChar:FindFirstChild("HumanoidRootPart") until PrimaryPart
                    Detected = false
                end
                
                if Player.Character then 
                    CharacterAdded(Player.Character) 
                end
                
                table.insert(antiFlingConnections, Player.CharacterAdded:Connect(CharacterAdded))

                table.insert(antiFlingConnections, Services.RunService.Heartbeat:Connect(function()
                    if not getgenv().KrizAntiFlingActive then return end
                    if Character and PrimaryPart and Character:IsDescendantOf(workspace) then
                        if PrimaryPart.AssemblyAngularVelocity.Magnitude > 50 or PrimaryPart.AssemblyLinearVelocity.Magnitude > 100 then
                            if not Detected then
                                pcall(function()
                                    Services.StarterGui:SetCore("ChatMakeSystemMessage", {
                                        Text = "Fling Detected: " .. Player.Name,
                                        Color = Color3.new(1, 0.8, 0)
                                    })
                                end)
                            end
                            Detected = true
                            for _, v in ipairs(Character:GetDescendants()) do
                                if v:IsA("BasePart") then 
                                    v.CanCollide = false
                                    v.AssemblyAngularVelocity = Vector3.zero
                                    v.AssemblyLinearVelocity = Vector3.zero 
                                end
                            end
                        end
                    end
                end))
            end

            for _, v in ipairs(Services.Players:GetPlayers()) do 
                if v ~= LP then 
                    PlayerAdded(v) 
                end 
            end
            
            table.insert(antiFlingConnections, Services.Players.PlayerAdded:Connect(PlayerAdded))

            local LastPosition = nil
            table.insert(antiFlingConnections, Services.RunService.Heartbeat:Connect(function()
                if not getgenv().KrizAntiFlingActive then return end
                local Char = LP.Character
                local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
                if not HRP then return end
                
                if HRP.AssemblyLinearVelocity.Magnitude > 250 or HRP.AssemblyAngularVelocity.Magnitude > 250 then
                    HRP.AssemblyAngularVelocity = Vector3.zero
                    HRP.AssemblyLinearVelocity = Vector3.zero
                    if LastPosition then 
                        HRP.CFrame = LastPosition 
                    end
                    notify("FLING NEUTRALIZED")
                elseif HRP.AssemblyLinearVelocity.Magnitude < 50 then
                    LastPosition = HRP.CFrame
                end
            end))
        end

        StartAntiFling()
        notify("ANTI-FLING: ON")

        -- ฟังก์ชัน Cleanup สำหรับยกเลิกการเชื่อมต่อทั้งหมดเมื่อปิดโมดูล
        getgenv().KrizAntiFlingCleanup = function()
            for _, conn in pairs(antiFlingConnections) do
                pcall(function()
                    conn:Disconnect()
                end)
            end
            antiFlingConnections = {}
            notify("ANTI-FLING: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizAntiFlingActive = false
        if getgenv().KrizAntiFlingCleanup then
            pcall(getgenv().KrizAntiFlingCleanup)
        end
    end

})
