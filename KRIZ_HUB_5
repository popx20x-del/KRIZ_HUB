            if ScreenGui then ScreenGui:Destroy() end
            if depthButton then depthButton:Destroy() end
            if modeButton then modeButton:Destroy() end
            if speedBox then speedBox:Destroy() end
            notify("UNDERFOOT: OFF")
        end
