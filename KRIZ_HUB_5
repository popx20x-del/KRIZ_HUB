        LoopBtn.Text = "LOOP"
        LoopBtn.TextColor3 = Color3.new(1, 1, 1)
        LoopBtn.TextSize = 11

        local function GetTarget(Name)
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LP and (v.Name:lower():find(Name:lower()) or v.DisplayName:lower():find(Name:lower())) then
                    return v
                end
            end
            return nil
        end

        local function ExecuteFling(Target)
            if not Target or not Target.Character or not LP.Character then return end
            local Root = LP.Character:FindFirstChild("HumanoidRootPart")
            local TRoot = Target.Character:FindFirstChild("HumanoidRootPart")
            local Hum = LP.Character:FindFirstChildOfClass("Humanoid")
            local TargetHum = Target.Character:FindFirstChildOfClass("Humanoid")

            if Root and TRoot and Hum and TargetHum and TargetHum.Health > 0 and Hum.Health > 0 then
                local OldPos = Root.CFrame
                workspace.CurrentCamera.CameraSubject = TRoot

                for _, part in ipairs(LP.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.new(0, 0, 0)
                BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

                local StartTime = tick()
                while tick() - StartTime < 1.2 do
                    if not getgenv().KrizFlingActive then break end
                    if not TRoot or not Root or TargetHum.Health <= 0 or Hum.Health <= 0 then break end
                    Root.CFrame = TRoot.CFrame
                    Root.RotVelocity = Vector3.new(50000, 50000, 50000)
                    task.wait()
                end

                BV:Destroy()
                for _, part in ipairs(LP.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
                workspace.CurrentCamera.CameraSubject = Hum
                Root.CFrame = OldPos
                Root.Velocity = Vector3.new(0, 0, 0)
                Root.RotVelocity = Vector3.new(0, 0, 0)
            end
        end

        SingleBtn.MouseButton1Click:Connect(function()
            if TextBox.Text ~= "" then
                local target = GetTarget(TextBox.Text)
                if target then 
                    ExecuteFling(target) 
                else
                    notify("TARGET NOT FOUND")
                end
            end
        end)

        local isLooping = false
        LoopBtn.MouseButton1Click:Connect(function()
            isLooping = not isLooping
            getgenv().KrizHubLoopFlingConnection = isLooping
            if isLooping then
                LoopBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
                task.spawn(function()
                    while getgenv().KrizHubLoopFlingConnection and getgenv().KrizFlingActive do
                        if TextBox.Text ~= "" then
                            local target = GetTarget(TextBox.Text)
                            if target and target.Character then
                                ExecuteFling(target)
                            else
                                getgenv().KrizHubLoopFlingConnection = false
                                isLooping = false
                                LoopBtn.TextColor3 = Color3.new(1, 1, 1)
                                break
                            end
                        end
                        task.wait(0.5)
                    end
                    LoopBtn.TextColor3 = Color3.new(1, 1, 1)
                end)
            else
                LoopBtn.TextColor3 = Color3.new(1, 1, 1)
            end
        end)

        notify("FLING UI: OPEN")

        -- ฟังก์ชัน Cleanup สำหรับทำความสะอาดเมื่อปิดโมดูล
        getgenv().KrizFlingCleanup = function()
            getgenv().KrizHubLoopFlingConnection = false
            if ScreenGui then 
                ScreenGui:Destroy() 
            end
            notify("FLING UI: CLOSED")
        end
    end,

    OnDisable = function()
        getgenv().KrizFlingActive = false
        if getgenv().KrizFlingCleanup then
            pcall(getgenv().KrizFlingCleanup)
        end
    end

})


