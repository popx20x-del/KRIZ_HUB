--------------------------------------------------
-- MODULE: AIMBOT (ALL PLAYERS) / ล็อกเป้าทุกคน + ช่องปรับ FOV/ความหนืด + ปุ่มเลือกส่วน (หัว/ตัว/ขา) + ปุ่มสลับทะลุกำแพง
--------------------------------------------------

Core:RegisterModule({

    Name = "Aimbot (All) / ล็อกเป้าทุกคน",

    OnEnable = function()
        getgenv().KrizAimAllActive = false
        local aimActive = false

        local CoreGui = game:GetService("CoreGui")
        local UserInputService = game:GetService("UserInputService")
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local StarterGui = game:GetService("StarterGui")
        local LocalPlayer = Players.LocalPlayer
        local Camera = workspace.CurrentCamera

        local aimFOV = 50
        local aimSmooth = 5
        
        local targetParts = {"Head", "HumanoidRootPart", "LeftLowerLeg"}
        local targetPartNames = {"HEAD", "TORSO", "LEGS"}
        local currentPartIndex = 1

        local wallStates = {false, true}
        local wallStateNames = {"WALL: OFF", "WALL: ON"}
        local currentWallIndex = 1

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "KrizHubAimAllUI"
        ScreenGui.Parent = CoreGui
        ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        ScreenGui.DisplayOrder = 999999
        ScreenGui.Enabled = true

        local Button = Instance.new("TextButton")
        Button.Name = "MainButton"
        Button.Parent = ScreenGui
        Button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Button.BackgroundTransparency = 0.5
        Button.Position = UDim2.new(0.5, -35, 0.5, 10)
        Button.Size = UDim2.new(0, 70, 0, 30)
        Button.AutoButtonColor = false
        Button.Font = Enum.Font.GothamBold
        Button.Text = "ON"
        Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        Button.TextSize = 13

        local dragging, dragStart, startPos, activeInput, isMoved = false, Vector3.new(0,0,0), UDim2.new(0,0,0,0), nil, false
        Button.InputBegan:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and activeInput == nil then
                dragging = true; isMoved = false; activeInput = input; dragStart = input.Position; startPos = Button.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == activeInput then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then isMoved = true end
                Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        local function endDrag(input) if input == activeInput then dragging = false; activeInput = nil end end
        Button.InputEnded:Connect(endDrag)
        UserInputService.InputEnded:Connect(endDrag)

        local rowFrame = nil
        pcall(function()
            if _G.KrizHubCore and _G.KrizHubCore.ScrollContainer then
                rowFrame = _G.KrizHubCore.ScrollContainer:FindFirstChild("Function_Aimbot (All) / ล็อกเป้าทุกคน")
            end
        end)

        local fovBox, smoothBox, partButton, wallButton = nil, nil, nil, nil
        if rowFrame then
            -- ช่อง FOV (ซ้ายสุด)
            fovBox = Instance.new("TextBox")
            fovBox.Name = "FOVBox"
            fovBox.Parent = rowFrame
            fovBox.Size = UDim2.new(0, 38, 0, 20)
            fovBox.Position = UDim2.new(1, -216, 0.5, -10)
            fovBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            fovBox.BackgroundTransparency = 0.15
            fovBox.BorderSizePixel = 0
            fovBox.Font = Enum.Font.Gotham
            fovBox.Text = tostring(aimFOV)
            fovBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            fovBox.TextSize = 11
            fovBox.ClearTextOnFocus = false
            fovBox.ZIndex = 10003

            local oldFovText = tostring(aimFOV)
            fovBox.Focused:Connect(function() oldFovText = fovBox.Text; fovBox.Text = "" end)
            fovBox.FocusLost:Connect(function()
                local val = tonumber(fovBox.Text)
                if val and val > 0 then aimFOV = val; fovBox.Text = tostring(aimFOV) else fovBox.Text = oldFovText end
            end)

            -- ช่อง Smoothness (ถัดมา)
            smoothBox = Instance.new("TextBox")
            smoothBox.Name = "SmoothBox"
            smoothBox.Parent = rowFrame
            smoothBox.Size = UDim2.new(0, 38, 0, 20)
            smoothBox.Position = UDim2.new(1, -174, 0.5, -10)
            smoothBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            smoothBox.BackgroundTransparency = 0.15
            smoothBox.BorderSizePixel = 0
            smoothBox.Font = Enum.Font.Gotham
            smoothBox.Text = tostring(aimSmooth)
            smoothBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            smoothBox.TextSize = 11
            smoothBox.ClearTextOnFocus = false
            smoothBox.ZIndex = 10003

            local oldSmoothText = tostring(aimSmooth)
            smoothBox.Focused:Connect(function() oldSmoothText = smoothBox.Text; smoothBox.Text = "" end)
            smoothBox.FocusLost:Connect(function()
                local val = tonumber(smoothBox.Text)
                if val and val >= 1 then aimSmooth = val; smoothBox.Text = tostring(aimSmooth) else smoothBox.Text = oldSmoothText end
            end)

            -- ปุ่มเลือกส่วน (HEAD / TORSO / LEGS)
            partButton = Instance.new("TextButton")
            partButton.Name = "PartButton"
            partButton.Parent = rowFrame
            partButton.Size = UDim2.new(0, 38, 0, 20)
            partButton.Position = UDim2.new(1, -132, 0.5, -10)
            partButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            partButton.BackgroundTransparency = 0.15
            partButton.BorderSizePixel = 0
            partButton.Font = Enum.Font.GothamBold
            partButton.Text = targetPartNames[currentPartIndex]
            partButton.TextColor3 = Color3.fromRGB(255, 0, 0)
            partButton.TextSize = 9
            partButton.ZIndex = 10003

            partButton.MouseButton1Click:Connect(function()
                currentPartIndex = currentPartIndex + 1
                if currentPartIndex > #targetParts then
                    currentPartIndex = 1
                end
                partButton.Text = targetPartNames[currentPartIndex]
                notify("AIM PART: " .. targetPartNames[currentPartIndex])
            end)

            -- ปุ่มสลับทะลุกำแพง (ขวาสุด)
            wallButton = Instance.new("TextButton")
            wallButton.Name = "WallButton"
            wallButton.Parent = rowFrame
            wallButton.Size = UDim2.new(0, 38, 0, 20)
            wallButton.Position = UDim2.new(1, -90, 0.5, -10)
            wallButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            wallButton.BackgroundTransparency = 0.15
            wallButton.BorderSizePixel = 0
            wallButton.Font = Enum.Font.GothamBold
            wallButton.Text = wallStateNames[currentWallIndex] == "WALL: ON" and "W:ON" or "W:OFF"
            wallButton.TextColor3 = wallStates[currentWallIndex] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            wallButton.TextSize = 8
            wallButton.ZIndex = 10003

            wallButton.MouseButton1Click:Connect(function()
                currentWallIndex = currentWallIndex + 1
                if currentWallIndex > #wallStates then
                    currentWallIndex = 1
                end
                local isWallOn = wallStates[currentWallIndex]
                wallButton.Text = isWallOn and "W:ON" or "W:OFF"
                wallButton.TextColor3 = isWallOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
                notify("WALL CHECK: " .. wallStateNames[currentWallIndex])
            end)
        end

        local fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 1
        fovCircle.NumSides = 30
        fovCircle.Filled = false
        fovCircle.Visible = false
        fovCircle.Color = Color3.fromRGB(255, 0, 0)

        local function getTarget()
            local closest, dist = nil, aimFOV
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local selectedPartName = targetParts[currentPartIndex]
            local ignoreWall = wallStates[currentWallIndex]

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    local targetPart = p.Character:FindFirstChild(selectedPartName) or p.Character:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and targetPart then
                        local pos, vis = Camera:WorldToViewportPoint(targetPart.Position)
                        
                        local isValid = false
                        if ignoreWall then
                            isValid = vis
                        else
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, p.Character}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            local rayResult = workspace:Raycast(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position), rayParams)
                            isValid = vis and not rayResult
                        end

                        if isValid then
                            local d = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if d < dist then closest = targetPart; dist = d end
                        end
                    end
                end
            end
            return closest
        end

        local aimConn = RunService.RenderStepped:Connect(function(dt)
            if not fovCircle then return end
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Radius = aimFOV
            fovCircle.Visible = aimActive

            if aimActive then
                local target = getTarget()
                if target then
                    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
                    local smoothFactor = math.clamp(aimSmooth, 1, 20)
                    local alpha = 1 - math.pow(0.5, dt * (30 / smoothFactor))
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(alpha, 0.01, 1))
                end
            end
        end)

        Button.MouseButton1Click:Connect(function()
            if not isMoved then
                aimActive = not aimActive
                getgenv().KrizAimAllActive = aimActive
                if aimActive then
                    Button.TextColor3 = Color3.fromRGB(0, 255, 0)
                    notify("AIMBOT (ALL): ON")
                else
                    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    notify("AIMBOT (ALL): OFF")
                end
            end
        end)

        notify("AIMBOT (ALL) UI: OPEN")

        getgenv().KrizAimAllCleanup = function()
            aimActive = false
            getgenv().KrizAimAllActive = false
            if aimConn then aimConn:Disconnect() end
            if fovCircle then fovCircle:Remove() end
            if ScreenGui then ScreenGui:Destroy() end
            if fovBox then fovBox:Destroy() end
            if smoothBox then smoothBox:Destroy() end
            if partButton then partButton:Destroy() end
            if wallButton then wallButton:Destroy() end
            notify("AIMBOT (ALL): OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizAimAllActive = false
        if getgenv().KrizAimAllCleanup then
            pcall(getgenv().KrizAimAllCleanup)
        end
    end

})
