        local function SetupPlayer(p)
            if p == lp then return end

            local function OnCharacterAdded(char)
                if not getgenv().KrizTracerTopActive then return end
                RemoveTracer(p)

                local line = Drawing.new("Line")
                line.Visible = false
                line.Thickness = 1.5
                line.Transparency = 0.8
                tracers[p] = line
            end

            if p.Character and getgenv().KrizTracerTopActive then
                task.spawn(function()
                    OnCharacterAdded(p.Character)
                end)
            end

            local charAddedConn = p.CharacterAdded:Connect(OnCharacterAdded)
            playerConnections[p] = { CharAdded = charAddedConn }
        end

        local function CleanupPlayer(p)
            RemoveTracer(p)
            if playerConnections[p] then
                if playerConnections[p].CharAdded then
                    pcall(function() playerConnections[p].CharAdded:Disconnect() end)
                end
                playerConnections[p] = nil
            end
        end

        for _, p in pairs(Players:GetPlayers()) do
            SetupPlayer(p)
        end

        playerAddedConn = Players.PlayerAdded:Connect(SetupPlayer)
        playerRemovingConn = Players.PlayerRemoving:Connect(CleanupPlayer)

        updateConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizTracerTopActive then return end

            local viewportSize = Camera.ViewportSize
            -- จุดเริ่มต้นเส้น: กึ่งกลางขอบบนของจอ (X ครึ่งจอ, Y อยู่ที่ 0)
            local origin = Vector2.new(viewportSize.X / 2, 0)

            for p, line in pairs(tracers) do
                local c = p.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                local hum = c and c:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        line.From = origin
                        line.To = Vector2.new(screenPos.X, screenPos.Y)
                        line.Color = GetCol(p)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end)

        getgenv().KrizTracerTopCleanup = function()
            if updateConn then pcall(function() updateConn:Disconnect() end) updateConn = nil end
            if playerAddedConn then pcall(function() playerAddedConn:Disconnect() end) playerAddedConn = nil end
            if playerRemovingConn then pcall(function() playerRemovingConn:Disconnect() end) playerRemovingConn = nil end

            for _, p in ipairs(Players:GetPlayers()) do
                CleanupPlayer(p)
            end
            tracers = {}
            playerConnections = {}
        end
    end,

    OnDisable = function()
        getgenv().KrizTracerTopActive = false
        if getgenv().KrizTracerTopCleanup then
            pcall(getgenv().KrizTracerTopCleanup)
        end
    end

})



