                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, p.Character}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        local rayResult = workspace:Raycast(Camera.CFrame.Position, (hrp.Position - Camera.CFrame.Position), rayParams)
                        if vis and not rayResult then
                            local d = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if d < dist then closest = hrp; dist = d end
                        end
                    end
                end
            end
