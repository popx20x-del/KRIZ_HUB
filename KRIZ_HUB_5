task.spawn(function()
    -- [[ KRIZ HUB - xxx V21 CHAT COMMAND VERSION ]]
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local ME = Players.LocalPlayer

    local SIGNAL_ID = "rbxassetid://129423030" 
    local REFRESH_INTERVAL = 60 
    local lastPulse = tick()

    _G.SyncStates = _G.SyncStates or {} 
    _G.LastDetected = _G.LastDetected or {} 
    _G.ActivexxxModels = _G.ActivexxxModels or {}
    _G.SelfActivexxx = _G.SelfActivexxx or false
    _G.RemoteLastPulse = _G.RemoteLastPulse or {}

    local specialColor = Color3.fromRGB(211, 130, 175)
    local partsData = {
        P1 = {OffsetPos = Vector3.new(0.45, -1.2, 0.55), Scale = Vector3.new(2, 2, 2)},
        P2 = {OffsetPos = Vector3.new(-0.45, -1.2, 0.55), Scale = Vector3.new(2, 2, 2)},
        P3 = {OffsetPos = Vector3.new(0.15, -1.15, -0.4), Scale = Vector3.new(0.6, 0.9, 0.9)},
        P4 = {OffsetPos = Vector3.new(-0.15, -1.15, -0.4), Scale = Vector3.new(0.6, 0.9, 0.9)},
        P5 = {OffsetPos = Vector3.new(0, -1.2, -0.4), Scale = Vector3.new(0.1, 0.8, 0.9)},
        P6 = {OffsetPos = Vector3.new(0.4, 0.1, -0.65), Scale = Vector3.new(1.5, 1.5, 1.6)},
        P7 = {OffsetPos = Vector3.new(-0.4, 0.1, -0.65), Scale = Vector3.new(1.5, 1.5, 1.6)},
        P8 = {OffsetPos = Vector3.new(0.7, -0.1, -1.3), Scale = Vector3.new(0.4, 0.4, 0.5)},
        P9 = {OffsetPos = Vector3.new(-0.7, -0.1, -1.3), Scale = Vector3.new(0.4, 0.4, 0.5)}
    }

    -- === ฟังก์ชันจัดการโมเดล ===
    local function cleanModel(charName)
        local data = _G.ActivexxxModels[charName]
        local pChar = Players:FindFirstChild(charName) and Players[charName].Character
        if data then
            if data.model then data.model:Destroy() end
            if data.storage and pChar then
                for _, c in pairs(data.storage:GetChildren()) do c.Parent = pChar end
                data.storage:Destroy()
            end
        end
        if pChar then
            for _, n in pairs({"Left Leg", "Right Leg"}) do
                local limb = pChar:FindFirstChild(n)
                if limb then
                    local m = limb:FindFirstChildOfClass("SpecialMesh")
                    if m then m:Destroy() end
                    limb.Material = Enum.Material.Plastic
                end
            end
        end
        _G.ActivexxxModels[charName] = nil
    end

    function _G.BuildxxxBody(targetChar)
        if not targetChar or _G.ActivexxxModels[targetChar.Name] then return end
        local torso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart")
        if not torso then return end

        for _, n in pairs({"Left Leg", "Right Leg"}) do
            local limb = targetChar:FindFirstChild(n)
            if limb then
                local mesh = Instance.new("SpecialMesh", limb)
                mesh.Scale = Vector3.new(1.8, 1, 2)
                limb.Material = Enum.Material.SmoothPlastic
            end
        end

        local storage = Instance.new("Folder", workspace.CurrentCamera)
        storage.Name = "xxx_Storage_" .. targetChar.Name
        for _, i in pairs(targetChar:GetChildren()) do 
            if i:IsA("Shirt") or i:IsA("Pants") or i:IsA("ShirtGraphic") then i.Parent = storage end 
        end

        local ghostModel = Instance.new("Model", targetChar)
        local welds = {}
        local skin = (targetChar:FindFirstChildOfClass("BodyColors") and targetChar:FindFirstChildOfClass("BodyColors").HeadColor3) or Color3.fromRGB(163, 110, 84)
        
        for name, data in pairs(partsData) do
            local p = Instance.new("Part", ghostModel)
            p.Shape, p.Size, p.CanCollide, p.Massless = Enum.PartType.Ball, data.Scale, false, true
            p.Color = (name=="P5" or name=="P8" or name=="P9") and specialColor or skin
            p.Material = Enum.Material.SmoothPlastic
            local w = Instance.new("Weld", p)
            w.Part0, w.Part1 = torso, p
            w.C0 = CFrame.new(data.OffsetPos)
            welds[name] = {weld = w, origC0 = w.C0}
        end
        _G.ActivexxxModels[targetChar.Name] = {model = ghostModel, storage = storage, welds = welds, sY = 0, sV = 0}
    end

    -- === ระบบส่งสัญญาณ ===
    local function sendPulse()
        local hum = ME.Character and ME.Character:FindFirstChild("Humanoid")
        if hum then
            local anim = Instance.new("Animation"); anim.AnimationId = SIGNAL_ID
            local t = hum:LoadAnimation(anim); t.Priority = Enum.AnimationPriority.Action
            t:Play(); task.wait(0.2); t:Stop()
        end
    end

    -- === คำสั่งพิม xxx.. แทนปุ่มกด ===
    _G.ExternalCommands = _G.ExternalCommands or {}
    _G.ExternalCommands["xxx.."] = function()
        _G.SelfActivexxx = not _G.SelfActivexxx
        lastPulse = tick()
        sendPulse()
        if not _G.SelfActivexxx then 
            _G.SyncStates[ME.Name] = false
            cleanModel(ME.Name) 
        else
            _G.SyncStates[ME.Name] = true
            _G.BuildxxxBody(ME.Character)
        end
        return true
    end

    -- === Physics & Sync System ===
    RunService.RenderStepped:Connect(function()
        for name, data in pairs(_G.ActivexxxModels) do
            local char = Players:FindFirstChild(name) and Players[name].Character
            local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
            local hum = char and char:FindFirstChild("Humanoid")
            if torso and hum and data.welds then
                local t, speed = tick(), hum.MoveDirection.Magnitude
                local walkB = math.sin(t * 12) * 0.04 * speed
                local walkS = math.cos(t * 7) * 0.05 * speed
                local targetS = -torso.Velocity.Y * 0.015
                data.sV = (data.sV + (targetS - data.sY) * 0.1) * 0.75
                data.sY = data.sY + data.sV
                for pName, wD in pairs(data.welds) do
                    local m = (pName == "P8" or pName == "P9") and 1.5 or 1
                    wD.weld.C0 = wD.origC0 * CFrame.new(walkS * m, walkB + data.sY, 0) * CFrame.Angles(math.rad(data.sY * 10), 0, 0)
                end
            end
        end
    end)

    RunService.Heartbeat:Connect(function()
        -- Auto-Pulse ทุก 1 นาที
        if _G.SelfActivexxx and (tick() - lastPulse) > REFRESH_INTERVAL then
            lastPulse = tick(); sendPulse()
        end

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= ME then
                local hum = p.Character and p.Character:FindFirstChild("Humanoid")
                if hum then
                    local isPlayingNow = false
                    for _, t in pairs(hum:GetPlayingAnimationTracks()) do
                        if t.Animation.AnimationId == SIGNAL_ID then isPlayingNow = true break end
                    end
                    
                    if isPlayingNow and not _G.LastDetected[p.Name] then
                        local now = tick()
