local function setXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        -- เช็คว่าเป็นชิ้นส่วนที่เป็นกำแพง/พื้น (BasePart)
        -- ไม่ให้ไปโดน Humanoid (ตัวละคร) หรือ Effect อื่นๆ
        if obj:IsA("BasePart") and not obj:IsDescendantOf(workspace:FindFirstChildOfClass("Model")) then
