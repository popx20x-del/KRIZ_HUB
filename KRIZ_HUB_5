Core:RegisterModule({

    Name = "Fling / ระบบวาร์ปเตะ",

    OnEnable = function()
        getgenv().KrizFlingModuleActive = true

        local CoreGui = game:GetService("CoreGui")
        local Players = game:GetService("Players")
        local StarterGui = game:GetService("StarterGui")
        local LP = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        if CoreGui:FindFirstChild("MidnightFlingUI") then
            CoreGui.MidnightFlingUI:Destroy()
        end

        local ScreenGui = Instance.new("ScreenGui")
        local MainFrame = Instance.new("Frame")
        local TextBox = Instance.new("TextBox")
        local SingleBtn = Instance.new("TextButton")
        local LoopBtn = Instance.new("TextButton")

        ScreenGui.Name = "MidnightFlingUI"
        ScreenGui.Parent = CoreGui
        ScreenGui.ResetOnSpawn = false
        ScreenGui.Enabled = true

        MainFrame.Name = "MainFrame"
        MainFrame.Parent = ScreenGui
        MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        MainFrame.BackgroundTransparency = 0.5
        MainFrame.Position = UDim2.new(0.5, -90, 0.5, -50)
        MainFrame.Size = UDim2.new(0, 180, 0, 105)
        MainFrame.Active = true
        MainFrame.Draggable = true

        TextBox.Parent = MainFrame
        TextBox.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        TextBox.BackgroundTransparency = 0.8
        TextBox.Position = UDim2.new(0.08, 0, 0.15, 0)
        TextBox.Size = UDim2.new(0.84, 0, 0, 28)
        TextBox.Font = Enum.Font.Gotham
        TextBox.PlaceholderText = "ชี้เป้าหมาย"
        TextBox.PlaceholderColor3 = Color3.fromRGB(180, 180, 190)
        TextBox.Text = ""
        TextBox.TextColor3 = Color3.new(1, 1, 1)
        TextBox.TextSize = 12

        SingleBtn.Parent = MainFrame
        SingleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        SingleBtn.BackgroundTransparency = 0.8
        SingleBtn.Position = UDim2.new(0.08, 0, 0.58, 0)
        SingleBtn.Size = UDim2.new(0.4, 0, 0, 28)
        SingleBtn.Font = Enum.Font.GothamBold
        SingleBtn.Text = "FLING"
        SingleBtn.TextColor3 = Color3.new(1, 1, 1)
        SingleBtn.TextSize = 11

        LoopBtn.Parent = MainFrame
        LoopBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        LoopBtn.BackgroundTransparency = 0.8
        LoopBtn.Position = UDim2.new(0.52, 0, 0.58, 0)
        LoopBtn.Size = UDim2.new(0.4, 0, 0, 28)
        LoopBtn.Font = Enum.Font.GothamBold
        LoopBtn.Text = "LOOP"
        LoopBtn.TextColor3 = Color3.new(1, 1, 1)
        LoopBtn.TextSize = 11

        local function GetTarget(Name)
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LP and (v.Name:lower():find(Name:lower()) or v.DisplayName:lower():find(Name:lower())) then
                    return v
                end
            end
            return nil
        end

        local function ExecuteFling(Target)
            if not getgenv().KrizFlingModuleActive then return end
            if not Target or not Target.Character or not LP.Character then return end
            local Root = LP.Character:FindFirstChild("HumanoidRootPart")
            local TRoot = Target.Character:FindFirstChild("HumanoidRootPart")
            local Hum = LP.Character:FindFirstChildOfClass("Humanoid")
            local TargetHum = Target.Character:FindFirstChildOfClass("Humanoid")

            if Root and TRoot and Hum and TargetHum and TargetHum.Health > 0 and Hum.Health > 0 then
                local OldPos = Root.CFrame
                workspace.CurrentCamera.CameraSubject = TRoot

                for _, part in ipairs(LP.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.new(0, 0, 0)
                BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

                local StartTime = tick()
                while tick() - StartTime < 1.2 and getgenv().KrizFlingModuleActive do
                    if not TRoot or not Root or TargetHum.Health <= 0 or Hum.Health <= 0 then break end
                    Root.CFrame = TRoot.CFrame
                    Root.RotVelocity = Vector3.new(50000, 50000, 50000)
                    task.wait()
                end

                if BV then BV:Destroy() end

                if LP.Character then
                    for _, part in ipairs(LP.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = true end
                    end
                end

                workspace.CurrentCamera.CameraSubject = Hum
                if Root then
                    Root.CFrame = OldPos
                    Root.Velocity = Vector3.new(0, 0, 0)
                    Root.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end

        SingleBtn.MouseButton1Click:Connect(function()
            if TextBox.Text ~= "" then
                local target = GetTarget(TextBox.Text)
                if target then ExecuteFling(target) end
            end
        end)

        local isLooping = false
        local loopFlingActive = false

        LoopBtn.MouseButton1Click:Connect(function()
            isLooping = not isLooping
            loopFlingActive = isLooping

            if isLooping then
                LoopBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
                task.spawn(function()
                    while loopFlingActive and getgenv().KrizFlingModuleActive do
                        if TextBox.Text ~= "" then
                            local target = GetTarget(TextBox.Text)
                            if target and target.Character then
                                ExecuteFling(target)
                            else
                                loopFlingActive = false
                                isLooping = false
                                LoopBtn.TextColor3 = Color3.new(1, 1, 1)
                                break
                            end
                        end
                        task.wait(0.5)
                    end
                    LoopBtn.TextColor3 = Color3.new(1, 1, 1)
                end)
            else
                LoopBtn.TextColor3 = Color3.new(1, 1, 1)
            end
        end)

        notify("FLING UI: OPEN")

        getgenv().KrizFlingCleanup = function()
            loopFlingActive = false
            isLooping = false
            if ScreenGui then ScreenGui:Destroy() end
            notify("FLING: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizFlingModuleActive = false
        if getgenv().KrizFlingCleanup then
            pcall(getgenv().KrizFlingCleanup)
        end
    end

})


