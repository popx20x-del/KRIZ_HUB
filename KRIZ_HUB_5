

-- วาร์ปยิง --

task.spawn(function()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- [[ CONFIGURATION ]] --
local WARP_DISTANCE = 3.5
local returnPos = nil
local isWarping = false
local currentTarget = nil

-- [[ UI CONSTRUCTION ]] --
if game:GetService("CoreGui"):FindFirstChild("Kriz_Warp_Safe") then
    game:GetService("CoreGui").Kriz_Warp_Safe:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Kriz_Warp_Safe"
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 130, 0, 80) 
MainFrame.Position = UDim2.new(0.5, -65, 0.5, -40)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainFrame.BackgroundTransparency = 0.5 -- พื้นหลัง 50%
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true 
MainFrame.Parent = ScreenGui
MainFrame.Visible = false


local uiStroke = Instance.new("UIStroke")
uiStroke.Color = Color3.fromRGB(255, 0, 0) -- กรอบแดง
uiStroke.Thickness = 1.5
uiStroke.Parent = MainFrame

Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 5)

-- ช่องพิมพ์ชื่อ
local NameBox = Instance.new("TextBox")
NameBox.Size = UDim2.new(1, -16, 0, 28)
NameBox.Position = UDim2.new(0, 8, 0, 8)
NameBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
NameBox.BackgroundTransparency = 0.8 -- โปร่งใส 80%
NameBox.PlaceholderText = "ชื่อเป้าหมาย" -- ข้อความลางๆ
NameBox.PlaceholderColor3 = Color3.fromRGB(160, 160, 160)
NameBox.Text = ""
NameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
NameBox.TextSize = 14
NameBox.Font = Enum.Font.SourceSansBold
NameBox.Parent = MainFrame
Instance.new("UICorner", NameBox).CornerRadius = UDim.new(0, 4)

-- ปุ่มวาร์ปยิง
local WarpBtn = Instance.new("TextButton")
WarpBtn.Size = UDim2.new(1, -16, 0, 32)
WarpBtn.Position = UDim2.new(0, 8, 0, 40)
WarpBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
WarpBtn.BackgroundTransparency = 0.8 -- โปร่งใส 80%
WarpBtn.Text = "วาร์ปยิง" -- ชื่อเดียวตลอดกาล
WarpBtn.TextColor3 = Color3.fromRGB(255, 255, 255) -- เริ่มต้นสีขาว
WarpBtn.TextSize = 14
WarpBtn.Font = Enum.Font.SourceSansBold
WarpBtn.Parent = MainFrame
Instance.new("UICorner", WarpBtn).CornerRadius = UDim.new(0, 4)

-- [[ LOGIC SYSTEM ]] --

local function GetTarget()
    local targetText = NameBox.Text:lower()
    if targetText == "" then return nil end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p.Name:lower():find(targetText) or (p.DisplayName and p.DisplayName:lower():find(targetText)) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    return p.Character
                end
            end
        end
    end
    return nil
end

local function StopWarping()
    if isWarping then
        isWarping = false
        local char = LocalPlayer.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        local myHum = char and char:FindFirstChild("Humanoid")
        
        if returnPos and myHrp then
            myHrp.CFrame = returnPos
        end
        
        if myHum then
            myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end
        
        currentTarget = nil
        returnPos = nil
        WarpBtn.TextColor3 = Color3.fromRGB(255, 255, 255) -- กลับเป็นสีขาว
    end
end

WarpBtn.MouseButton1Click:Connect(function()
    if not isWarping then
        local target = GetTarget()
        local char = LocalPlayer.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        local myHum = char and char:FindFirstChild("Humanoid")
        
        if target and myHrp and myHum then
            returnPos = myHrp.CFrame
            currentTarget = target
            isWarping = true
            WarpBtn.TextColor3 = Color3.fromRGB(255, 50, 50) -- เปลี่ยนเป็นสีแดง
            
            myHum.Sit = false
            myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end
    else
        StopWarping()
    end
end)

RunService.Heartbeat:Connect(function()
    if isWarping then
        -- ตรวจสอบว่าเป้าหมายยังอยู่, ยังไม่ตาย, และยังอยู่ในเกม
        if currentTarget and currentTarget.Parent and currentTarget:FindFirstChild("Humanoid") and currentTarget.Humanoid.Health > 0 then
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local enemyHrp = currentTarget:FindFirstChild("HumanoidRootPart")
            local myHum = myChar and myChar:FindFirstChild("Humanoid")
            
            if myHrp and enemyHrp and myHum then
                if myHum.Sit then myHum.Sit = false end -- ระบบ Anti-Sit
                
                local backPos = enemyHrp.CFrame * CFrame.new(0, 0, WARP_DISTANCE)
                myHrp.CFrame = CFrame.new(backPos.Position, enemyHrp.Position)
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, enemyHrp.Position)
            end
        else
            StopWarping() -- หยุดอัตโนมัติถ้าเป้าหมายตายหรือออกเกม
        end
    end
end)

-- [[ สะพานเชื่อมต่อปุ่ม s2_1 ]] --

-- ตรวจสอบว่าปุ่ม s2_1 มีอยู่จริง
if s2_1 and (s2_1:IsA("TextButton") or s2_1:IsA("GuiButton")) then
    s2_1.MouseButton1Click:Connect(function()
        -- สลับค่าความมองเห็น (Toggle Visible)
        MainFrame.Visible = not MainFrame.Visible
        
        -- เปลี่ยนสีข้อความปุ่ม s2_1 เพื่อบอกสถานะการเปิด/ปิด
        if MainFrame.Visible then
            s2_1.TextColor3 = Color3.fromRGB(255, 0, 0) -- สีแดงเมื่อหน้าต่างวาร์ปเปิด
        else
            s2_1.TextColor3 = Color3.fromRGB(255, 255, 255) -- สีขาวเมื่อหน้าต่างวาร์ปปิด
        end
    end)
end



end)







