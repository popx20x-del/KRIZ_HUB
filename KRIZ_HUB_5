-- MODULE: INFINITE JUMP / ระบบกระโดดไม่จำกัด
--------------------------------------------------

Core:RegisterModule({

    Name = "Infinite Jump / กระโดดไม่จำกัด",

    OnEnable = function()
        getgenv().KrizInfJumpActive = true

        local UserInputService = game:GetService("UserInputService")
        local Players = game:GetService("Players")
        local StarterGui = game:GetService("StarterGui")
        local LP = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local infJumpConn = UserInputService.JumpRequest:Connect(function()
            if getgenv().KrizInfJumpActive and LP.Character then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)

        notify("INF JUMP: ON")

        getgenv().KrizInfJumpCleanup = function()
            if infJumpConn then infJumpConn:Disconnect() end
            notify("INF JUMP: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizInfJumpActive = false
        if getgenv().KrizInfJumpCleanup then
            pcall(getgenv().KrizInfJumpCleanup)
        end
    end

})


--------------------------------------------------
-- MODULE: HIGH JUMP / ระบบกระโดดสูง
--------------------------------------------------

Core:RegisterModule({

    Name = "High Jump / กระโดดสูง",

    OnEnable = function()
        getgenv().KrizHighJumpActive = true

        local Players = game:GetService("Players")
        local StarterGui = game:GetService("StarterGui")
        local LP = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local defaultJumpPower = 50
        local customJumpPower = 100 -- ค่าเริ่มต้น 100 ตามที่คุณต้องการ

        local function applyHighJump()
            if LP.Character then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    pcall(function() hum.UseJumpPower = true end)
                    hum.JumpPower = customJumpPower
                end
            end
        end

        applyHighJump()
        local charConn = LP.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            if getgenv().KrizHighJumpActive then
                applyHighJump()
            end
        end)

        notify("HIGH JUMP: 100")

        getgenv().KrizHighJumpCleanup = function()
            if charConn then charConn:Disconnect() end
            if LP.Character then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    pcall(function() hum.UseJumpPower = true end)
                    hum.JumpPower = defaultJumpPower
                end
            end
            notify("HIGH JUMP: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizHighJumpActive = false
        if getgenv().KrizHighJumpCleanup then
            pcall(getgenv().KrizHighJumpCleanup)
        end
    end

})
