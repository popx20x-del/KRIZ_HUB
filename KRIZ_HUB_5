	Dot.Name = "Dot";
	Dot.Size = UDim2.new(0, 16, 0, 16);
	Dot.Position = UDim2.new(0, 2, 0.5, -8);
	Dot.BackgroundColor3 = Color3.fromRGB(230, 50, 50);
	Dot.BorderSizePixel = 0;
	Dot.ZIndex = 10004;
	Dot.Parent = Toggle;
	instance.Dot = Dot;
	instance.Enabled = false;
	local function Enable()
		if instance.Enabled then
			return;
		end
		instance.Enabled = true;
		Dot.Position = UDim2.new(1, -18, 0.5, -8);
		Dot.BackgroundColor3 = Color3.fromRGB(50, 230, 50);
		Toggle.BackgroundColor3 = Color3.fromRGB(70, 70, 70);
		if (type(moduleData.OnEnable) == "function") then
			local success, err = pcall(moduleData.OnEnable);
			if not success then
				warn("[KRIZ HUB] " .. moduleName .. " OnEnable error: " .. tostring(err));
			end
		end
	end
	local function Disable()
		if not instance.Enabled then
			return;
		end
		instance.Enabled = false;
		Dot.Position = UDim2.new(0, 2, 0.5, -8);
		Dot.BackgroundColor3 = Color3.fromRGB(230, 50, 50);
		Toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 55);
		if (type(moduleData.OnDisable) == "function") then
			local success, err = pcall(moduleData.OnDisable);
			if not success then
				warn("[KRIZ HUB] " .. moduleName .. " OnDisable error: " .. tostring(err));
			end
		end
	end
	instance.Connection = Toggle.Activated:Connect(function()
		if instance.Enabled then
			Disable();
		else
			Enable();
		end
	end);
	table.insert(self.Connections, instance.Connection);
	self.Modules[moduleName] = instance;
	table.insert(self.ModuleInstances, instance);
	task.defer(UpdateCanvasSize);
	return instance;
end;
Core.UnregisterModule = function(self, moduleName)
	local instance = self.Modules[moduleName];
	if not instance then
		return false;
	end
	if instance.Enabled then
		instance.Enabled = false;
		if (instance.Data and (type(instance.Data.OnDisable) == "function")) then
			pcall(instance.Data.OnDisable);
		end
	end
	if instance.Connection then
		pcall(function()
			instance.Connection:Disconnect();
		end);
	end
	if instance.Row then
		instance.Row:Destroy();
	end
	for i, module in ipairs(self.ModuleInstances) do
		if (module == instance) then
			table.remove(self.ModuleInstances, i);
			break;
		end
	end
	self.Modules[moduleName] = nil;
	task.defer(UpdateCanvasSize);
	return true;
end;
UpdateCanvasSize();
Core.Destroy = function(self)
	for _, instance in ipairs(self.ModuleInstances) do
		if instance.Enabled then
			instance.Enabled = false;
			if (instance.Data and (type(instance.Data.OnDisable) == "function")) then
				pcall(instance.Data.OnDisable);
			end
		end
	end
	for _, connection in ipairs(self.Connections) do
		pcall(function()
			if (connection and connection.Connected) then
				connection:Disconnect();
			end
		end);
	end
	self.Connections = {};
	if self.ScreenGui then
		pcall(function()
			self.ScreenGui:Destroy();
		end);
	end
	self.Modules = {};
	self.ModuleInstances = {};
	self.ScreenGui = nil;
	self.MainMenu = nil;
	self.Icon = nil;
	self.ScrollContainer = nil;
	if (_G.KrizHubCore == self) then
		_G.KrizHubCore = nil;
	end
end;
print("[KRIZ HUB] Core UI loaded successfully.");

