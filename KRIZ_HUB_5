--------------------------------------------------
-- GHOST MULTI-TOUCH INDEPENDENT SYSTEM (FIXED)
--------------------------------------------------

local activeTouchInput = nil
local dragStartPosition = nil
local dragStartGuiPosition = nil
local totalDistanceMoved = 0

Core:Connect(
    IconBtn.InputBegan,
    function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
            if activeTouchInput == nil then
                activeTouchInput = input
                dragStartPosition = input.Position
                dragStartGuiPosition = IconBtn.Position
                totalDistanceMoved = 0
            end
        end
    end
)

Core:Connect(
    UserInputService.InputChanged,
    function(input)
        if activeTouchInput and input == activeTouchInput then
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStartPosition
                totalDistanceMoved = totalDistanceMoved + delta.Magnitude
                
                IconBtn.Position = UDim2.new(
                    dragStartGuiPosition.X.Scale,
                    dragStartGuiPosition.X.Offset + delta.X,
                    dragStartGuiPosition.Y.Scale,
                    dragStartGuiPosition.Y.Offset + delta.Y
                )
            end
        end
    end
)

Core:Connect(
    UserInputService.InputEnded,
    function(input)
        if activeTouchInput and input == activeTouchInput then
            if totalDistanceMoved < 12 then
                MainMenu.Visible = not MainMenu.Visible
            end
            activeTouchInput = nil
            dragStartPosition = nil
            totalDistanceMoved = 0
        end
    end
)

