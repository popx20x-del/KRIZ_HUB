-- ==========================================
-- ส่วนที่ 10 : DPad
-- ==========================================

local DPad = {}

DPad.Mode = "หมุน"

DPad.SelectedPart = "Neck"

DPad.MoveStep = 0.1
DPad.RotateStep = 5

function DPad.SetMode(mode)

	DPad.Mode = mode
end

function DPad.SetPart(part)

	DPad.SelectedPart = part
end

function DPad.Up(pose)

	if DPad.Mode == "ตำแหน่ง" then

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"Y",
			DPad.MoveStep
		)

	else

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"RX",
			-DPad.RotateStep
		)
	end
end

function DPad.Down(pose)

	if DPad.Mode == "ตำแหน่ง" then

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"Y",
			-DPad.MoveStep
		)

	else

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"RX",
			DPad.RotateStep
		)
	end
end

function DPad.Left(pose)

	if DPad.Mode == "ตำแหน่ง" then

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"X",
			-DPad.MoveStep
		)

	else

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"RY",
			-DPad.RotateStep
		)
	end
end

function DPad.Right(pose)

	if DPad.Mode == "ตำแหน่ง" then

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"X",
			DPad.MoveStep
		)

	else

		PoseEditor.Edit(
			pose,
			DPad.SelectedPart,
			"RY",
			DPad.RotateStep
		)
	end
end

