                            forceResetCharacter()
                            return
                        end
                        
                        local targetHRP = targetPlayer.Character.HumanoidRootPart
                        spinAngle = spinAngle + (spinSpeedValue * dt * 10)
                        
                        local currentDepth = depthValues[currentDepthIndex]
                        local mode = modeNames[currentModeIndex]
                        
                        if mode == "LIE" then
                            -- โหมดท่านอน มุดใต้เท้าตามความลึก พร้อมหมุนรอบตัว
                            local offsetPos = CFrame.new(math.cos(spinAngle) * 1.5, currentDepth, math.sin(spinAngle) * 1.5)
                            hrp.CFrame = targetHRP.CFrame * offsetPos * CFrame.Angles(math.rad(90), 0, 0)
                        else
                            -- โหมดท่ายืนตรง ชิดตัว จับไหล่ หันหน้าเข้าหาเป้าหมาย และหมุนรอบตัว
                            local offsetPos = CFrame.new(math.cos(spinAngle) * 2, 0, math.sin(spinAngle) * 2)
                            hrp.CFrame = CFrame.new(targetHRP.Position + offsetPos.Position, targetHRP.Position)
                        end
                        
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)
                    end)
                    notify("UNDERFOOT: ON")
                else
                    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    if activeConnection then activeConnection:Disconnect(); activeConnection = nil end
                    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
