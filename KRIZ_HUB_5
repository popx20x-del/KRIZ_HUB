Core:RegisterModule({

    Name = "Fling / ฟลิง",

    OnEnable = function()
        getgenv().KrizFlingActive = true

        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")
        local StarterGui = game:GetService("StarterGui")
        local LocalPlayer = Players.LocalPlayer

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local flingPower = 55000 
        local movel = 0.1

        local flingConnection = RunService.Heartbeat:Connect(function()
            if not getgenv().KrizFlingActive then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local oldVel = hrp.Velocity
                hrp.Velocity = oldVel * flingPower + Vector3.new(0, flingPower, 0)
                task.spawn(function()
                    RunService.RenderStepped:Wait()
                    if hrp and hrp.Parent then hrp.Velocity = oldVel end
                    RunService.Stepped:Wait()
                    if hrp and hrp.Parent then
