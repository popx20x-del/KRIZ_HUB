-- ==========================================
-- ส่วนที่ 1 : RigScanner
-- ==========================================

local RigScanner = {}

function RigScanner.Scan(character)

	local result = {
		R6 = false,
		RootJoint = nil,
		Motors = {}
	}

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		result.R6 =
			humanoid.RigType == Enum.HumanoidRigType.R6
	end

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("Motor6D") then

			result.Motors[obj.Name] = obj

			if obj.Name == "RootJoint" then
				result.RootJoint = obj
			end
		end
	end

	return result
end

-- ==========================================
-- ส่วนที่ 2 : PoseCapture
-- ==========================================

local PoseCapture = {}

function PoseCapture.Capture(character)

	local pose = {}

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("Motor6D") then

			local cf = obj.C0

			local rx, ry, rz =
				cf:ToOrientation()

			pose[obj.Name] = {

				X = tonumber(
					string.format("%.2f", cf.X)
				),

				Y = tonumber(
					string.format("%.2f", cf.Y)
				),

				Z = tonumber(
					string.format("%.2f", cf.Z)
				),

				RX = math.floor(
					math.deg(rx) + 0.5
				),

				RY = math.floor(
					math.deg(ry) + 0.5
				),

				RZ = math.floor(
					math.deg(rz) + 0.5
				)
			}
		end
	end

	return pose
end

-- ==========================================
-- ส่วนที่ 3 : PoseExporter
-- ==========================================

local PoseExporter = {}

function PoseExporter.Export(pose)

	local text = ""

	text = text .. "-- [[ POSE DATA ]]\n"
	text = text .. "local PoseTable = {\n"

	for joint, data in pairs(pose) do

		text = text ..
			string.format(

				'    ["%s"] = {X=%.2f, Y=%.2f, Z=%.2f, RX=%d, RY=%d, RZ=%d},\n',

				joint,

				data.X,
				data.Y,
				data.Z,

				data.RX,
				data.RY,
				data.RZ
			)
	end

	text = text .. "}"

	return text
end

function PoseExporter.Copy(pose)

	local text =
		PoseExporter.Export(pose)

	if setclipboard then
		setclipboard(text)
	end

	return text
end

-- ==========================================
-- ส่วนที่ 4 : UndoSystem
-- ==========================================

local UndoSystem = {}

UndoSystem.Stack = {}

function UndoSystem.Push(pose)

	local copy = {}

	for joint, data in pairs(pose) do

		copy[joint] = {

			X = data.X,
			Y = data.Y,
			Z = data.Z,

			RX = data.RX,
			RY = data.RY,
			RZ = data.RZ
		}
	end

	table.insert(
		UndoSystem.Stack,
		copy
	)

	if #UndoSystem.Stack > 50 then

		table.remove(
			UndoSystem.Stack,
			1
		)
	end
end

function UndoSystem.Pop()

	if #UndoSystem.Stack == 0 then
		return nil
	end

	return table.remove(
		UndoSystem.Stack
	)
end

-- ==========================================
-- ส่วนที่ 5 : SaveSlots
-- ==========================================

local SaveSlots = {}

SaveSlots.Slots = {

	[1] = nil,
	[2] = nil,
	[3] = nil
}

function SaveSlots.Save(slot, pose)

	local copy = {}

	for joint, data in pairs(pose) do

		copy[joint] = {

			X = data.X,
			Y = data.Y,
			Z = data.Z,

			RX = data.RX,
			RY = data.RY,
			RZ = data.RZ
		}
	end

	SaveSlots.Slots[slot] = copy
end

function SaveSlots.Load(slot)

	return SaveSlots.Slots[slot]
end

-- ==========================================
-- ส่วนที่ 6 : LockSystem
-- ==========================================

local LockSystem = {}

LockSystem.Locked = {}

function LockSystem.Lock(part)

	LockSystem.Locked[part] = true
end

function LockSystem.Unlock(part)

	LockSystem.Locked[part] = nil
end

function LockSystem.IsLocked(part)

	return LockSystem.Locked[part] == true
end

function LockSystem.UnlockAll()

	table.clear(
		LockSystem.Locked
	)
end

