                    speedBox.Text = oldText
                end
            end)
        end

        local function createFly(char)
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if not hrp then return end
            if hrp:FindFirstChild("KrizFly_Velocity") then hrp.KrizFly_Velocity:Destroy() end
            if hrp:FindFirstChild("KrizFly_Gyro") then hrp.KrizFly_Gyro:Destroy() end

            local bv = Instance.new("BodyVelocity", hrp)
            bv.Name = "KrizFly_Velocity"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.new(0, 0, 0)

            local bg = Instance.new("BodyGyro", hrp)
            bg.Name = "KrizFly_Gyro"
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 1000; bg.D = 50
            bg.CFrame = hrp.CFrame
        end

        -- รองรับการเกิดใหม่ (Respawn) โดยให้คงสถานะการบินต่ออัตโนมัติถ้าเปิดไว้อยู่
        local charAddedConn = LP.CharacterAdded:Connect(function(char)
            task.wait(0.5) -- รอให้ตัวละครโหลดเต็มที่
            if flyActive and getgenv().KrizFlyModuleActive then
                createFly(char)
            end
        end)

        if getgenv().KRIZ_NOCLIP_CONN then
            getgenv().KRIZ_NOCLIP_CONN:Disconnect()
        end

        local lastState = false
        local function setCollisions(state)
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then 
                        obj.CanCollide = state 
                    end
                end
            end)
        end

        -- รวมระบบทะลุทุกอย่างขั้นสุดยอดเข้ากับลูป Fly
        getgenv().KRIZ_NOCLIP_CONN = RunService.Stepped:Connect(function()
            if not getgenv().KrizFlyModuleActive then return end
            if flyActive and LP.Character then
                if lastState == false then
                    lastState = true
                    setCollisions(false)
                end
                
                -- ปิดการชนของชิ้นส่วนตัวละครทั้งหมด
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") then 
                        v.CanCollide = false 
                    end
                end
                
                -- ยิง Ray เช็คพื้นใต้เท้าเพื่อกันตกแมพ
                local root = LP.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local ray = Ray.new(root.Position, Vector3.new(0, -6, 0))
                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LP.Character})
                    if hit then 
                        hit.CanCollide = true 
                    end
                end
            else
                if lastState == true then
                    lastState = false
                    setCollisions(true)
                end
            end
        end)

        local flyConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizFlyModuleActive or not flyActive then return end
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local cam = workspace.CurrentCamera
            if hrp and hrp:FindFirstChild("KrizFly_Velocity") then
                hrp.KrizFly_Gyro.CFrame = cam.CFrame
                local direction = ControlModule:GetMoveVector()
                hrp.KrizFly_Velocity.Velocity = (cam.CFrame.RightVector * direction.X * flySpeed * 50) - (cam.CFrame.LookVector * direction.Z * flySpeed * 50)
            end
        end)

        local function toggleFly()
            flyActive = not flyActive
            if flyActive then
                Button.TextColor3 = Color3.fromRGB(0, 255, 0)
                if LP.Character then createFly(LP.Character) end
                notify("FLY & NOCLIP: ON")
            else
                Button.TextColor3 = Color3.fromRGB(255, 255, 255)
                if LP.Character then
                    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if hrp:FindFirstChild("KrizFly_Velocity") then hrp.KrizFly_Velocity:Destroy() end
                        if hrp:FindFirstChild("KrizFly_Gyro") then hrp.KrizFly_Gyro:Destroy() end
                    end
                end
                setCollisions(true)
                lastState = false
                notify("FLY & NOCLIP: OFF")
            end
            return flyActive
        end

        Button.MouseButton1Click:Connect(function()
            if not isMoved then
                toggleFly()
            end
        end)

        notify("FLY UI: OPEN")

        -- ฟังก์ชัน Cleanup ทำความสะอาดเมื่อปิดโมดูลผ่าน Core
        getgenv().KrizFlyCleanup = function()
            flyActive = false
            if charAddedConn then charAddedConn:Disconnect() end
            if getgenv().KRIZ_NOCLIP_CONN then
                getgenv().KRIZ_NOCLIP_CONN:Disconnect()
                getgenv().KRIZ_NOCLIP_CONN = nil
            end
            if flyConn then flyConn:Disconnect() end
            if ScreenGui then ScreenGui:Destroy() end
            if speedBox then speedBox:Destroy() end
            if LP.Character then
                local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if hrp:FindFirstChild("KrizFly_Velocity") then hrp.KrizFly_Velocity:Destroy() end
                    if hrp:FindFirstChild("KrizFly_Gyro") then hrp.KrizFly_Gyro:Destroy() end
                end
            end
            setCollisions(true)
            notify("FLY: OFF")
        end
    end,

    OnDisable = function()
        getgenv().KrizFlyModuleActive = false
        if getgenv().KrizFlyCleanup then
            pcall(getgenv().KrizFlyCleanup)
        end
    end

})




