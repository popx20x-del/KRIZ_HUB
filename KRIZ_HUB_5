                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        local function serverHopMaxPlayers()
            notify("HOPPING SERVER...")
            pcall(function()
                local success, result = pcall(function()
                    return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"))
                end)
                if success and result and result.data then
                    local bestServerId = nil
                    local highestPlaying = -1
                    for _, server in ipairs(result.data) do
                        if server.id ~= game.JobId and server.playing < (server.maxPlayers - 3) then
                            if server.playing > highestPlaying then
                                highestPlaying = server.playing
                                bestServerId = server.id
                            end
                        end
                    end
                    if bestServerId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServerId, LocalPlayer)
                        return
                    end
                end
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end

        -- ทำงานทันทีเมื่อกดเปิดโมดูล
        serverHopMaxPlayers()

