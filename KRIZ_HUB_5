	end
	if self.Modules[moduleName] then
		warn("[KRIZ HUB] Module already registered: " .. moduleName);
		return nil;
	end
	local instance = {};
	instance.Name = moduleName;
	instance.Data = moduleData;
	local Row = Instance.new("Frame");
