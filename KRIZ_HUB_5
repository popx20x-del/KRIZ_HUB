--------------------------------------------------
-- MODULE: HITBOX EXPANDER / ขยายฮิตบ็อกซ์ + ช่องปรับขนาด
--------------------------------------------------

Core:RegisterModule({

    Name = "Hitbox Expander / ขยายฮิตบ็อกซ์",

    OnEnable = function()
        getgenv().KrizHitboxActive = true

        local CoreGui = game:GetService("CoreGui")
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local StarterGui = game:GetService("StarterGui")
        local LocalPlayer = Players.LocalPlayer

        local hitboxSize = 5 -- ขนาดความกว้าง/ยาวของฮิตบ็อกซ์ที่ขยาย

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "KRIZ HUB",
                        Text = text,
                        Duration = 3,
                    })
                end)
            end)
        end

        -- ค้นหาแถว (Row) ของโมดูลนี้ใน MainMenu เพื่อแทรกช่องพิมพ์เข้าไปฝังข้างในแบบเนียนๆ
        local rowFrame = nil
        pcall(function()
            if _G.KrizHubCore and _G.KrizHubCore.ScrollContainer then
                rowFrame = _G.KrizHubCore.ScrollContainer:FindFirstChild("Function_Hitbox Expander / ขยายฮิตบ็อกซ์")
            end
        end)

        local hitboxBox = nil
        if rowFrame then
            hitboxBox = Instance.new("TextBox")
            hitboxBox.Name = "HitboxBox"
            hitboxBox.Parent = rowFrame
            -- ปรับขนาดให้กว้างเท่าปุ่ม Toggle (38px) และสูงเท่ากัน (20px) วางไว้เยื้องซ้ายพอดีเป๊ะ
            hitboxBox.Size = UDim2.new(0, 38, 0, 20)
            hitboxBox.Position = UDim2.new(1, -90, 0.5, -10)
            hitboxBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            hitboxBox.BackgroundTransparency = 0.15
            hitboxBox.BorderSizePixel = 0
            hitboxBox.Font = Enum.Font.Gotham
            hitboxBox.Text = tostring(hitboxSize)
            hitboxBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            hitboxBox.TextSize = 11
            hitboxBox.ClearTextOnFocus = false
            hitboxBox.ZIndex = 10003

            local oldText = tostring(hitboxSize)
            hitboxBox.Focused:Connect(function()
                oldText = hitboxBox.Text
                hitboxBox.Text = "" -- กดแล้วเคลียร์ตัวเลขให้อัตโนมัติทันที
            end)

            hitboxBox.FocusLost:Connect(function(enterPressed)
                local val = tonumber(hitboxBox.Text)
                if val and val > 0 then
                    hitboxSize = val
                    hitboxBox.Text = tostring(hitboxSize)
                else
                    -- ถ้าไม่ได้พิมพ์อะไรหรือพิมพ์ค่าผิด ให้กลับไปใช้ค่าเดิม
                    hitboxBox.Text = oldText
                end
            end)
        end

        local function expandHitbox(char)
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                hrp.Transparency = 0.7 -- ความโปร่งใสของฮิตบ็อกซ์
                hrp.CanCollide = false
            end
        end

        -- ลูปคอยขยายฮิตบ็อกซ์ของผู้เล่นอื่นตลอดเวลา
        local hitboxConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizHitboxActive then return end
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character then 
                    expandHitbox(v.Character) 
                end
            end
        end)

        notify("HITBOX: ON")

        -- ฟังก์ชัน Cleanup สำหรับคืนค่าฮิตบ็อกซ์กลับเป็นขนาดปกติเมื่อปิดโมดูล
        getgenv().KrizHitboxCleanup = function()
            if hitboxConn then 
                hitboxConn:Disconnect() 
            end
            if hitboxBox then 
                hitboxBox:Destroy() 
            end
            for _, v in pairs(Players:GetPlayers()) do
                pcall(function()
                    if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = v.Character.HumanoidRootPart
                        hrp.Size = Vector3.new(2, 2, 1) -- คืนค่าขนาดดั้งเดิมของ Roblox
                        hrp.Transparency = 1 -- ซ่อนฮิตบ็อกซ์กลับตามเดิม
                    end
                end)
            end
            notify("HITBOX: OFF")
        end
    end,

    OnDisable = function()
