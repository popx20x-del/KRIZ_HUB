        mainFrame.Name = "ControlPanel"
        mainFrame.Size = UDim2.new(0, 220, 0, 118)
        mainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
        mainFrame.BackgroundColor3 = Color3.new(0, 0, 0)
        mainFrame.BackgroundTransparency = 0.5
        mainFrame.BorderSizePixel = 0
        mainFrame.Active = true
        mainFrame.Draggable = true
        mainFrame.Parent = screenGui

        -- ปุ่มเปลี่ยนความเร็ว
        local speedButton = Instance.new("TextButton")
        speedButton.Size = UDim2.new(1, -12, 0, 30)
        speedButton.Position = UDim2.new(0, 6, 0, 6)
        speedButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        speedButton.BackgroundTransparency = 0.3
        speedButton.BorderSizePixel = 0
        speedButton.TextColor3 = Color3.new(1, 1, 1)
        speedButton.TextSize = 14
        speedButton.Font = Enum.Font.SourceSansBold
        speedButton.Text = "Speed: " .. speeds[currentSpeedIndex]
        speedButton.Parent = mainFrame

        speedButton.MouseButton1Click:Connect(function()
            currentSpeedIndex = currentSpeedIndex % #speeds + 1
            speedButton.Text = "Speed: " .. speeds[currentSpeedIndex]
        end)

        -- ฟังก์ชันสร้างปุ่มทิศทางสมดุล
        local function CreateDirButton(name, text, posX, posY, sizeX, sizeY, inputKey)
            local btn = Instance.new("TextButton")
            btn.Name = name
            btn.Size = UDim2.new(0, sizeX, 0, sizeY)
            btn.Position = UDim2.new(0, posX, 0, posY)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            btn.BackgroundTransparency = 0.4
            btn.BorderSizePixel = 0
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.TextSize = 15
            btn.Font = Enum.Font.SourceSansBold
            btn.Text = text
            btn.Parent = mainFrame

            local function SetInput(state)
                moveInputs[inputKey] = state
                if inputKey == "Up" or inputKey == "Down" then
                    if state then
                        isHoldingVertical = true
                    else
                        local _, veh = GetTargetVehicle()
                        local root = veh and (veh:IsA("Model") and veh.PrimaryPart or veh)
                        if root then
                            heldYPosition = root.Position.Y
                        end
                        isHoldingVertical = false
                    end
                end
            end

            btn.MouseButton1Down:Connect(function() SetInput(true) end)
            btn.MouseButton1Up:Connect(function() SetInput(false) end)
            btn.MouseLeave:Connect(function() SetInput(false) end)
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then SetInput(true) end
            end)
            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then SetInput(false) end
            end)
            return btn
        end

        -- Layout D-Pad (Row 1: UP, ^, DOWN | Row 2: <, v, >)
        CreateDirButton("BtnUp", "UP", 6, 42, 65, 33, "Up")
        CreateDirButton("BtnForward", "^", 77, 42, 65, 33, "Forward")
        CreateDirButton("BtnDown", "DOWN", 148, 42, 65, 33, "Down")

        CreateDirButton("BtnLeft", "<", 6, 79, 65, 33, "Left")
        CreateDirButton("BtnBackward", "v", 77, 79, 65, 33, "Backward")
        CreateDirButton("BtnRight", ">", 148, 79, 65, 33, "Right")

        -- Parent UI เข้า CoreGui หรือ PlayerGui
        pcall(function()
            screenGui.Parent = lp:WaitForChild("PlayerGui")
        end)
        if not screenGui.Parent then
            pcall(function()
                screenGui.Parent = game:GetService("CoreGui")
            end)
        end
        activeGui = screenGui

        local lastActiveVehicle = nil

        -- Physics & Control Loop หลัก
        local lastTick = tick()
        renderConn = RunService.RenderStepped:Connect(function()
            if not getgenv().KrizVehicleFlightActive then return end

            local dt = tick() - lastTick
            lastTick = tick()

            local seat, vehicle = GetTargetVehicle()
            if not vehicle then
                lastActiveVehicle = nil
                heldYPosition = nil
                return
            end

            -- เซ็ต PrimaryPart อัตโนมัติถ้ายังไม่มี
            if vehicle:IsA("Model") and not vehicle.PrimaryPart then
                local root = vehicle:FindFirstChild("HumanoidRootPart") or vehicle:FindFirstChild("Body") or seat
                if root and root:IsA("BasePart") then
                    vehicle.PrimaryPart = root
                end
            end

            local rootPart = vehicle:IsA("Model") and vehicle.PrimaryPart or vehicle
            if not rootPart then return end

            if lastActiveVehicle ~= vehicle then
                lastActiveVehicle = vehicle
                heldYPosition = rootPart.Position.Y
            end

            if not heldYPosition then
                heldYPosition = rootPart.Position.Y
            end

            local currentSpeed = speeds[currentSpeedIndex]
            local verticalSpeed = currentSpeed / 2

            -- ดึงทิศทางกล้อง/ตัวละครผู้เล่นมาอ้างอิงแทนแกนโลก เพื่อให้เดินหน้าถอยหลังตามหน้าตัวละคร
            local cam = Workspace.CurrentCamera
            local camCF = cam and cam.CFrame or CFrame.new()
            local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if lookFlat.Magnitude > 0 then
                lookFlat = lookFlat.Unit
            else
                lookFlat = Vector3.new(0, 0, -1)
            end
            local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            if rightFlat.Magnitude > 0 then
                rightFlat = rightFlat.Unit
            else
                rightFlat = Vector3.new(1, 0, 0)
            end

            local moveDir = Vector3.zero
            if moveInputs.Forward then moveDir = moveDir + lookFlat end
            if moveInputs.Backward then moveDir = moveDir - lookFlat end
            if moveInputs.Left then moveDir = moveDir - rightFlat end
            if moveInputs.Right then moveDir = moveDir + rightFlat end
            
            if moveInputs.Up then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if moveInputs.Down then moveDir = moveDir - Vector3.new(0, 1, 0) end

            pcall(function()
                local currentPos = rootPart.Position
                local targetVelocity = Vector3.zero

                if moveDir.Magnitude > 0 then
                    local horizontalMove = Vector3.new(moveDir.X, 0, moveDir.Z)
                    if horizontalMove.Magnitude > 0 then
                        horizontalMove = horizontalMove.Unit
                    end
                    local verticalMove = Vector3.new(0, moveDir.Y, 0)
                    
                    if moveInputs.Up or moveInputs.Down then
                        targetVelocity = (horizontalMove * currentSpeed) + (verticalMove * verticalSpeed)
                        heldYPosition = currentPos.Y
                    else
                        targetVelocity = horizontalMove * currentSpeed
                    end

                    -- ปรับแต่งการตั้งค่า Velocity และแก้ปัญหาอาการสั่น (Jitter) ตอนเสียดสีกับวัตถุอื่น
                    rootPart.AssemblyLinearVelocity = targetVelocity
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    local fixedY = (moveInputs.Up or moveInputs.Down) and currentPos.Y or heldYPosition
                    local newPos = Vector3.new(currentPos.X, fixedY, currentPos.Z)

                    if vehicle:IsA("Model") then
                        vehicle:SetPrimaryPartCFrame(CFrame.new(newPos))
                    else
                        rootPart.CFrame = CFrame.new(newPos)
                    end
                else
                    -- ล็อกความเร็วและตำแหน่งให้สนิทเพื่อแก้ปัญหาวัตถุสั่นเวลาอยู่ใกล้หรือออกห่างวัตถุอื่น
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    local fixedY = heldYPosition
                    local newPos = Vector3.new(currentPos.X, fixedY, currentPos.Z)

                    if vehicle:IsA("Model") then
                        vehicle:SetPrimaryPartCFrame(CFrame.new(newPos))
                    else
                        rootPart.CFrame = CFrame.new(newPos)
                    end
                end
            end)
        end)

        -- ฟังก์ชัน Cleanup ทำความสะอาดเมื่อปิด Module
        getgenv().KrizVehicleFlightCleanup = function()
            getgenv().KrizVehicleFlightActive = false

            if renderConn then
                pcall(function() renderConn:Disconnect() end)
                renderConn = nil
            end
            if charRespawnConn then
                pcall(function() charRespawnConn:Disconnect() end)
                charRespawnConn = nil
            end
            if seatChangedConn then
                pcall(function() seatChangedConn:Disconnect() end)
                seatChangedConn = nil
            end
            if activeGui then
                pcall(function() activeGui:Destroy() end)
                activeGui = nil
            end
            heldYPosition = nil
        end
    end,

    OnDisable = function()
        getgenv().KrizVehicleFlightActive = false
        if getgenv().KrizVehicleFlightCleanup then
            pcall(getgenv().KrizVehicleFlightCleanup)
        end
    end

})
