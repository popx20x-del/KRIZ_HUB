task.spawn(function()

local P, lp, cam, RS = game:GetService("Players"), game:GetService("Players").LocalPlayer, workspace.CurrentCamera, game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local target = (game:GetService("CoreGui"):FindFirstChild("RobloxGui") and game:GetService("CoreGui")) or lp:WaitForChild("PlayerGui")
if target:FindFirstChild("K") then target.K:Destroy() end

_G.ExternalCommands = _G.ExternalCommands or {}

local KrizGhostBox = {}
local KrizLastPosition = {}
local idx, lastT = 1, "KRIZ HUB"

local function RegisterPlayer(v)
    if v == lp or KrizGhostBox[v] then return end
    local p = Instance.new("Part")
    p.Size = Vector3.new(1, 1, 1); p.Transparency = 1; p.CanCollide = false; p.Anchored = true
    p.Name = "KrizTrack_" .. v.Name; p.Parent = workspace
    KrizGhostBox[v] = p; KrizLastPosition[v] = Vector3.new(0, 100, 0)
end

for _, v in ipairs(P:GetPlayers()) do RegisterPlayer(v) end
P.PlayerAdded:Connect(RegisterPlayer)
P.PlayerRemoving:Connect(function(v)
    if KrizGhostBox[v] then KrizGhostBox[v]:Destroy(); KrizGhostBox[v] = nil end
    KrizLastPosition[v] = nil
end)

local sg = Instance.new("ScreenGui", target)
sg.Name = "K"

local f = Instance.new("Frame", sg)
f.Size = UDim2.new(0,260,0,40)
f.Position = UDim2.new(0.5,-130,0,5)
f.BackgroundColor3 = Color3.new(0,0,0)
f.BackgroundTransparency = 0.5
f.BorderSizePixel = 0
f.Active = true

-- Mobile Drag System
local dragging = false
local dragInput
local dragStart
local startPos

f.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragInput = input
        dragStart = input.Position
        startPos = f.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local delta = input.Position - dragStart

    f.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end)

local function btn(t, p, s)
    local b = Instance.new("TextButton", f)
    b.Text = t
    b.Size = UDim2.new(0,s,1,0)
    b.Position = p
    b.BackgroundTransparency = 1
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 20
    return b
end

local l, r = btn("<", UDim2.new(0,0,0,0), 40), btn(">", UDim2.new(1,-40,0,0), 40)

local i = Instance.new("TextBox", f)
i.Size = UDim2.new(1,-85,0.8,0)
i.Position = UDim2.new(0.5,0,0.5,0)
i.AnchorPoint = Vector2.new(0.5,0.5)
i.BackgroundTransparency = 1
i.TextColor3 = Color3.new(1,1,1)
i.Text = "KRIZ HUB"
i.ClearTextOnFocus = true

local function updateView()
    local pl = P:GetPlayers()
    idx = (idx > #pl and 1) or (idx < 1 and #pl) or idx
    local t = pl[idx]
    if t then
        lastT = t.Name
        i.Text = t.Name
    end
end

RS.RenderStepped:Connect(function()
    for _, v in ipairs(P:GetPlayers()) do
        if v ~= lp and v.Character then
            local root = v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Head")
            if root then KrizLastPosition[v] = root.Position end
        end
    end

    local t = P:GetPlayers()[idx]

    if t == lp or not t then
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            cam.CameraSubject = lp.Character.Humanoid
            cam.CameraType = Enum.CameraType.Custom
            lp.ReplicationFocus = nil
        end
    elseif KrizGhostBox[t] then
        local myBox = KrizGhostBox[t]
        local savedPos = KrizLastPosition[t]

        if savedPos then
            myBox.Position = savedPos + Vector3.new(0, 3, 0)
        end

        cam.CameraSubject = myBox
        lp.ReplicationFocus = t.Character or myBox
    end
end)

l.Activated:Connect(function() idx -= 1 updateView() end)
r.Activated:Connect(function() idx += 1 updateView() end)

i.FocusLost:Connect(function(enter)
    if not enter or i.Text == "" then i.Text = lastT return end
    local raw_text = i.Text:lower()

    for cmd_key, func in pairs(_G.ExternalCommands) do
        if raw_text:find("^" .. cmd_key) and raw_text:find("%.%.$") then
            local ok, msg = func(raw_text)
            if ok then i.Text = tostring(msg); task.delay(1, function() i.Text = lastT end); return end

        elseif raw_text:find("^" .. cmd_key .. "/[^/]") or raw_text:find("^" .. cmd_key .. "//") then
            local isDouble = raw_text:find("//") ~= nil
            local target_input = raw_text:sub(#cmd_key + (isDouble and 2 or 1) + 1)

            if target_input ~= "" then
                for _, p in pairs(P:GetPlayers()) do
                    if p.Name:lower():sub(1, #target_input) == target_input or p.DisplayName:lower():sub(1, #target_input) == target_input then
                        local ok, msg = func({Target = p, Double = isDouble, Mode = "remote"})
                        if ok then i.Text = tostring(msg); task.delay(1, function() i.Text = lastT end); return end
                    end
                end
            end
        end
    end

    local t, isWarp = i.Text:lower(), false
    if t:sub(-1) == "." then t = t:sub(1,-2); isWarp = true end

    for n, p in ipairs(P:GetPlayers()) do
        if p.Name:lower():sub(1,#t) == t or p.DisplayName:lower():sub(1,#t) == t then
            idx = n
            updateView()

            if isWarp and p.Character and lp.Character then
                lp.Character:SetPrimaryPartCFrame(
                    p.Character.HumanoidRootPart.CFrame * CFrame.new(0,3,0)
                )

                idx = table.find(P:GetPlayers(), lp) or 1
                updateView()
            end

            return
        end
    end

    i.Text = lastT
end)

end)

task.spawn(function()
-- [[ 1. เชื่อมต่อกระดานกลาง ]]
_G.ExternalCommands = _G.ExternalCommands or {}
_G.espActive = _G.espActive or false 

local P = game:GetService("Players")
local lp = P.LocalPlayer
local RS = game:GetService("RunService")
local cam = workspace.CurrentCamera

-- [[ 2. ฟังก์ชันเสริมเช็คสี ]]
local function GetCol(p)
    local c, b = p.Character, p:FindFirstChild("Backpack")
    if c then
        if c:FindFirstChild("Knife") or (b and b:FindFirstChild("Knife")) then return Color3.new(1,0,0) end
        if c:FindFirstChild("Gun") or (b and b:FindFirstChild("Gun")) then return Color3.new(0,0,1) end
    end
    return (p.Team and p.Team ~= lp.Team) and p.TeamColor.Color or Color3.new(1,1,1)
end

-- [[ 3. ระบบสร้าง ESP (Drawing API) ]]
local function CreateESP(p)
    if p == lp then return end
    
    local d = {
        T=Drawing.new("Line"), B=Drawing.new("Line"), L=Drawing.new("Line"), R=Drawing.new("Line"), 
        H=Drawing.new("Line"), N=Drawing.new("Text"), D=Drawing.new("Text")
    }
    
        for _, v in pairs(d) do 
        v.Visible = false 
        if v.Center ~= nil then -- ส่วนของ Text
            v.Center = true
            v.Outline = true 
            v.OutlineColor = Color3.new(0,0,0)
            v.Transparency = 1 
            
            -- [[ ตรงนี้ครับ เปลี่ยนจาก 2 เป็น 0 ]]
            v.Font = 0  -- 0 คือฟอนต์ System ปกติธรรมดาที่สุด
            
            v.Size = 13 
        end 
    end

    local conn
    conn = RS.RenderStepped:Connect(function()
        local c = p.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        
        if _G.espActive and hrp and hum and hum.Health > 0 then
            local pos, vis = cam:WorldToViewportPoint(hrp.Position)
            if vis then
                local dist = (hrp.Position - cam.CFrame.Position).Magnitude
                local head = cam:WorldToViewportPoint(c.Head.Position + Vector3.new(0,0.5,0))
                local leg = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                
                local h = math.abs(head.Y - leg.Y)
                local w = h / 1.5
                local clr = GetCol(p)
                local thk = math.clamp(1.2 * (40/dist), 0.5, 1.2)
                local trans = math.clamp(70/dist, 0.4, 0.9)

                -- วาดกรอบ Box (ลดความหนาเส้นลงด้วย)
                d.T.From, d.T.To = Vector2.new(pos.X-w/2, pos.Y-h/2), Vector2.new(pos.X+w/2, pos.Y-h/2)
                d.B.From, d.B.To = Vector2.new(pos.X-w/2, pos.Y+h/2), Vector2.new(pos.X+w/2, pos.Y+h/2)
                d.L.From, d.L.To = Vector2.new(pos.X-w/2, pos.Y-h/2), Vector2.new(pos.X-w/2, pos.Y+h/2)
                d.R.From, d.R.To = Vector2.new(pos.X+w/2, pos.Y-h/2), Vector2.new(pos.X+w/2, pos.Y+h/2)
                
                for _, l in pairs({d.T, d.B, d.L, d.R}) do 
                    l.Thickness, l.Transparency, l.Color, l.Visible = thk, trans, clr, true 
                end

                -- หลอดเลือดแบบ Minimal
                local hThk, barX = math.clamp(3 * (40/dist), 1.5, 2.5), pos.X-w/2-5
                d.H.From, d.H.To = Vector2.new(barX, pos.Y+h/2), Vector2.new(barX, pos.Y+h/2-(h*(hum.Health/hum.MaxHealth)))
                d.H.Thickness, d.H.Color, d.H.Transparency, d.H.Visible = hThk, Color3.fromHSV(hum.Health/hum.MaxHealth*0.3, 1, 1), trans, true

                -- ชื่อและระยะทาง (ขอบจางพิเศษ)
                d.N.Position, d.N.Text, d.N.Color, d.N.Visible = Vector2.new(pos.X, pos.Y-h/2-16), p.Name, clr, true
                d.D.Position, d.D.Text, d.D.Color, d.D.Visible = Vector2.new(pos.X, pos.Y+h/2+2), math.floor(dist).."m", Color3.new(1,1,1), true
            else 
                for _, v in pairs(d) do v.Visible = false end 
            end
        else
            for _, v in pairs(d) do v.Visible = false end
            if not p.Parent then 
                for _, v in pairs(d) do v:Remove() end 
                conn:Disconnect() 
            end
        end
    end)
end

for _, p in pairs(P:GetPlayers()) do CreateESP(p) end
P.PlayerAdded:Connect(CreateESP)

-- [[ 4. ลงทะเบียนคำสั่ง ]]
_G.ExternalCommands["esp.."] = function()
    _G.espActive = not _G.espActive
    return true, (_G.espActive and "ESP: ON" or "ESP: OFF")
end
end)


task.spawn(function()
-- [[ 1. เชื่อมต่อกระดานกลาง ]]
_G.ExternalCommands = _G.ExternalCommands or {}
_G.noclipActive = _G.noclipActive or false

local LP = game:GetService("Players").LocalPlayer
local RS = game:GetService("RunService")
local lastState = false

-- [[ 2. ฟังก์ชันควบคุมแรงชนของโลก (Original Logic) ]]
local function setCollisions(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        -- คืนค่า CanCollide เฉพาะ BasePart
        if obj:IsA("BasePart") then 
            obj.CanCollide = state 
        end
    end
end

-- [[ 3. ลูปประมวลผล Noclip (Stepped) ]]
task.spawn(function()
    RS.Stepped:Connect(function()
        -- ใช้ตัวแปรกลาง _G.noclipActive เป็นสวิตช์
        if _G.noclipActive and LP.Character then
            
            -- จังหวะเปิดครั้งแรก: สั่งปิดแรงชนทั้งโลก
            if lastState == false then
                lastState = true
                setCollisions(false)
            end

            -- บังคับปิดแรงชนที่ตัวละครตลอดเวลา (กันเกมรีเซ็ต)
            for _, v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            
            -- ระบบเท้าติดพื้น (Smart Floor): ป้องกันการร่วงทะลุโลก
            local root = LP.Character:FindFirstChild("HumanoidRootPart")
            if root then
                -- ยิง Ray ลงไป 6 หน่วยเพื่อหาพื้น
                local ray = Ray.new(root.Position, Vector3.new(0, -6, 0))
                local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LP.Character})
                -- ถ้าเจอพื้น ให้พื้นนั้นกลับมามีแรงชนชั่วคราวเพื่อให้เรายืนได้
                if hit then hit.CanCollide = true end
            end
            
        else
            -- จังหวะปิด: คืนค่าแรงชนให้โลกกลับมาปกติ
            if lastState == true then
                lastState = false
                setCollisions(true)
            end
        end
    end)
end)

