function Core:RegisterModule(moduleData)

    if type(moduleData) ~= "table" then
        warn("[KRIZ HUB] Invalid module data")
        return nil
    end

    local moduleName = moduleData.Name

    if type(moduleName) ~= "string" then
        warn("[KRIZ HUB] Module has no valid Name")
        return nil
    end

    --------------------------------------------------
    -- DUPLICATE CHECK
    --------------------------------------------------

    if self.Modules[moduleName] then

        warn(
            "[KRIZ HUB] Module already registered: "
            .. moduleName
        )

        return nil

    end

    --------------------------------------------------
    -- MODULE DATA
    --------------------------------------------------

    local instance = {}

    instance.Name = moduleName
    instance.Data = moduleData

    --------------------------------------------------
    -- ROW
    --------------------------------------------------

    local Row = Instance.new("Frame")

    Row.Name = "Function_" .. moduleName

    Row.Size = UDim2.new(1, 0, 0, 40)

    Row.BackgroundColor3 =
        Color3.fromRGB(20, 20, 20)

    Row.BackgroundTransparency = 0.35

    Row.BorderSizePixel = 0

    Row.ZIndex = 10002

    Row.Parent = ScrollContainer

    instance.Row = Row

    --------------------------------------------------
    -- NAME
    --------------------------------------------------

    local NameLabel = Instance.new("TextLabel")

    NameLabel.Name = "Name"

    NameLabel.Size =
        UDim2.new(1, -60, 1, 0)

    NameLabel.Position =
        UDim2.new(0, 10, 0, 0)

    NameLabel.BackgroundTransparency = 1

    NameLabel.Text = moduleName

    NameLabel.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    NameLabel.TextSize = 14

    NameLabel.Font = Enum.Font.Gotham

    NameLabel.TextXAlignment =
        Enum.TextXAlignment.Left

    NameLabel.TextYAlignment =
        Enum.TextYAlignment.Center

    NameLabel.ZIndex = 10003

    NameLabel.Parent = Row

    instance.NameLabel = NameLabel

    --------------------------------------------------
    -- TOGGLE
    --------------------------------------------------

    local Toggle = Instance.new("TextButton")

    Toggle.Name = "Toggle"

    Toggle.Size =
        UDim2.new(0, 38, 0, 20)

    Toggle.Position =
        UDim2.new(1, -48, 0.5, -10)

    Toggle.BackgroundColor3 =
        Color3.fromRGB(55, 55, 55)

    Toggle.BackgroundTransparency = 0.15

    Toggle.BorderSizePixel = 0

    Toggle.Text = ""

    Toggle.AutoButtonColor = false

    Toggle.ZIndex = 10003

    Toggle.Parent = Row

    instance.Toggle = Toggle

    --------------------------------------------------
    -- TOGGLE DOT
    --------------------------------------------------

    local Dot = Instance.new("Frame")

    Dot.Name = "Dot"

    Dot.Size =
        UDim2.new(0, 16, 0, 16)

    Dot.Position =
        UDim2.new(0, 2, 0.5, -8)

    -- ตั้งค่าเริ่มต้น (ปิด) ให้จุดข้างในเป็นสีแดง
    Dot.BackgroundColor3 =
        Color3.fromRGB(230, 50, 50)

    Dot.BorderSizePixel = 0

    Dot.ZIndex = 10004

    Dot.Parent = Toggle

    instance.Dot = Dot

    --------------------------------------------------
    -- STATE
    --------------------------------------------------

    instance.Enabled = false

    --------------------------------------------------
    -- ENABLE
    --------------------------------------------------

    local function Enable()

        if instance.Enabled then
            return
        end

        instance.Enabled = true

        Dot.Position =
            UDim2.new(1, -18, 0.5, -8)

        -- เปิด -> เปลี่ยนเฉพาะจุดข้างในเป็นสีเขียว
        Dot.BackgroundColor3 =
            Color3.fromRGB(50, 230, 50)

        Toggle.BackgroundColor3 =
            Color3.fromRGB(70, 70, 70)

        if type(moduleData.OnEnable) == "function" then

            local success, err =
                pcall(moduleData.OnEnable)

            if not success then
                warn(
                    "[KRIZ HUB] "
                    .. moduleName
                    .. " OnEnable error: "
                    .. tostring(err)
                )
            end

        end

    end

    --------------------------------------------------
    -- DISABLE
    --------------------------------------------------

    local function Disable()

        if not instance.Enabled then
            return
        end

        instance.Enabled = false

        Dot.Position =
            UDim2.new(0, 2, 0.5, -8)

        -- ปิด -> เปลี่ยนเฉพาะจุดข้างในเป็นสีแดง
        Dot.BackgroundColor3 =
            Color3.fromRGB(230, 50, 50)

        Toggle.BackgroundColor3 =
            Color3.fromRGB(55, 55, 55)

        if type(moduleData.OnDisable) == "function" then

            local success, err =
                pcall(moduleData.OnDisable)

            if not success then
                warn(
                    "[KRIZ HUB] "
                    .. moduleName
                    .. " OnDisable error: "
                    .. tostring(err)
                )
            end

        end

    end

    --------------------------------------------------
    -- TOGGLE EVENT
    --------------------------------------------------

    instance.Connection =
        Toggle.Activated:Connect(
            function()

                if instance.Enabled then
                    Disable()
                else
                    Enable()
                end

            end
        )

    table.insert(
        self.Connections,
        instance.Connection
    )

    --------------------------------------------------
    -- SAVE
    --------------------------------------------------

    self.Modules[moduleName] = instance

    table.insert(
        self.ModuleInstances,
        instance
    )

    --------------------------------------------------
    -- UPDATE SCROLL
    --------------------------------------------------

    task.defer(UpdateCanvasSize)

    return instance

end

--------------------------------------------------
-- UNREGISTER MODULE
--------------------------------------------------

function Core:UnregisterModule(moduleName)

    local instance =
        self.Modules[moduleName]

    if not instance then
        return false
    end

    --------------------------------------------------
    -- DISABLE FIRST
    --------------------------------------------------

    if instance.Enabled then

        instance.Enabled = false

        if instance.Data
            and type(instance.Data.OnDisable) == "function" then

            pcall(
                instance.Data.OnDisable
            )

        end

    end

    --------------------------------------------------
    -- CONNECTION
    --------------------------------------------------

    if instance.Connection then

        pcall(function()
            instance.Connection:Disconnect()
        end)

    end

    --------------------------------------------------
    -- UI
    --------------------------------------------------

    if instance.Row then
        instance.Row:Destroy()
    end

    --------------------------------------------------
    -- REMOVE FROM ARRAY
    --------------------------------------------------

    for i, module in ipairs(self.ModuleInstances) do

        if module == instance then

            table.remove(
                self.ModuleInstances,
                i
            )

            break

        end

    end

    self.Modules[moduleName] = nil

    task.defer(UpdateCanvasSize)

    return true

end

--------------------------------------------------
-- INITIAL UPDATE
--------------------------------------------------

UpdateCanvasSize()

--------------------------------------------------
-- DESTROY
--------------------------------------------------

function Core:Destroy()

    --------------------------------------------------
    -- DISABLE ALL MODULES
    --------------------------------------------------

    for _, instance in ipairs(self.ModuleInstances) do

        if instance.Enabled then

            instance.Enabled = false

            if instance.Data
                and type(instance.Data.OnDisable) == "function" then

                pcall(
                    instance.Data.OnDisable
                )

            end

        end

    end

    --------------------------------------------------
    -- DISCONNECT ALL CORE CONNECTIONS
    --------------------------------------------------

    for _, connection in ipairs(self.Connections) do

        pcall(function()

            if connection
                and connection.Connected then

                connection:Disconnect()

            end

        end)

    end

    self.Connections = {}

    --------------------------------------------------
    -- DESTROY GUI
    --------------------------------------------------

    if self.ScreenGui then

        pcall(function()
            self.ScreenGui:Destroy()
        end)

    end

    --------------------------------------------------
    -- CLEAR STATE
    --------------------------------------------------

    self.Modules = {}
    self.ModuleInstances = {}
    self.ScreenGui = nil
    self.MainMenu = nil
    self.Icon = nil
    self.ScrollContainer = nil

    if _G.KrizHubCore == self then
        _G.KrizHubCore = nil
    end

end

