FPS.. Low Graphics ปรับภาพต่ำ
AIM.. Aimbot All ล็อคเป้า
AIM1.. Aimbot Enemy ล็อคศัตรู
AIM2.. Aimbot Target ล็อคเป้าเจาะจง
SIT.. Anti-Sit กันนั่ง
FLL.. Fall ล้ม
F.. Free Look หันอิสระ]]

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "KrizHubUI"
    screenGui.Parent = playerGui
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false

    
    local icon = Instance.new("ImageButton")
    icon.Name = "Icon"
    icon.Size = UDim2.new(0, 50, 0, 50)
    icon.Position = UDim2.new(0, 20, 0.3, 0)
    icon.BackgroundColor3 = Color3.new(0, 0, 0)
    icon.BackgroundTransparency = 0.4
    icon.BorderSizePixel = 0
    icon.Parent = screenGui

    local ghostLabel = Instance.new("TextLabel")
    ghostLabel.Size = UDim2.new(1, 0, 1, 0)
    ghostLabel.BackgroundTransparency = 1
    ghostLabel.Text = "👻"
    ghostLabel.TextSize = 25
    ghostLabel.Parent = icon

    
    local frame = Instance.new("Frame")
    frame.Name = "MainFrame"
    frame.Size = UDim2.new(0, 250, 0, 350)
    frame.Position = UDim2.new(0.5, -125, 0.5, -175)
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = screenGui

    
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -20, 1, -20)
    scroll.Position = UDim2.new(0, 10, 0, 10)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 0
    scroll.CanvasSize = UDim2.new(0, 0, 3, 0)
    scroll.Parent = frame

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.TextSize = 10
    textLabel.TextXAlignment = Enum.TextXAlignment.Center
    textLabel.TextYAlignment = Enum.TextYAlignment.Top
    textLabel.Text = DisplayContent
    textLabel.Parent = scroll

    
    local dragging, dragStart, startPos
    icon.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = icon.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            icon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    icon.MouseButton1Click:Connect(function()
        frame.Visible = not frame.Visible
    end)
end)






