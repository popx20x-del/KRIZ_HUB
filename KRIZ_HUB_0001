Core:RegisterModule({Name="ESP Item / สิ่งของที่เก็บได้",Category="Visual",OnEnable=function()
	getgenv().KItem=true local items={}
	local Names={"M9","Glock","Desert Eagle","Revolver","USP","Five-seven","P226","Remington 870","Shotgun","Double Barrel","SPAS-12","Benelli","AK-47","M4A1","Scar-H","FAL","AUG","P90","MP5","UMP45","Vector","Thompson","Sniper","AWM","Barrett","Scout","Intervention","Remington 700","RPG","Rocket Launcher","Minigun","Grenade","C4","Dynamite","Flashbang","Smoke","Knife","Sword","Katana","Machete","Combat Knife","Bat","Crowbar","Hammer","Pipe","Axe","Keycard","Key","Gun","Armor","Medkit","Bandage"}
	local function Check(n) for _,t in ipairs(Names) do if string.find(string.lower(n),string.lower(t)) then return true end end return false end
	local function Clr(d) pcall(function() d.H:Destroy() d.T:Remove() end) end
	local function Add(o)
		if items[o] or not (o:IsA("Model") or o:IsA("BasePart")) or o:IsDescendantOf(game:GetService("Players")) or not Check(o.Name) then return end
		local pt=o:IsA("BasePart") and o or o:FindFirstChildOfClass("BasePart") or o.PrimaryPart
		if pt then
			local h=Instance.new("Highlight",game:GetService("CoreGui"))
			h.FillColor,h.OutlineColor,h.FillTransparency,h.Adornee=Color3.fromRGB(170,50,255),Color3.fromRGB(230,200,255),.5,o
			local t=Drawing.new("Text") t.Size,t.Center,t.Outline,t.OutlineColor,t.Color=13,true,true,Color3.new(0,0,0),Color3.fromRGB(80,255,120)
			items[o]={Part=pt,H=h,T=t,Name=o.Name}
		end
	end
	local conn=workspace.DescendantAdded:Connect(function(o) if getgenv().KItem then task.defer(function() Add(o) end) end end)
	task.spawn(function() for _,o in ipairs(workspace:GetDescendants()) do if not getgenv().KItem then break end Add(o) end end)
	local u=RS.RenderStepped:Connect(function()
		if not getgenv().KItem then return end
		local mH=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not mH then return end
		local list={}
		for o,d in pairs(items) do
			if o and o.Parent and o:IsDescendantOf(workspace) and d.Part and d.Part.Parent then
				local dist=(d.Part.Position-mH.Position).Magnitude
				if dist<=300 then table.insert(list,{Dist=dist,Data=d}) else d.T.Visible=false end
			else Clr(d) items[o]=nil end
		end
		table.sort(list,function(a,b) return a.Dist<b.Dist end)
		for i,item in ipairs(list) do
			local d=item.Data
			if i<=10 then
				local pos,vis=Cam:WorldToViewportPoint(d.Part.Position)
				d.T.Position,d.T.Text,d.T.Visible=Vector2.new(pos.X,pos.Y),"["..d.Name.."] "..math.floor(item.Dist*.28).."m",vis
			else d.T.Visible=false end
		end
	end)
	getgenv().KItemC=function() conn:Disconnect() u:Disconnect() for _,d in pairs(items) do Clr(d) end items={} end
end,OnDisable=function() getgenv().KItem=false if getgenv().KItemC then pcall(getgenv().KItemC) end end})

if _G.KrizHub_ESP_CleanUp then pcall(_G.KrizHub_ESP_CleanUp) end
local ESP,Conns=false,{}
local function getCol(p)
	if p.Team and LP.Team and p.Team==LP.Team then return Color3.fromRGB(0,255,0) end
	local c,b=p.Character,p:FindFirstChildOfClass("Backpack")
	local function check(kws)
		for _,cnt in ipairs({c,b}) do if cnt then for _,i in ipairs(cnt:GetChildren()) do if i:IsA("Tool") then for _,k in ipairs(kws) do if string.find(string.lower(i.Name),k) then return true end end end end end end
	end
	if check({"knife","blade","sword","dagger","murderer"}) then return Color3.fromRGB(255,0,0) end
	if check({"gun","pistol","rifle","revolver","sheriff","cop","police"}) then return Color3.fromRGB(0,100,255) end
	local tm,rl=p.Team and string.lower(p.Team.Name) or "",(p:FindFirstChild("Role") or (c and c:FindFirstChild("Role"))) and string.lower(tostring((p:FindFirstChild("Role") or c.Role).Value)) or ""
	if string.find(tm,"police") or string.find(tm,"cop") or string.find(rl,"sheriff") then return Color3.fromRGB(0,100,255) end
	if string.find(tm,"thief") or string.find(tm,"robber") or string.find(tm,"criminal") or string.find(rl,"murderer") then return Color3.fromRGB(255,0,0) end
	return p.Team and p.TeamColor.Color or Color3.fromRGB(255,255,255)
end
local function clear() for _,p in ipairs(P:GetPlayers()) do if p.Character and p.Character:FindFirstChild("KrizESP") then p.Character.KrizESP:Destroy() end end end
local function upd()
	if not ESP then return end
	for _,p in ipairs(P:GetPlayers()) do
		if p~=LP and p.Character then
			local col=getCol(p)
			local hl=p.Character:FindFirstChild("KrizESP") or Instance.new("Highlight")
			hl.Name,hl.Adornee,hl.FillColor,hl.OutlineColor,hl.FillTransparency,hl.OutlineTransparency,hl.Parent="KrizESP",p.Character,col,col,.5,0,p.Character
		end
	end
end
local t=0
table.insert(Conns,RS.Heartbeat:Connect(function() if ESP and (tick()-t)>.2 then t=tick() upd() end end))
_G.KrizHub_ESP_CleanUp=function() ESP=false clear() for _,c in ipairs(Conns) do if c.Connected then c:Disconnect() end end Conns={} end
Core:RegisterModule({
	Name="ESP Highlight / ไฮไลท์",Category="Visual",
	OnEnable=function() ESP=true upd() end,
	OnDisable=function() ESP=false clear() end
})
table.insert(Core.Connections,{Connected=true,Disconnect=function(self) self.Connected=false pcall(_G.KrizHub_ESP_CleanUp) end})

