Core:RegisterModule({
    Name = "Anti-Fling / ป้องกันฟลิง",
    OnEnable = function()
        getgenv().KrizAntiFlingActive = true
        local S = {Players = game:GetService("Players"), RunService = game:GetService("RunService"), StarterGui = game:GetService("StarterGui")}
        local LP = S.Players.LocalPlayer
        local antiFlingConnections = {}
        local function notify(text)
            task.spawn(function() pcall(function() S.StarterGui:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3}) end) end)
        end
        local function StartAntiFling()
            local function PlayerAdded(Player)
                local Character, PrimaryPart, Detected = nil, nil, false
                local function CharacterAdded(NewChar)
                    Character = NewChar
                    repeat task.wait() PrimaryPart = NewChar:FindFirstChild("HumanoidRootPart") until PrimaryPart
                    Detected = false
                end
                if Player.Character then CharacterAdded(Player.Character) end
                table.insert(antiFlingConnections, Player.CharacterAdded:Connect(CharacterAdded))
                table.insert(antiFlingConnections, S.RunService.Heartbeat:Connect(function()
                    if not getgenv().KrizAntiFlingActive then return end
                    if Character and PrimaryPart and Character:IsDescendantOf(workspace) then
                        if PrimaryPart.AssemblyAngularVelocity.Magnitude > 50 or PrimaryPart.AssemblyLinearVelocity.Magnitude > 100 then
                            if not Detected then
                                pcall(function() S.StarterGui:SetCore("ChatMakeSystemMessage", {Text = "Fling Detected: " .. Player.Name, Color = Color3.new(1, 0.8, 0)}) end)
                            end
                            Detected = true
                            for _, v in ipairs(Character:GetDescendants()) do
                                if v:IsA("BasePart") then v.CanCollide, v.AssemblyAngularVelocity, v.AssemblyLinearVelocity = false, Vector3.zero, Vector3.zero end
                            end
                        end
                    end
                end))
            end
            for _, v in ipairs(S.Players:GetPlayers()) do if v ~= LP then PlayerAdded(v) end end
            table.insert(antiFlingConnections, S.Players.PlayerAdded:Connect(PlayerAdded))
            local LastPosition = nil
            table.insert(antiFlingConnections, S.RunService.Heartbeat:Connect(function()
                if not getgenv().KrizAntiFlingActive then return end
                local Char, HRP = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not HRP then return end
                if HRP.AssemblyLinearVelocity.Magnitude > 250 or HRP.AssemblyAngularVelocity.Magnitude > 250 then
                    HRP.AssemblyAngularVelocity, HRP.AssemblyLinearVelocity = Vector3.zero, Vector3.zero
                    if LastPosition then HRP.CFrame = LastPosition end
                    notify("FLING NEUTRALIZED")
                elseif HRP.AssemblyLinearVelocity.Magnitude < 50 then
                    LastPosition = HRP.CFrame
                end
            end))
        end
        StartAntiFling()
        notify("ANTI-FLING: ON")
        getgenv().KrizAntiFlingCleanup = function()
            for _, conn in pairs(antiFlingConnections) do pcall(function() conn:Disconnect() end) end
            antiFlingConnections = {}
            notify("ANTI-FLING: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizAntiFlingActive = false
        if getgenv().KrizAntiFlingCleanup then pcall(getgenv().KrizAntiFlingCleanup) end
    end
})
