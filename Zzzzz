-- MODULE: ESP HIGHLIGHT (ไฮไลท์ตัวละคร + แก้ไขระบบปิดและเคลียร์ข้อมูล)
--------------------------------------------------
Core:RegisterModule({
    Name = "ESP Highlight / ไฮไลท์",
    OnEnable = function()
        getgenv().KrizHighlightActive = true
        local highlights, pConns = {}, {}
        local addConn, remConn, updConn
        local function RemoveHL(p)
            if highlights[p] then pcall(function() highlights[p]:Destroy() end); highlights[p] = nil end
        end
        local function SetupPlayer(p)
            if p == lp then return end
            local function OnChar(char)
                if not getgenv().KrizHighlightActive then return end
                RemoveHL(p)
                if char then
                    local hl = Instance.new("Highlight")
                    hl.Name, hl.Adornee, hl.FillTransparency, hl.OutlineTransparency, hl.Parent = "KrizHighlight_"..p.Name, char, 0.5, 0, char
                    highlights[p] = hl
                end
            end
            if p.Character and getgenv().KrizHighlightActive then task.spawn(function() OnChar(p.Character) end) end
            pConns[p] = {CharAdded = p.CharacterAdded:Connect(OnChar)}
        end
        local function CleanupPlayer(p)
            RemoveHL(p)
            if pConns[p] then if pConns[p].CharAdded then pcall(function() pConns[p].CharAdded:Disconnect() end) end; pConns[p] = nil end
        end
        for _, p in pairs(P:GetPlayers()) do SetupPlayer(p) end
        addConn, remConn = P.PlayerAdded:Connect(SetupPlayer), P.PlayerRemoving:Connect(CleanupPlayer)
        updConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizHighlightActive then return end
            for p, hl in pairs(highlights) do
                if hl and hl.Parent then
                    local color = GetCol(p)
                    hl.FillColor, hl.OutlineColor = color, color
                end
            end
        end)
        getgenv().KrizHighlightCleanup = function()
            if updConn then pcall(function() updConn:Disconnect() end); updConn = nil end
            if addConn then pcall(function() addConn:Disconnect() end); addConn = nil end
            if remConn then pcall(function() remConn:Disconnect() end); remConn = nil end
            for _, p in ipairs(P:GetPlayers()) do CleanupPlayer(p) end
            highlights, pConns = {}, {}
        end
    end,
    OnDisable = function()
        getgenv().KrizHighlightActive = false
        if getgenv().KrizHighlightCleanup then pcall(getgenv().KrizHighlightCleanup) end
    end
})

