Core:RegisterModule({
    Name = "ESP Tracer / เส้นจากด้านบน",
    OnEnable = function()
        getgenv().KrizTracerTopActive = true
        local tracers, pConns = {}, {}
        local addConn, remConn, updConn
        local function RemoveTracer(p)
            if tracers[p] then pcall(function() tracers[p]:Remove() end); tracers[p] = nil end
        end
        local function SetupPlayer(p)
            if p == lp then return end
            local function OnChar(char)
                if not getgenv().KrizTracerTopActive then return end
                RemoveTracer(p)
                local line = Drawing.new("Line")
                line.Visible, line.Thickness, line.Transparency = false, 1.5, 0.8
                tracers[p] = line
            end
            if p.Character and getgenv().KrizTracerTopActive then task.spawn(function() OnChar(p.Character) end) end
            pConns[p] = {CharAdded = p.CharacterAdded:Connect(OnChar)}
        end
        local function CleanupPlayer(p)
            RemoveTracer(p)
            if pConns[p] then if pConns[p].CharAdded then pcall(function() pConns[p].CharAdded:Disconnect() end) end; pConns[p] = nil end
        end
        for _, p in pairs(P:GetPlayers()) do SetupPlayer(p) end
        addConn, remConn = P.PlayerAdded:Connect(SetupPlayer), P.PlayerRemoving:Connect(CleanupPlayer)
        updConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizTracerTopActive then return end
            local origin = Vector2.new(Cam.ViewportSize.X / 2, 0)
            for p, line in pairs(tracers) do
                local hrp, hum = p.Character and p.Character:FindFirstChild("HumanoidRootPart"), p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local screenPos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        line.From, line.To, line.Color, line.Visible = origin, Vector2.new(screenPos.X, screenPos.Y), GetCol(p), true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end)
        getgenv().KrizTracerTopCleanup = function()
            if updConn then pcall(function() updConn:Disconnect() end); updConn = nil end
            if addConn then pcall(function() addConn:Disconnect() end); addConn = nil end
            if remConn then pcall(function() remConn:Disconnect() end); remConn = nil end
            for _, p in ipairs(P:GetPlayers()) do CleanupPlayer(p) end
            tracers, pConns = {}, {}
        end
    end,
    OnDisable = function()
        getgenv().KrizTracerTopActive = false
        if getgenv().KrizTracerTopCleanup then pcall(getgenv().KrizTracerTopCleanup) end
    end
})

