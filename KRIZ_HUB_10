function Core:RegisterModule(m)
    if type(m) ~= "table" or type(m.Name) ~= "string" or self.Modules[m.Name] then return end
    local cat = m.Category or "General"
    local cData = self.CategoryContainers[cat] or self.CategoryContainers["General"]
    local inst = {Name=m.Name, Data=m, Enabled=false, Category=cat}

    local Row = Instance.new("Frame", cData.Scroll) Row.Name, Row.Size, Row.BackgroundColor3, Row.BackgroundTransparency, Row.ZIndex = "Function_"..m.Name, UDim2.new(1,-6,0,40), Color3.fromRGB(20,20,20), 0.35, 10000002 C(Row) S(Row)
    local Lbl = Instance.new("TextLabel", Row) Lbl.Name, Lbl.Size, Lbl.Position, Lbl.BackgroundTransparency, Lbl.Text, Lbl.TextColor3, Lbl.TextSize, Lbl.Font, Lbl.TextXAlignment, Lbl.ZIndex = "Name", UDim2.new(1,-60,1,0), UDim2.new(0,10,0,0), 1, m.Name, Color3.fromRGB(255,255,255), 14, Enum.Font.Gotham, Enum.TextXAlignment.Left, 10000003
    local Tgl = Instance.new("TextButton", Row) Tgl.Name, Tgl.Size, Tgl.Position, Tgl.BackgroundColor3, Tgl.BackgroundTransparency, Tgl.Text, Tgl.AutoButtonColor, Tgl.ZIndex = "Toggle", UDim2.new(0,38,0,20), UDim2.new(1,-48,0.5,-10), Color3.fromRGB(55,55,55), 0.15, "", false, 10000003 C(Tgl, UDim.new(1,0))
    local Dot = Instance.new("Frame", Tgl) Dot.Name, Dot.Size, Dot.Position, Dot.BackgroundColor3, Dot.ZIndex = "Dot", UDim2.new(0,16,0,16), UDim2.new(0,2,0.5,-8), Color3.fromRGB(230,50,50), 10000004 C(Dot, UDim.new(1,0))

    inst.Connection = Tgl.Activated:Connect(function()
        inst.Enabled = not inst.Enabled
        Dot.Position = inst.Enabled and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        Dot.BackgroundColor3 = inst.Enabled and Color3.fromRGB(50,230,50) or Color3.fromRGB(230,50,50)
        Tgl.BackgroundColor3 = inst.Enabled and Color3.fromRGB(70,70,70) or Color3.fromRGB(55,55,55)
        local cb = m[inst.Enabled and "OnEnable" or "OnDisable"]
        if type(cb) == "function" then pcall(cb) end
    end)
    table.insert(self.Connections, inst.Connection)
    self.Modules[m.Name] = inst table.insert(self.ModuleInstances, inst)
    task.defer(function() cData.Scroll.CanvasSize = UDim2.new(0,0,0,math.max(cData.Layout.AbsoluteContentSize.Y+16,0)) end)
    return inst
end

function Core:Destroy()
    for _, inst in ipairs(self.ModuleInstances) do if inst.Enabled then pcall(inst.Data.OnDisable) end end
    for _, conn in ipairs(self.Connections) do pcall(function() if conn.Connected then conn:Disconnect() end end) end
    if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
    self.Modules, self.ModuleInstances, self.CategoryContainers, self.Connections = {}, {}, {}, {}
    if _G.KrizHubCore == self then _G.KrizHubCore = nil end
end

