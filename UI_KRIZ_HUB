local function CreateSubRow(name1, name2, parentFrame)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundTransparency = 1
    row.Visible = false -- เริ่มต้นซ่อนไว้
    row.Parent = parentFrame

    local b1 = Instance.new("TextButton")
    b1.Size = UDim2.new(0.485, 0, 1, 0)
    b1.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    b1.BackgroundTransparency = 0.8
    b1.Text = name1
    b1.TextColor3 = Color3.fromRGB(255, 255, 255)
    b1.TextSize = 15
    b1.Font = Enum.Font.SourceSans
    b1.Parent = row
    Instance.new("UICorner", b1).CornerRadius = UDim.new(0, 2)

    local b2 = Instance.new("TextButton")
    b2.Size = UDim2.new(0.485, 0, 1, 0)
    b2.Position = UDim2.new(0.515, 0, 0, 0)
    b2.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    b2.BackgroundTransparency = 0.8
    b2.Text = name2
    b2.TextColor3 = Color3.fromRGB(255, 255, 255)
    b2.TextSize = 15
    b2.Font = Enum.Font.SourceSans
    b2.Parent = row
    Instance.new("UICorner", b2).CornerRadius = UDim.new(0, 2)
    
    return row, b1, b2
end

