--------------------------------------------------
-- MODULE: AIR WALK / เดินบนอากาศ (หมวด General)
--------------------------------------------------
Core:RegisterModule({
    Name = "Air Walk / เดินบนอากาศ",
    Category = "General",
    OnEnable = function()
        getgenv().KrizAirWalkActive = true
        local P, RS, UIS, SG, LP = game:GetService("Players"), game:GetService("RunService"), game:GetService("UserInputService"), game:GetService("StarterGui"), game:GetService("Players").LocalPlayer
        local function notify(text)
            task.spawn(function() pcall(function() SG:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3}) end) end)
        end
        local speedValue, airWalkPart, airWalkConn = 50, nil, nil
        local function cleanupAirWalk()
            if airWalkPart then airWalkPart:Destroy(); airWalkPart = nil end
            if airWalkConn then airWalkConn:Disconnect(); airWalkConn = nil end
        end
        local function enableAirWalk()
            cleanupAirWalk()
            airWalkPart = Instance.new("Part", workspace)
            airWalkPart.Size, airWalkPart.Anchored, airWalkPart.CanCollide, airWalkPart.Transparency = Vector3.new(500, 1, 500), true, true, 1
            local lockedY = nil
            airWalkConn = RS.Heartbeat:Connect(function()
                if not getgenv().KrizAirWalkActive then return end
                local char = LP.Character
                if not char or not airWalkPart then return end
                local root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                if not lockedY then lockedY = root.Position.Y - 4 end
                if hum.MoveDirection.Magnitude > 0.05 then lockedY = lockedY + ((root.Position.Y - 4) - lockedY) * 0.5 end
                airWalkPart.Position = Vector3.new(root.Position.X, lockedY, root.Position.Z)
            end)
        end
        local renderConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizAirWalkActive then return end
            local char = LP.Character
            if not char then return end
            local hum, root = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
            if root and hum and speedValue > 0 and hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (speedValue / 50))
            end
        end)
        local jumpConn = UIS.JumpRequest:Connect(function()
            if getgenv().KrizAirWalkActive and LP.Character then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end)
        enableAirWalk()
        notify("Air Walk: ON")
        getgenv().KrizAirWalkCleanup = function()
            if renderConn then renderConn:Disconnect() end
            if jumpConn then jumpConn:Disconnect() end
            cleanupAirWalk()
            notify("Air Walk: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizAirWalkActive = false
        if getgenv().KrizAirWalkCleanup then pcall(getgenv().KrizAirWalkCleanup) end
    end
})

--------------------------------------------------
-- MODULE: NOCLIP / เดินทะลุทุกอย่าง (หมวด General)
--------------------------------------------------
Core:RegisterModule({
    Name = "Noclip / เดินทะลุทุกอย่าง",
    Category = "General",
    OnEnable = function()
        getgenv().KrizNoclipActive = true
        local P, RS, SG, LP = game:GetService("Players"), game:GetService("RunService"), game:GetService("StarterGui"), game:GetService("Players").LocalPlayer
        local function notify(text)
            task.spawn(function() pcall(function() SG:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3}) end) end)
        end
        if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect() end
        local lastState = false
        local function setCollisions(state)
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then obj.CanCollide = state end
                end
            end)
        end
        getgenv().KRIZ_NOCLIP_CONN = RS.Stepped:Connect(function()
            if getgenv().KrizNoclipActive and LP.Character then
                if not lastState then lastState = true; setCollisions(false) end
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
                local root = LP.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local hit = workspace:FindPartOnRayWithIgnoreList(Ray.new(root.Position, Vector3.new(0, -6, 0)), {LP.Character})
                    if hit then hit.CanCollide = true end
                end
            else
                if lastState then lastState = false; setCollisions(true) end
            end
        end)
        notify("NOCLIP: ON")
        getgenv().KrizNoclipCleanup = function()
            if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect(); getgenv().KRIZ_NOCLIP_CONN = nil end
            setCollisions(true)
            notify("NOCLIP: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizNoclipActive = false
        if getgenv().KrizNoclipCleanup then pcall(getgenv().KrizNoclipCleanup) end
    end
})

--------------------------------------------------
-- MODULE: ANTI-FLING / ป้องกันฟลิง (หมวด Defense)
--------------------------------------------------
Core:RegisterModule({
    Name = "Anti-Fling / ป้องกันฟลิง",
    Category = "Defense",
    OnEnable = function()
        getgenv().KrizAntiFlingActive = true
        local S = {Players = game:GetService("Players"), RunService = game:GetService("RunService"), StarterGui = game:GetService("StarterGui")}
        local LP = S.Players.LocalPlayer
        local antiFlingConnections = {}
        local function notify(text)
            task.spawn(function() pcall(function() S.StarterGui:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3}) end) end)
        end
        local function StartAntiFling()
            local function PlayerAdded(Player)
                local Character, PrimaryPart, Detected = nil, nil, false
                local function CharacterAdded(NewChar)
                    Character = NewChar
                    repeat task.wait() PrimaryPart = NewChar:FindFirstChild("HumanoidRootPart") until PrimaryPart
                    Detected = false
                end
                if Player.Character then CharacterAdded(Player.Character) end
                table.insert(antiFlingConnections, Player.CharacterAdded:Connect(CharacterAdded))
                table.insert(antiFlingConnections, S.RunService.Heartbeat:Connect(function()
                    if not getgenv().KrizAntiFlingActive then return end
                    if Character and PrimaryPart and Character:IsDescendantOf(workspace) then
                        if PrimaryPart.AssemblyAngularVelocity.Magnitude > 50 or PrimaryPart.AssemblyLinearVelocity.Magnitude > 100 then
                            if not Detected then
                                pcall(function() S.StarterGui:SetCore("ChatMakeSystemMessage", {Text = "Fling Detected: " .. Player.Name, Color = Color3.new(1, 0.8, 0)}) end)
                            end
                            Detected = true
                            for _, v in ipairs(Character:GetDescendants()) do
                                if v:IsA("BasePart") then v.CanCollide, v.AssemblyAngularVelocity, v.AssemblyLinearVelocity = false, Vector3.zero, Vector3.zero end
                            end
                        end
                    end
                end))
            end
            for _, v in ipairs(S.Players:GetPlayers()) do if v ~= LP then PlayerAdded(v) end end
            table.insert(antiFlingConnections, S.Players.PlayerAdded:Connect(PlayerAdded))
            local LastPosition = nil
            table.insert(antiFlingConnections, S.RunService.Heartbeat:Connect(function()
                if not getgenv().KrizAntiFlingActive then return end
                local Char, HRP = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not HRP then return end
                if HRP.AssemblyLinearVelocity.Magnitude > 250 or HRP.AssemblyAngularVelocity.Magnitude > 250 then
                    HRP.AssemblyAngularVelocity, HRP.AssemblyLinearVelocity = Vector3.zero, Vector3.zero
                    if LastPosition then HRP.CFrame = LastPosition end
                    notify("FLING NEUTRALIZED")
                elseif HRP.AssemblyLinearVelocity.Magnitude < 50 then
                    LastPosition = HRP.CFrame
                end
            end))
        end
        StartAntiFling()
        notify("ANTI-FLING: ON")
        getgenv().KrizAntiFlingCleanup = function()
            for _, conn in pairs(antiFlingConnections) do pcall(function() conn:Disconnect() end) end
            antiFlingConnections = {}
            notify("ANTI-FLING: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizAntiFlingActive = false
        if getgenv().KrizAntiFlingCleanup then pcall(getgenv().KrizAntiFlingCleanup) end
    end
})
