    Category = "Attack",
    OnEnable = function()
        getgenv().KrizHitboxActive = true
        local CG, P, RS, SG, LP = game:GetService("CoreGui"), game:GetService("Players"), game:GetService("RunService"), game:GetService("StarterGui"), game:GetService("Players").LocalPlayer
        local hitboxSize = 5

        local function notify(text)
            task.spawn(function()
                pcall(function()
                    SG:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3})
                end)
            end)
        end

        -- ค้นหา rowFrame จาก Container ของหมวด Attack โดยตรง
        local rowFrame = nil
        pcall(function()
            if _G.KrizHubCore and _G.KrizHubCore.CategoryContainers and _G.KrizHubCore.CategoryContainers["Attack"] then
                local attackScroll = _G.KrizHubCore.CategoryContainers["Attack"].Scroll
                for _, child in ipairs(attackScroll:GetChildren()) do
                    if child:IsA("Frame") then
                        local lbl = child:FindFirstChild("Name")
                        if lbl and (string.find(lbl.Text, "Hitbox") or string.find(lbl.Text, "ขยายฮิตบ็อกซ์")) then
                            rowFrame = child
                            break
                        end
                    end
                end
            end
        end)

        local hitboxBox
        if rowFrame then
            -- ปรับหลบข้อความชื่อฟังก์ชันสำหรับ 1 ปุ่ม (เหลือความกว้าง -95px)
            local nameLbl = rowFrame:FindFirstChild("Name")
            if nameLbl then
                nameLbl.Size = UDim2.new(1, -95, 1, 0)
                nameLbl.ClipsDescendants = true
            end

            -- ช่องกรอกขนาด Hitbox ทรงแคปซูลมาตรฐาน (-88px)
            hitboxBox = Instance.new("TextBox", rowFrame)
            hitboxBox.Name = "HitboxBox"
            hitboxBox.Size = UDim2.new(0, 36, 0, 20)
            hitboxBox.Position = UDim2.new(1, -88, 0.5, -10)
            hitboxBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            hitboxBox.BackgroundTransparency = 0.15
            hitboxBox.BorderSizePixel = 0
            hitboxBox.Font = Enum.Font.Gotham
            hitboxBox.Text = tostring(hitboxSize)
            hitboxBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            hitboxBox.TextSize = 10
            hitboxBox.ClearTextOnFocus = false
            hitboxBox.ZIndex = 10003
            hitboxBox.PlaceholderText = "SIZE"
            
            local corner = Instance.new("UICorner", hitboxBox)
            corner.CornerRadius = UDim.new(1, 0)

            local oldText = tostring(hitboxSize)
            hitboxBox.Focused:Connect(function()
                oldText = hitboxBox.Text
                hitboxBox.Text = ""
            end)
            
            hitboxBox.FocusLost:Connect(function()
                local val = tonumber(hitboxBox.Text)
                if val and val > 0 then
                    hitboxSize = val
                    hitboxBox.Text = tostring(hitboxSize)
                else
                    hitboxBox.Text = oldText
                end
            end)
        end

        local function expandHitbox(char)
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.Size, hrp.Transparency, hrp.CanCollide = Vector3.new(hitboxSize, hitboxSize, hitboxSize), 0.7, false
            end
        end

        local hitboxConn = RS.RenderStepped:Connect(function()
            if not getgenv().KrizHitboxActive then return end
            for _, v in pairs(P:GetPlayers()) do
                if v ~= LP and v.Character then expandHitbox(v.Character) end
            end
        end)

        notify("HITBOX: ON")

        getgenv().KrizHitboxCleanup = function()
            if hitboxConn then hitboxConn:Disconnect() end
            if hitboxBox then pcall(function() hitboxBox:Destroy() end) end
            if rowFrame then
                local nameLbl = rowFrame:FindFirstChild("Name")
                if nameLbl then nameLbl.Size = UDim2.new(1, -60, 1, 0) end
            end
            for _, v in pairs(P:GetPlayers()) do
                pcall(function()
                    if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = v.Character.HumanoidRootPart
                        hrp.Size, hrp.Transparency = Vector3.new(2, 2, 1), 1
                    end
                end)
            end
            notify("HITBOX: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizHitboxActive = false
        if getgenv().KrizHitboxCleanup then pcall(getgenv().KrizHitboxCleanup) end
    end
})
