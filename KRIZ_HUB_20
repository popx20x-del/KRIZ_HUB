--------------------------------------------------
-- MODULE: AIMBOT (ENEMY ONLY) / ล็อกเป้าเฉพาะศัตรู (พิมพ์เขียวมาตรฐาน 5 ปุ่มแคปซูล)
--------------------------------------------------
Core:RegisterModule({
    Name = "Aimbot / ล็อคเป้า",
    Category = "Attack",
    OnEnable = function()
        getgenv().KrizAimEnemyActive = false
        local aimActive = false
        local CG, UIS, P, RS, SG, LP, Cam = game:GetService("CoreGui"), game:GetService("UserInputService"), game:GetService("Players"), game:GetService("RunService"), game:GetService("StarterGui"), game:GetService("Players").LocalPlayer, workspace.CurrentCamera
        local aimFOV = 100
        local smoothLevels, smoothNames, currentSmoothIndex = {1, 2, 3}, {"SMOOTH: 1 (ติดหนึบ 100%)", "SMOOTH: 2 (ปานกลาง 70%)", "SMOOTH: 3 (นุ่มนวล 40%)"}, 1
        local targetParts, targetPartNames, currentPartIndex = {"Head", "HumanoidRootPart"}, {"HEAD", "TORSO"}, 1
        local wallStates, wallStateNames, currentWallIndex = {false, true}, {"WALL: OFF", "WALL: ON"}, 1
        local targetModes, targetModeNames, currentModeIndex = {"Enemy", "All"}, {"TARGET: ENEMY (เฉพาะศัตรู)", "TARGET: ALL (ทุกคน)"}, 1
        
        local function notify(text)
            task.spawn(function()
                pcall(function()
                    SG:SetCore("SendNotification", {Title = "KRIZ HUB", Text = text, Duration = 3})
                end)
            end)
        end

        local ScreenGui = Instance.new("ScreenGui", CG)
        ScreenGui.Name, ScreenGui.ZIndexBehavior, ScreenGui.DisplayOrder, ScreenGui.Enabled = "KrizHubAimEnemyUI", Enum.ZIndexBehavior.Sibling, 999999, true
        
        local Button = Instance.new("TextButton", ScreenGui)
        Button.Name, Button.BackgroundColor3, Button.BackgroundTransparency, Button.Position, Button.Size, Button.AutoButtonColor, Button.Font, Button.Text, Button.TextColor3, Button.TextSize = "MainButton", Color3.fromRGB(0, 0, 0), 0.5, UDim2.new(0.5, -35, 0.4, -15), UDim2.new(0, 70, 0, 30), false, Enum.Font.GothamBold, "ON", Color3.fromRGB(255, 255, 255), 13
        
        local dragging, dragStart, startPos, activeInput, isMoved = false, Vector3.new(0,0,0), UDim2.new(0,0,0,0), nil, false
        Button.InputBegan:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and activeInput == nil then
                dragging, isMoved, activeInput, dragStart, startPos = true, false, input, input.Position, Button.Position
            end
        end)
        
        UIS.InputChanged:Connect(function(input)
            if dragging and input == activeInput then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then isMoved = true end
                Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        
        local function endDrag(input)
            if input == activeInput then dragging, activeInput = false, nil end
        end
        Button.InputEnded:Connect(endDrag)
        UIS.InputEnded:Connect(endDrag)

        -- 1. ค้นหา rowFrame จาก Container ของหมวด Attack โดยตรง
        local rowFrame = nil
        pcall(function()
            if _G.KrizHubCore and _G.KrizHubCore.CategoryContainers and _G.KrizHubCore.CategoryContainers["Attack"] then
                local attackScroll = _G.KrizHubCore.CategoryContainers["Attack"].Scroll
                for _, child in ipairs(attackScroll:GetChildren()) do
                    if child:IsA("Frame") then
                        local lbl = child:FindFirstChild("Name")
                        if lbl and (string.find(lbl.Text, "Aimbot") or string.find(lbl.Text, "ล็อคเป้า")) then
                            rowFrame = child
                            break
                        end
                    end
                end
            end
        end)

        local fovBox, smoothButton, modeButton, partButton, wallButton
        if rowFrame then
            -- ปรับหลบข้อความชื่อฟังก์ชันสำหรับ 5 ปุ่ม (เหลือความกว้าง -255px)
            local nameLbl = rowFrame:FindFirstChild("Name")
            if nameLbl then
                nameLbl.Size = UDim2.new(1, -255, 1, 0)
                nameLbl.ClipsDescendants = true
            end

            -- ปุ่มที่ 1: Wall Check (ชิดสวิตช์หลักที่สุด -88px)
            wallButton = Instance.new("TextButton", rowFrame)
            wallButton.Name = "WallButton"
            wallButton.Size = UDim2.new(0, 36, 0, 20)
            wallButton.Position = UDim2.new(1, -88, 0.5, -10)
            wallButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            wallButton.BackgroundTransparency = 0.15
            wallButton.BorderSizePixel = 0
            wallButton.Font = Enum.Font.GothamBold
            wallButton.Text = wallStates[currentWallIndex] and "W:ON" or "W:OFF"
            wallButton.TextColor3 = wallStates[currentWallIndex] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            wallButton.TextSize = 8
            wallButton.ZIndex = 10003
            local c1 = Instance.new("UICorner", wallButton) c1.CornerRadius = UDim.new(1, 0)

            wallButton.MouseButton1Click:Connect(function()
                currentWallIndex = currentWallIndex + 1
                if currentWallIndex > #wallStates then currentWallIndex = 1 end
                local isWallOn = wallStates[currentWallIndex]
                wallButton.Text = isWallOn and "W:ON" or "W:OFF"
                wallButton.TextColor3 = isWallOn and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
                notify("WALL CHECK: " .. wallStateNames[currentWallIndex])
            end)

            -- ปุ่มที่ 2: Aim Part (-128px)
            partButton = Instance.new("TextButton", rowFrame)
            partButton.Name = "PartButton"
            partButton.Size = UDim2.new(0, 36, 0, 20)
            partButton.Position = UDim2.new(1, -128, 0.5, -10)
            partButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            partButton.BackgroundTransparency = 0.15
            partButton.BorderSizePixel = 0
            partButton.Font = Enum.Font.GothamBold
            partButton.Text = targetPartNames[currentPartIndex]
            partButton.TextColor3 = Color3.fromRGB(0, 255, 255)
            partButton.TextSize = 8
            partButton.ZIndex = 10003
            local c2 = Instance.new("UICorner", partButton) c2.CornerRadius = UDim.new(1, 0)

            partButton.MouseButton1Click:Connect(function()
                currentPartIndex = currentPartIndex + 1
                if currentPartIndex > #targetParts then currentPartIndex = 1 end
                partButton.Text = targetPartNames[currentPartIndex]
                notify("AIM PART: " .. targetPartNames[currentPartIndex])
            end)

            -- ปุ่มที่ 3: Target Mode (-168px)
            modeButton = Instance.new("TextButton", rowFrame)
            modeButton.Name = "ModeButton"
            modeButton.Size = UDim2.new(0, 36, 0, 20)
            modeButton.Position = UDim2.new(1, -168, 0.5, -10)
            modeButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            modeButton.BackgroundTransparency = 0.15
            modeButton.BorderSizePixel = 0
            modeButton.Font = Enum.Font.GothamBold
            modeButton.Text = targetModes[currentModeIndex] == "Enemy" and "ENEMY" or "ALL"
            modeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            modeButton.TextSize = 8
            modeButton.ZIndex = 10003
            local c3 = Instance.new("UICorner", modeButton) c3.CornerRadius = UDim.new(1, 0)

            modeButton.MouseButton1Click:Connect(function()
                currentModeIndex = currentModeIndex + 1
                if currentModeIndex > #targetModes then currentModeIndex = 1 end
                modeButton.Text = targetModes[currentModeIndex] == "Enemy" and "ENEMY" or "ALL"
                notify("TARGET MODE: " .. targetModeNames[currentModeIndex])
            end)

            -- ปุ่มที่ 4: Smooth Level (-208px)
            smoothButton = Instance.new("TextButton", rowFrame)
            smoothButton.Name = "SmoothButton"
            smoothButton.Size = UDim2.new(0, 36, 0, 20)
            smoothButton.Position = UDim2.new(1, -208, 0.5, -10)
            smoothButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            smoothButton.BackgroundTransparency = 0.15
            smoothButton.BorderSizePixel = 0
            smoothButton.Font = Enum.Font.GothamBold
            smoothButton.Text = "S:" .. smoothLevels[currentSmoothIndex]
            smoothButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            smoothButton.TextSize = 8
            smoothButton.ZIndex = 10003
            local c4 = Instance.new("UICorner", smoothButton) c4.CornerRadius = UDim.new(1, 0)

            smoothButton.MouseButton1Click:Connect(function()
                currentSmoothIndex = currentSmoothIndex + 1
                if currentSmoothIndex > #smoothLevels then currentSmoothIndex = 1 end
                smoothButton.Text = "S:" .. smoothLevels[currentSmoothIndex]
                notify(smoothNames[currentSmoothIndex])
            end)

            -- ปุ่มที่ 5: FOV Input Box (ซ้ายสุด -248px ชิดขอบซ้ายพอดีเป๊ะ)
            fovBox = Instance.new("TextBox", rowFrame)
            fovBox.Name = "FOVBox"
            fovBox.Size = UDim2.new(0, 36, 0, 20)
            fovBox.Position = UDim2.new(1, -248, 0.5, -10)
            fovBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            fovBox.BackgroundTransparency = 0.15
            fovBox.BorderSizePixel = 0
            fovBox.Font = Enum.Font.Gotham
            fovBox.Text = tostring(aimFOV)
            fovBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            fovBox.TextSize = 10
            fovBox.ClearTextOnFocus = false
            fovBox.ZIndex = 10003
            fovBox.PlaceholderText = "FOV"
            local c5 = Instance.new("UICorner", fovBox) c5.CornerRadius = UDim.new(1, 0)

            local oldFovText = tostring(aimFOV)
            fovBox.Focused:Connect(function() oldFovText = fovBox.Text; fovBox.Text = "" end)
            fovBox.FocusLost:Connect(function()
                local val = tonumber(fovBox.Text)
                if val and val > 0 then aimFOV = val; fovBox.Text = tostring(aimFOV) else fovBox.Text = oldFovText end
            end)
        end

        local fovCircle = Drawing.new("Circle")
        fovCircle.Thickness, fovCircle.NumSides, fovCircle.Filled, fovCircle.Visible, fovCircle.Color = 1, 30, false, false, Color3.fromRGB(255, 255, 255)

        local function getTarget()
            local closest, dist = nil, aimFOV
            local screenCenter = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
            local selectedPartName, ignoreWall, selectedMode = targetParts[currentPartIndex], wallStates[currentWallIndex], targetModes[currentModeIndex]
            for _, p in pairs(P:GetPlayers()) do
                local isTargetValid = (selectedMode == "All" and p ~= LP) or (selectedMode == "Enemy" and p ~= LP and p.Team ~= LP.Team)
                if isTargetValid and p.Character then
                    local hum, targetPart = p.Character:FindFirstChild("Humanoid"), p.Character:FindFirstChild(selectedPartName) or p.Character:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and targetPart then
                        local pos, vis = Cam:WorldToViewportPoint(targetPart.Position)
                        local isValid = false
                        if ignoreWall then isValid = vis else
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances, rayParams.FilterType = {LP.Character, p.Character}, Enum.RaycastFilterType.Exclude
                            local rayResult = workspace:Raycast(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position), rayParams)
                            isValid = vis and not rayResult
                        end
                        if isValid then
                            local d = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if d < dist then closest, dist = targetPart, d end
                        end
                    end
                end
            end
            return closest
        end

        local aimConn = RS.RenderStepped:Connect(function(dt)
            if not fovCircle then return end
            fovCircle.Position, fovCircle.Radius, fovCircle.Visible = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2), aimFOV, aimActive
            if aimActive then
                local target = getTarget()
                if target then
                    local camPos = Cam.CFrame.Position
                    local targetCFrame = CFrame.lookAt(camPos, target.Position)
                    local currentSmoothLevel = smoothLevels[currentSmoothIndex]
                    if currentSmoothLevel == 1 then
                        Cam.CFrame = targetCFrame
                    else
                        local smoothFactor = (currentSmoothLevel == 2) and 0.35 or 0.18
                        local currentRot = Cam.CFrame.Rotation
                        local targetRot = targetCFrame.Rotation
                        local newRot = currentRot:Lerp(targetRot, math.clamp(dt * smoothFactor * 60, 0.01, 1))
                        Cam.CFrame = CFrame.new(camPos) * newRot
                    end
                end
            end
        end)

        Button.MouseButton1Click:Connect(function()
            if not isMoved then
                aimActive = not aimActive
                getgenv().KrizAimEnemyActive = aimActive
                Button.TextColor3 = aimActive and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
                notify(aimActive and "LOCK: ON" or "LOCK: OFF")
            end
        end)
        notify("LOCK UI: OPEN")

        getgenv().KrizAimEnemyCleanup = function()
            aimActive, getgenv().KrizAimEnemyActive = false, false
            if aimConn then aimConn:Disconnect() end
            if fovCircle then fovCircle:Remove() end
            for _, obj in pairs({ScreenGui, fovBox, smoothButton, partButton, wallButton, modeButton}) do
                pcall(function() if obj then obj:Destroy() end end)
            end
            if rowFrame then
                local nameLbl = rowFrame:FindFirstChild("Name")
                if nameLbl then nameLbl.Size = UDim2.new(1, -60, 1, 0) end
            end
            notify("LOCK: OFF")
        end
    end,
    OnDisable = function()
        getgenv().KrizAimEnemyActive = false
        if getgenv().KrizAimEnemyCleanup then pcall(getgenv().KrizAimEnemyCleanup) end
    end
})

