			mBtn.MouseButton1Click:Connect(function() cMI=cMI%#tM+1 mBtn.Text=tM[cMI]=="Enemy" and "ENEMY" or "ALL" ntf("TARGET MODE: "..tMN[cMI]) end)
			sBtn=cBtn("SmoothButton",UDim2.new(0,36,0,20),UDim2.new(1,-208,.5,-10),"S:"..sL[cSI],Color3.fromRGB(255,255,255),8)
			sBtn.MouseButton1Click:Connect(function() cSI=cSI%#sL+1 sBtn.Text="S:"..sL[cSI] ntf(sN[cSI]) end)
			fBox=Instance.new("TextBox",rFrame) fBox.Name,fBox.Size,fBox.Position,fBox.BackgroundColor3,fBox.BackgroundTransparency,fBox.BorderSizePixel,fBox.Font,fBox.Text,fBox.TextColor3,fBox.TextSize,fBox.ClearTextOnFocus,fBox.ZIndex,fBox.PlaceholderText="FOVBox",UDim2.new(0,36,0,20),UDim2.new(1,-248,.5,-10),Color3.fromRGB(55,55,55),.15,0,Enum.Font.Gotham,tostring(aFOV),Color3.fromRGB(255,255,255),10,false,10003,"FOV"
			Instance.new("UICorner",fBox).CornerRadius=UDim.new(1,0)
			local oFov=tostring(aFOV)
			fBox.Focused:Connect(function() oFov,fBox.Text=fBox.Text,"" end)
			fBox.FocusLost:Connect(function() local v=tonumber(fBox.Text) if v and v>0 then aFOV,fBox.Text=v,tostring(v) else fBox.Text=oFov end end)
		end
