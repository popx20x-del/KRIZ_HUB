Core:RegisterModule({
	Name="Air Walk / เดินบนอากาศ",
	Category="General",
	OnEnable=function()
		getgenv().KrizAirWalkActive=true
		local P,RS,UIS,SG,LP=game:GetService("Players"),game:GetService("RunService"),game:GetService("UserInputService"),game:GetService("StarterGui"),game:GetService("Players").LocalPlayer
		local function ntf(txt) task.spawn(function() pcall(function() SG:SetCore("SendNotification",{Title="KRIZ HUB",Text=txt,Duration=3}) end) end) end
		local spd,awP,awConn=50,nil,nil
		local function clnAW() if awP then awP:Destroy() awP=nil end if awConn then awConn:Disconnect() awConn=nil end end
		local function enAW()
			clnAW() awP=Instance.new("Part",workspace) awP.Size,awP.Anchored,awP.CanCollide,awP.Transparency=Vector3.new(500,1,500),true,true,1
			local lY=nil
			awConn=RS.Heartbeat:Connect(function()
				if not getgenv().KrizAirWalkActive then return end
				local c=LP.Character if not c or not awP then return end
				local r,h=c:FindFirstChild("HumanoidRootPart"),c:FindFirstChildOfClass("Humanoid") if not r or not h then return end
				if not lY then lY=r.Position.Y-4 end
				if h.MoveDirection.Magnitude>.05 then lY=lY+((r.Position.Y-4)-lY)*.5 end
				awP.Position=Vector3.new(r.Position.X,lY,r.Position.Z)
			end)
		end
		local rConn=RS.RenderStepped:Connect(function()
			if not getgenv().KrizAirWalkActive then return end
			local c=LP.Character if not c then return end
			local h,r=c:FindFirstChildOfClass("Humanoid"),c:FindFirstChild("HumanoidRootPart")
			if r and h and spd>0 and h.MoveDirection.Magnitude>0 then r.CFrame=r.CFrame+(h.MoveDirection*(spd/50)) end
		end)
		local jConn=UIS.JumpRequest:Connect(function()
			if getgenv().KrizAirWalkActive and LP.Character then
				local h=LP.Character:FindFirstChildOfClass("Humanoid") if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
			end
		end)
		enAW() ntf("Air Walk: ON")
		getgenv().KrizAirWalkCleanup=function()
			if rConn then rConn:Disconnect() end if jConn then jConn:Disconnect() end
			clnAW() ntf("Air Walk: OFF")
		end
	end,
	OnDisable=function()
		getgenv().KrizAirWalkActive=false
		if getgenv().KrizAirWalkCleanup then pcall(getgenv().KrizAirWalkCleanup) end
	end
})



Core:RegisterModule({
	Name="Noclip / เดินทะลุทุกอย่าง",
	Category="General",
	OnEnable=function()
		getgenv().KrizNoclipActive=true
		local P,RS,SG,LP=game:GetService("Players"),game:GetService("RunService"),game:GetService("StarterGui"),game:GetService("Players").LocalPlayer
		local function ntf(txt) task.spawn(function() pcall(function() SG:SetCore("SendNotification",{Title="KRIZ HUB",Text=txt,Duration=3}) end) end) end
		if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect() end
		local lSt=false
		local function setCol(st)
			pcall(function() for _,o in pairs(workspace:GetDescendants()) do if o:IsA("BasePart") then o.CanCollide=st end end end)
		end
		getgenv().KRIZ_NOCLIP_CONN=RS.Stepped:Connect(function()
			if getgenv().KrizNoclipActive and LP.Character then
				if not lSt then lSt=true setCol(false) end
				for _,v in pairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=false end end
				local r=LP.Character:FindFirstChild("HumanoidRootPart")
				if r then local h=workspace:FindPartOnRayWithIgnoreList(Ray.new(r.Position,Vector3.new(0,-6,0)),{LP.Character}) if h then h.CanCollide=true end end
			else
				if lSt then lSt=false setCol(true) end
			end
		end)
		ntf("NOCLIP: ON")
		getgenv().KrizNoclipCleanup=function()
			if getgenv().KRIZ_NOCLIP_CONN then getgenv().KRIZ_NOCLIP_CONN:Disconnect() getgenv().KRIZ_NOCLIP_CONN=nil end
			setCol(true) ntf("NOCLIP: OFF")
		end
	end,
	OnDisable=function()
		getgenv().KrizNoclipActive=false
		if getgenv().KrizNoclipCleanup then pcall(getgenv().KrizNoclipCleanup) end
	end
})



Core:RegisterModule({
	Name="Anti-Fling / ป้องกันฟลิง",
	Category="Defense",
	OnEnable=function()
		getgenv().KrizAntiFlingActive=true
		local S={Players=game:GetService("Players"),RunService=game:GetService("RunService"),StarterGui=game:GetService("StarterGui")}
		local LP=S.Players.LocalPlayer local afConns={}
		local function ntf(txt) task.spawn(function() pcall(function() S.StarterGui:SetCore("SendNotification",{Title="KRIZ HUB",Text=txt,Duration=3}) end) end) end
		local function startAF()
			local function pAdd(plr)
				local char,pPart,dtct=nil,nil,false
				local function cAdd(nChar)
					char=nChar repeat task.wait() pPart=nChar:FindFirstChild("HumanoidRootPart") until pPart dtct=false
				end
				if plr.Character then cAdd(plr.Character) end
				table.insert(afConns,plr.CharacterAdded:Connect(cAdd))
				table.insert(afConns,S.RunService.Heartbeat:Connect(function()
					if not getgenv().KrizAntiFlingActive then return end
					if char and pPart and char:IsDescendantOf(workspace) then
						if pPart.AssemblyAngularVelocity.Magnitude>50 or pPart.AssemblyLinearVelocity.Magnitude>100 then
							if not dtct then pcall(function() S.StarterGui:SetCore("ChatMakeSystemMessage",{Text="Fling Detected: "..plr.Name,Color=Color3.new(1,.8,0)}) end) end
							dtct=true
							for _,v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide,v.AssemblyAngularVelocity,v.AssemblyLinearVelocity=false,Vector3.zero,Vector3.zero end end
						end
					end
				end))
			end
			for _,v in ipairs(S.Players:GetPlayers()) do if v~=LP then pAdd(v) end end
			table.insert(afConns,S.Players.PlayerAdded:Connect(pAdd))
			local lPos=nil
			table.insert(afConns,S.RunService.Heartbeat:Connect(function()
				if not getgenv().KrizAntiFlingActive then return end
				local c,hrp=LP.Character,LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
				if hrp.AssemblyLinearVelocity.Magnitude>250 or hrp.AssemblyAngularVelocity.Magnitude>250 then
					hrp.AssemblyAngularVelocity,hrp.AssemblyLinearVelocity=Vector3.zero,Vector3.zero if lPos then hrp.CFrame=lPos end ntf("FLING NEUTRALIZED")
				elseif hrp.AssemblyLinearVelocity.Magnitude<50 then lPos=hrp.CFrame end
			end))
		end
		startAF() ntf("ANTI-FLING: ON")
		getgenv().KrizAntiFlingCleanup=function()
			for _,c in pairs(afConns) do pcall(function() c:Disconnect() end) end afConns={} ntf("ANTI-FLING: OFF")
		end
	end,
	OnDisable=function()
		getgenv().KrizAntiFlingActive=false
		if getgenv().KrizAntiFlingCleanup then pcall(getgenv().KrizAntiFlingCleanup) end
	end
})
