		local function getTgt()
			local clst,dst=nil,aFOV local ctr=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
			local sP,iW,sM=tP[cPI],wS[cWI],tM[cMI]
			for _,p in pairs(P:GetPlayers()) do
				if ((sM=="All" and p~=LP) or (sM=="Enemy" and p~=LP and p.Team~=LP.Team)) and p.Character then
					local hum,tPart=p.Character:FindFirstChild("Humanoid"),p.Character:FindFirstChild(sP) or p.Character:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health>0 and tPart then
						local pos,vis=Cam:WorldToViewportPoint(tPart.Position) local val=false
						if iW then val=vis else
							local rp=RaycastParams.new() rp.FilterDescendantsInstances,rp.FilterType={LP.Character,p.Character},Enum.RaycastFilterType.Exclude
							val=vis and not workspace:Raycast(Cam.CFrame.Position,(tPart.Position-Cam.CFrame.Position),rp)
						end
						if val then local d=(Vector2.new(pos.X,pos.Y)-ctr).Magnitude if d<dst then clst,dst=tPart,d end end
					end
				end
			end
			return clst
		end
		local aConn=RS.RenderStepped:Connect(function(dt)
			if not fCirc then return end
			fCirc.Position,fCirc.Radius,fCirc.Visible=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2),aFOV,aAct
			if aAct then
				local tgt=getTgt()
				if tgt then
					local cPos=Cam.CFrame.Position local tCF=CFrame.lookAt(cPos,tgt.Position) local cSL=sL[cSI]
					if cSL==1 then Cam.CFrame=tCF else
						local sF=(cSL==2) and .35 or .18
						Cam.CFrame=CFrame.new(cPos)*(Cam.CFrame.Rotation:Lerp(tCF.Rotation,math.clamp(dt*sF*60,.01,1)))
					end
				end
			end
		end)
		Btn.MouseButton1Click:Connect(function()
			if not isM then
				aAct=not aAct getgenv().KrizAimEnemyActive=aAct
				Btn.TextColor3=aAct and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)
				ntf(aAct and "LOCK: ON" or "LOCK: OFF")
			end
		end)
		ntf("LOCK UI: OPEN")
		getgenv().KrizAimEnemyCleanup=function()
			aAct,getgenv().KrizAimEnemyActive=false,false
			if aConn then aConn:Disconnect() end if fCirc then fCirc:Remove() end
			for _,o in pairs({ScG,fBox,sBtn,pBtn,wBtn,mBtn}) do pcall(function() if o then o:Destroy() end end) end
			if rFrame then local n=rFrame:FindFirstChild("Name") if n then n.Size=UDim2.new(1,-60,1,0) end end
			ntf("LOCK: OFF")
		end
	end,
	OnDisable=function()
		getgenv().KrizAimEnemyActive=false
		if getgenv().KrizAimEnemyCleanup then pcall(getgenv().KrizAimEnemyCleanup) end
	end
})



