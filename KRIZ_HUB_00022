			end
			wBtn=cBtn("WallButton",UDim2.new(0,36,0,20),UDim2.new(1,-88,.5,-10),wS[cWI] and "W:ON" or "W:OFF",wS[cWI] and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255),8)
